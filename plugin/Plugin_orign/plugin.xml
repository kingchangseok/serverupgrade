	<extension
		point="org.eclipse.ui.decorators">
		<decorator
			adaptable="true"
			class="com.azsoft.ecams.ui.decorator.EcamsLightweightDecorator"
			id="eCAMS_Plugin.decorator"
			label="ecamsDecorator"
			lightweight="true"
			location="TOP_LEFT"
			objectClass="org.eclipse.core.resources.IResource"
			state="true">
		</decorator>
	</extension>
	
	<extension
		point="org.eclipse.team.core.ignore">
		<ignore
			enabled="true"
			pattern="**/.ecm">
		</ignore>
