	<extension
		point="org.eclipse.ui.newWizards">
		<category
			id="com.azsoft.ecams"
			name="eCAMS"/>
		<wizard
			canFinishEarly="false"
			category="com.azsoft.ecams"
			class="com.azsoft.ecams.ui.wizard.NewProjectWizard"
			hasPages="true"
			icon="icons/Eclipse_icon_newprj_wiz.gif"
			id="com.azsoft.ecams.ui.wizard.newproject"
			name="eCAMS Project"
			project="true">
		</wizard>
	</extension>
 <extension
       point="org.eclipse.ui.commands">
       <!-- 버전비교 -->
		<command
			defaultHandler="com.azsoft.ecams.core.icommands.VersionCompare"
			id="com.azsoft.ecams.plugin.commands.resource.VersionCompare"
			name="VersionCompare">
		</command>
		
		<!-- 리소스버전정보 -->
		<command
			defaultHandler="com.azsoft.ecams.core.icommands.VersionInfo"
			id="com.azsoft.ecams.plugin.commands.resource.VersionInfo"
			name="VersionInfo">
		</command>
		
		<!-- 리소스 히스토리 -->
		<command
			defaultHandler="com.azsoft.ecams.core.icommands.VersionHistory"
			id="com.azsoft.ecams.plugin.commands.resource.VersionHistory"
			name="VersionHistory">
		</command>
		
		<!-- 동기화 -->
		<command
			defaultHandler="com.azsoft.ecams.core.icommands.Sync"
			id="com.azsoft.ecams.plugin.commands.resource.Sync"
			name="Sync">
		</command>
		
		<!-- 덮어쓰기 -->
		<command
			defaultHandler="com.azsoft.ecams.core.icommands.SyncReplace"
			id="com.azsoft.ecams.plugin.commands.resource.SyncReplace"
			name="SyncReplace">
		</command>
		
		<!-- 가져오기 -->
		<command
			defaultHandler="com.azsoft.ecams.core.icommands.SyncGet"
			id="com.azsoft.ecams.plugin.commands.resource.SyncGet"
			name="SyncGet">
		</command>
		
		<!-- 서버접속여부 -->
		<command
			defaultHandler="com.azsoft.ecams.core.icommands.IsConnected"
			id="com.azsoft.ecams.plugin.commands.common.IsConnected"
			name="IsConnected">
		</command>
		
		<!-- 로그인 ID -->
		<command
			defaultHandler="com.azsoft.ecams.core.icommands.GetLoginId"
			id="com.azsoft.ecams.plugin.commands.common.GetLoginId"
			name="GetLoginId">
		</command>
		
		<!-- eCAMS프로젝트 여부 -->
		<command
			defaultHandler="com.azsoft.ecams.core.icommands.IsCFProject"
			id="com.azsoft.ecams.plugin.commands.common.IsCFProject"
			name="IsCFProject">
		</command>
		
		<!-- eCAMS프로젝트 접속 Host정보 -->
		<command
			defaultHandler="com.azsoft.ecams.core.icommands.GetCFConnectionHost"
			id="com.azsoft.ecams.plugin.commands.common.GetCFConnectionHost"
			name="GetCFConnectionHost">
		</command>
		
		<!-- 로그인한 사용자의 관리자여부 -->
		<command
			defaultHandler="com.azsoft.ecams.core.icommands.IsAdmin"
			id="com.azsoft.ecams.plugin.commands.common.IsAdmin"
			name="IsAdmin">
		</command>
		
		<command
			id="com.azsoft.ecams.action.sync"
			name="sync">
		</command>
