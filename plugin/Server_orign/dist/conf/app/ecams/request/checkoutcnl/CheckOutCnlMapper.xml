	<select id="selectCmr1010_acptno" parameterType="hashmap" resultType="String">
		select cr_acptno from cmr1010
		where  cr_confno is null
		and    cr_itemid  = #{CR_ITEMID}
		and    cr_acptno != #{CR_ACPTNO}
		and    cr_status  = '9'
		and    substr(cr_acptno,5,2) in ('01','02')
		and	   rownum = 1
	</select>
	
