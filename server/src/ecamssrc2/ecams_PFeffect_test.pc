/*---------------------------------------------------------------*/
/*     Header files                                              */
/*---------------------------------------------------------------*/
#include 	<stdio.h>
#include 	<string.h>
#include 	<ecamsapi.h>

EXEC SQL INCLUDE SQLCA;

FILE *fp;

/*---------------------------------------------------------------*/
/*       INTERNAL  FUNCTION  DEFINE                              */
/*---------------------------------------------------------------*/


/*---------------------------------------------------------------*/
/*		USER WORK DEFINE                                         */
/*---------------------------------------------------------------*/




/*****************************************************************/
/*                                                               */
/*		ProFrame 영향도 목록 작성   처리   MAIN                  */
/*                                                               */
/*****************************************************************/
int		main (int argc, char **argv, char **envp)
{

	#if 0
	if (argc != 6) {
        printf ("Usage : %s <SysCD> <RESOURCETYPE> <PHYSICALNAME> <T(테이블)/R(리소스)/I(INCLUDE)> <OutFileName>\n", argv[0]);
        exit (0);
    }
	#endif


    /*-----------------------------------------------------------*/
    /*   eCAMS  DB Server  Connect                               */
    /*-----------------------------------------------------------*/
	if (ConnectDB() == FALSE)
		exit(1);

	if (argc == 5) {
		/*-------------------------------------------------------*/
		/*	Function  : Process_SCREffect                        */
		/*	Action    : 화면 영향도 자료 작성                    */
		/*	Parameter :	pSysCD    : 시스템코드                   */
		/*	            pDsnCD    : 디렉토리코드                 */
		/*	            pSRCName  : 자원명       	             */
		/*	            pOutName  : 결과파일                     */
		/*	Return    : 없슴                                     */
		/*-------------------------------------------------------*/
		Process_SCREffect (argv[1], argv[2], argv[3], argv[4]);
	}
	else {
		/*-------------------------------------------------------*/
		/*	Function  : Process_PFEffect                         */
		/*	Action    : 프로프레임 영향도 자료 작성              */
		/*	Parameter :	pSysCD    : 시스템코드                   */
		/*	            pRsrcType : 리소스타입                   */
		/*	            pPhyName  : 물리명(자원명)	             */
		/*	            pEffCD    : 영향도구분(T:테이블,R:리소스)*/
		/*	            pOutName  : 결과파일                     */
		/*	Return    : 없슴                                     */
		/*-------------------------------------------------------*/
		Process_PFEffect(argv[1], argv[2], argv[3], argv[4], argv[5]);
	}

    EXEC SQL COMMIT WORK RELEASE;

    exit (0);

}


