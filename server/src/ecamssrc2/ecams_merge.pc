#define		dfMain		1


/*---------------------------------------------------------------*/
/*     Header files                                              */
/*---------------------------------------------------------------*/
#include 	<ecamsapi.h>
#include 	<ecams_util.h>

EXEC SQL INCLUDE "ecams_acct.h";


/*---------------------------------------------------------------*/
/*       INTERNAL  FUNCTION  DEFINE                              */
/*---------------------------------------------------------------*/
int  	Make_DiffFile 		();


/*---------------------------------------------------------------*/
/*    User Work 변수                                             */
/*---------------------------------------------------------------*/
char	SysCmd                    [1024]; /* 시스템 명령문       */
char	devFile                     [50]; /* Local File SaveFile */
int 	nRet1                           ; /* Char Find Work      */
int 	CurrCnt                         ; /* Source Line Count   */
char 	iconvFileName       [dfFullPath];

#define R_CNTRL   "r"
#define W_CNTRL   "w"
struct 	stat s_buf                      ;
char   **gEnvp                          ;
extern    int    errno                  ;


/*---------------------------------------------------------------*/
/*	Function  : Make_MergeFile                                   */
/*	Function  : Merge 파일 작성                                  */
/*	Parameter : DiffFile1 : 비교파일1                            */
/*              DiffFile2 : 비교파일2                            */
/*              RstFile   : Merge 파일                           */
/*	Return    : 결과코드                                         */
/*---------------------------------------------------------------*/
int 	Make_MergeFile	( char *BaseFile
                        , char *NewFile
						, char *DiffFile
						, char *RstFile
						)
{
FILE	*BasePtr                        ;
FILE	*NewPtr                         ;
FILE	*DiffPtr                        ;
FILE	*RstPtr                         ;
char	LeftStr                     [20];
char	RightStr                    [20];
char	DiffCmd                      [5];
char	DiffCmd2                     [5];
int 	Line1                           ;
int 	Line2                           ;
int 	Line3                           ;
int 	Line4                           ;
int 	i                               ;
char	szCntWK                    [256];
char	*dummy                   ; /* Read Buffer         */
char	*dummy2                  ; /* Read Buffer         */
long	nFileSize              ;
long	nFileSize2             ;
long	nFileSize3             ;
int     CurrCntB               ;
int     CurrCntN               ;
int     chgSw  = 0;
int     chgSw2 = 0;
    /*-----------------------------------------------------------*/
 	/*   File Open (Diff File)                                   */
    /*-----------------------------------------------------------*/
    if ((DiffPtr = fopen(DiffFile,"r")) == (FILE *) NULL) {
    	printf("FILE OPEN ERROR 1 %s\n", DiffFile);
        return (-1);
    }

    /*-----------------------------------------------------------*/
 	/*   File Open (Base/New File)                            */
    /*-----------------------------------------------------------*/
    if ((BasePtr = fopen(BaseFile,"r")) == (FILE *) NULL) {
    	printf("FILE OPEN ERROR 2 %s\n", BaseFile);
    	fclose (DiffPtr);
        return (-1);
    }
    
    if ((NewPtr = fopen(NewFile,"r")) == (FILE *) NULL) {
    	printf("FILE OPEN ERROR 3 %s\n", NewFile);
    	fclose (DiffPtr);
    	fclose (BasePtr);
        return (-1);
    }
    
    /*-----------------------------------------------------------*/
 	/*   File Open (Result File)                                 */
    /*-----------------------------------------------------------*/
    if ((RstPtr = fopen(RstFile,"w")) == (FILE *) NULL) {
    	printf("FILE OPEN ERROR 4 %s\n", RstFile);
    	fclose (DiffPtr);
    	fclose (BasePtr);
    	fclose (NewPtr);
        return (-1);
    }
    
    nFileSize = FileSizeInf(DiffFile) + 1;    
	nFileSize2 = FileSizeInf(BaseFile) + 1;
    nFileSize3 = FileSizeInf(NewFile) + 1;    

    if (nFileSize2 < nFileSize) nFileSize2 = nFileSize;
    if (nFileSize2 < nFileSize3) nFileSize2 = nFileSize3;
 
	dummy = (char *)malloc(nFileSize2);
	dummy2 = (char *)malloc(nFileSize2);
	
	memset(dummy, 0x00, nFileSize2);
	memset(dummy2,0x00, nFileSize2);
	
    CurrCntN = 0;
    CurrCntB = 0;
    
    while (fgets(dummy, nFileSize2, DiffPtr) != (char *)NULL) {
		if (strlen(dummy) == 0)	break;
        /*-------------------------------------------------------*/
    	/* Return Valure Truncate                                */
        /*-------------------------------------------------------*/
        sprintf(dummy, "%s", rep_char(dummy,"\r\n",""));
        sprintf(dummy, "%s", rep_char(dummy,"\r",""));
        sprintf(dummy, "%s", rep_char(dummy,"\n",""));

        /*-------------------------------------------------------*/
    	/*    변경기록 Line 추출                                 */
        /*-------------------------------------------------------*/
        if (memcmp(dummy,"0",1) >= 0 &&
            memcmp(dummy,"9",1) <= 0 ) {
           nRet1 = Char_Check(dummy, "d");
           if (nRet1 < 0) {
              nRet1 = Char_Check(dummy, "a");
              if (nRet1 < 0) {
                 nRet1 = Char_Check(dummy, "c");
                 if (nRet1 < 0) {
                     printf("DIFF Check Error  %s\n", dummy);
                 }
              }
           }

           /*----------------------------------------------------*/
           /*   변경 Line 계산                                   */
           /*     OLD (From/TO),  TO (From/TO)                   */
           /*----------------------------------------------------*/
           if (nRet1 >= 0) {
              memset(LeftStr, 0x00, sizeof(LeftStr));
              memset(RightStr, 0x00, sizeof(RightStr));
              memset(DiffCmd, 0x00, sizeof(DiffCmd));

              memcpy(LeftStr, dummy, nRet1);
              memcpy(RightStr, &dummy[nRet1+1], strlen(dummy)-nRet1);
              memcpy(DiffCmd, &dummy[nRet1], 1);

              nRet1 = Char_Check(LeftStr, ",");
              if (nRet1 < 0) {
              	 Line1 = atoi(LeftStr);
              	 Line2 = atoi(LeftStr);
              }
              else {
				memset(szCntWK, 0x00, sizeof(szCntWK));
				sprintf(szCntWK, "%s", left_char(LeftStr, nRet1));
				Line1 = atoi(szCntWK);

				memset(szCntWK, 0x00, sizeof(szCntWK));
				sprintf(szCntWK, "%s", right_char(LeftStr, strlen(LeftStr)-nRet1-1));
				Line2 = atoi(szCntWK);
              }

              nRet1 = Char_Check(RightStr, ",");
              if (nRet1 < 0) {
              	 Line3 = atoi(RightStr);
              	 Line4 = atoi(RightStr);
              }
              else {
				memset(szCntWK, 0x00, sizeof(szCntWK));
				sprintf(szCntWK, "%s", left_char(RightStr, nRet1));
				Line3 = atoi(szCntWK);

				memset(szCntWK, 0x00, sizeof(szCntWK));
				sprintf(szCntWK, "%s", right_char(RightStr, strlen(RightStr)-nRet1-1));
				Line4 = atoi(szCntWK);
              }
           }
           
          /*-------------------------------------------------*/
	       /*   Delete  Line 작성                             */
	       /*-------------------------------------------------*/
	       if (memcmp(DiffCmd, "d", 1) == 0) {
	      	  if (Line3 > CurrCntN) {
	      	   	 while (1) {
	                if (fgets(dummy, nFileSize2, NewPtr) == (char *) NULL) break;
		    		if (strlen(dummy) == 0)	break;
	
			        sprintf(dummy, "%s", rep_char(dummy,"\r\n",""));
			        sprintf(dummy, "%s", rep_char(dummy,"\r",""));
			        sprintf(dummy, "%s", rep_char(dummy,"\n",""));
	
	                CurrCntN++;
	                if (CurrCntN <= Line3) {
	                	fprintf(RstPtr, "%s\r\n", dummy);	
	            	}  
	            	if (CurrCntN>=Line3) break;
	             }	
	     	  }	
	     	  fprintf(RstPtr,"\r\n");
	     	  fprintf(RstPtr,">>>>> ecams start (delete) \r\n");
	          while (1) {
	            if (fgets(dummy, nFileSize2, BasePtr) == (char *) NULL) break;
	    		if (strlen(dummy) == 0)	break;
	
		        sprintf(dummy, "%s", rep_char(dummy,"\r\n",""));
		        sprintf(dummy, "%s", rep_char(dummy,"\r",""));
		        sprintf(dummy, "%s", rep_char(dummy,"\n",""));
	
	            CurrCntB++;
	            if (CurrCntB >= Line1 && CurrCntB <= Line2) {
	               fprintf(RstPtr, "%s\r\n", dummy);
				}
				
	            if (CurrCntB >= Line2) break;
	          }
	          fprintf(RstPtr,">>>>> ecams e n d \r\n");
	     	  fprintf(RstPtr,"\r\n");
	       }
		
	       /*-------------------------------------------------*/
	       /*    Change Line 작성                             */
	       /*-------------------------------------------------*/
	       else if (memcmp(DiffCmd, "c", 1) == 0) { 
		 	  while (1) {
	            if (fgets(dummy, nFileSize2, NewPtr) == (char *) NULL) break;
	    		if (strlen(dummy) == 0)	break;
	
		        sprintf(dummy, "%s", rep_char(dummy,"\r\n",""));
		        sprintf(dummy, "%s", rep_char(dummy,"\r",""));
		        sprintf(dummy, "%s", rep_char(dummy,"\n",""));
	
	            CurrCntN++;
	            if (CurrCntN < Line3) {
	            	fprintf(RstPtr, "%s\r\n", dummy);
	        	} else if (CurrCntN >= Line3 && CurrCntN <= Line4) {
	            	if (CurrCntN == Line3) {
	 	 				fprintf(RstPtr,"\r\n");
	            	 	fprintf(RstPtr,">>>>> mine start (change) \r\n");		                	 	
	            	}
	               fprintf(RstPtr, "%s\r\n", dummy);
				}
				
	            if (CurrCntN >= Line4) break;
	          }	
	          fprintf(RstPtr,">>>>> mine e n d \r\n");
			  while (1) {
	            if (fgets(dummy, nFileSize2, BasePtr) == (char *) NULL) break;
	    		if (strlen(dummy) == 0)	break;
	
		        sprintf(dummy, "%s", rep_char(dummy,"\r\n",""));
		        sprintf(dummy, "%s", rep_char(dummy,"\r",""));
		        sprintf(dummy, "%s", rep_char(dummy,"\n",""));
	
	            CurrCntB++;
	            if (CurrCntB >= Line1 && CurrCntB <= Line2) {
	            	if (CurrCntB == Line1) {
	 	 				fprintf(RstPtr,"\r\n");
	            	 	fprintf(RstPtr,">>>>> ecams start (change) \r\n");		                	 	
	            	}
	               fprintf(RstPtr, "%s\r\n", dummy);
				}
				
	            if (CurrCntB >= Line2) break;
	          }	
	          fprintf(RstPtr,">>>>> ecams e n d \r\n");
	       }
	       /*-------------------------------------------------*/
	       /*    Insert Line 작성                             */
	       /*-------------------------------------------------*/
	       else if(memcmp(DiffCmd, "a", 1) == 0) {
	      	  while (1) {
	            if (fgets(dummy, nFileSize2, NewPtr) == (char *) NULL) break;
	    		if (strlen(dummy) == 0)	break;
				
		        sprintf(dummy, "%s", rep_char(dummy,"\r\n",""));
		        sprintf(dummy, "%s", rep_char(dummy,"\r",""));
		        sprintf(dummy, "%s", rep_char(dummy,"\n",""));                  
	            CurrCntN++;
	            if (CurrCntN < Line3) {
	               fprintf(RstPtr, "%s\r\n", dummy);
	            } else if (CurrCntN >= Line3 && CurrCntN <= Line4) {
		        	if (CurrCntN == Line3) {
	 	 				fprintf(RstPtr,"\r\n");
	            	 	fprintf(RstPtr,">>>>> mine start (Insert) \r\n");		                	 	
	            	}
	            	fprintf(RstPtr, "%s\r\n", dummy);
	            }
	            if (CurrCntN >= Line4) break;
	          } 
	          fprintf(RstPtr,">>>>> mine e n d \r\n");    
	       }
        }
    }

	while (1) {
       	if (fgets(dummy, nFileSize2, NewPtr) == (char*)NULL ) break;
		if (strlen(dummy) == 0)	break;

        sprintf(dummy, "%s", rep_char(dummy,"\r\n",""));
        sprintf(dummy, "%s", rep_char(dummy,"\r",""));
        sprintf(dummy, "%s", rep_char(dummy,"\n",""));
        memset(dummy2,0x00, nFileSize2);
        sprintf(dummy2, "%s",right_char(dummy,strlen(dummy)-2));

		CurrCntN++;
		fprintf(RstPtr, "%s \r\n", dummy);
	}
    fclose (DiffPtr);
    fclose (BasePtr);
    fclose (NewPtr);
    fclose (RstPtr);

    return 1;
}
/*---------------------------------------------------------------*/
/*	Function  : MakeFileWithVer                                  */
/*	Function  : 버전파일 작성                                    */
/*	Parameter : pItemCD : 프로그램등록번호                       */
/*              pLocal  : 로컬파일명                             */
/*              gVer    : 작성버전                               */
/*	Return    : NONE                                             */
/*---------------------------------------------------------------*/
void	MakeFileWithVer	( char *pItemCD
						, char *pLocal
						, char *gVer
)
{
int 	i                               ;
int 	nVersion                        ;
char 	gDVServerIP                 [20];
char 	gSvrIp                      [20];
char 	SvrPath                  [dfDir];
char 	Dev_ProgPath             [dfDir];
int  	dfSendPort                      ;
char 	szSysCD                [dfSysCD];
char 	szRsrcCD              [dfRsrcCD];
char 	szStatus                     [2];
char 	gRsrcName           [dfPhysName];
int	 	szSvrSeq                        ;
char 	iconvFileName       [dfFullPath];
char 	szOzRsrc              [dfRsrcCD];
int  	mRet                            ;
int  	nNewVer                         ;

CMD_INFO	CmdInfo                     ;


    /*-----------------------------------------------------------*/
    /*   소켓 STRUCTURE 초기화                                   */
    /*-----------------------------------------------------------*/
	InitCmdInfo(&CmdInfo);

	memset(szOzRsrc, 0x00, sizeof(szOzRsrc));
	memset(szStatus, 0x00, sizeof(szStatus));

    /*-----------------------------------------------------------*/
    /*   자원정보 조회                                           */
    /*-----------------------------------------------------------*/
	EXEC SQL
		SELECT  CR_RSRCCD
		      , CR_LSTVER
		      , CR_STATUS
		  INTO  :szOzRsrc
		  	  , :nNewVer
		  	  , :szStatus
		  FROM  CMR0020
		 WHERE  CR_ITEMID = :pItemCD;

	if (sqlca.sqlcode != 0) {
		memset(szOzRsrc, 0x00, sizeof(szOzRsrc));
	}

	NotUseDataTruncate(szOzRsrc, 0x20);
	NotUseDataTruncate(szStatus, 0x20);

	/*-----------------------------------------------------------*/
	/*	버젼에 접수번호가 들어왔을 경우 체크인 중인 파일과 비교  */
	/*-----------------------------------------------------------*/
	if (strlen(gVer) > 5 && cmp_left_char(gVer, 1, "R") != 0 ) {
		if (strcmp(szStatus,"0") != 0 || strcmp(szStatus,"5") != 0) {
			sprintf(SysCmd,"FileRead_cmr0027 %s %s %s",gVer, pItemCD, pLocal);
			system(SysCmd);
			return ;
		}
		else {
			gVer = "NEW";
		}
	}

    /*-----------------------------------------------------------*/
	/*   개발서버에서 가져와 비교                                */
    /*-----------------------------------------------------------*/
	if (strcmp(gVer, "T") == 0) {
		EXEC SQL
			SELECT  DISTINCT
			        A.CM_SVRIP
			      , A.CM_PORTNO
			      , A.CM_SEQNO
			      , C.CR_RSRCCD
			      , C.CR_SYSCD
			      , C.CR_RSRCNAME
			      , D.CM_DIRPATH
			  INTO	:gDVServerIP
			  	  , :dfSendPort
			  	  , :szSvrSeq
			  	  , :szRsrcCD
			  	  , :szSysCD
			  	  , :gRsrcName
			  	  , :SvrPath
			  FROM  CMM0031 A
			      , CMM0038 B
			      , CMR0020 C
			      , CMM0070 D
			 WHERE  C.CR_ITEMID = :pItemCD
			   AND  A.CM_SVRCD  = '01'
			   AND  A.CM_CLOSEDT IS NULL
			   AND  C.CR_SYSCD  = A.CM_SYSCD
			   AND  C.CR_RSRCCD = B.CM_RSRCCD
			   AND  A.CM_SYSCD  = B.CM_SYSCD
			   AND  A.CM_SVRCD  = B.CM_SVRCD
			   AND  A.CM_SEQNO  = B.CM_SEQNO
			   AND  C.CR_SYSCD  = D.CM_SYSCD
			   AND  C.CR_DSNCD  = D.CM_DSNCD;

	    if (sqlca.sqlcode != 0) {
		    printf("SQLErrCheck 3: TEST Server 정보 오류 [%s] 01 [%d] [%s]\n", pItemCD, sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
		    exit (3);
	    }

	    NotUseDataTruncate(gDVServerIP, 0x20);
	    NotUseDataTruncate(szRsrcCD   , 0x20);
	    NotUseDataTruncate(szSysCD    , 0x20);
	    NotUseDataTruncate(SvrPath    , 0x20);
        sprintf(gRsrcName, "%s", trunc_char(gRsrcName));

	    ChangeVolPath(szSysCD , "01", szRsrcCD, szSvrSeq, SvrPath, Dev_ProgPath);

	    sprintf(CmdInfo.szJobGub, "G");
		sprintf(CmdInfo.szServerIP, "%s" , gDVServerIP);
		CmdInfo.nPort = dfSendPort;
		sprintf(CmdInfo.szRemote , "%s/%s" , Dev_ProgPath, gRsrcName);
		sprintf(CmdInfo.szLocal  , "%s" , pLocal);
	  	Server_Cmd_JOB(&CmdInfo);
		LookCMD_INFO(&CmdInfo);
		
		if (strcmp(CmdInfo.szRstCond, "0000") != 0) return;
		return;
	} else if (cmp_left_char(gVer, 1, "R") == 0) {
	/*-----------------------------------------------------------*/
	/*   운영서버에서 가져와 비교                                */
    /*-----------------------------------------------------------*/
    	sprintf(gSvrIp,"%s",mid_char(gVer,2,strlen(gVer)-1));
		EXEC SQL
			SELECT  DISTINCT
			        A.CM_SVRIP
			      , A.CM_PORTNO
			      , A.CM_SEQNO
			      , C.CR_RSRCCD
			      , C.CR_SYSCD
			      , C.CR_RSRCNAME
			      , D.CM_DIRPATH
			  INTO	:gDVServerIP
			  	  , :dfSendPort
			  	  , :szSvrSeq
			  	  , :szRsrcCD
			  	  , :szSysCD
			  	  , :gRsrcName
			  	  , :SvrPath
			  FROM  CMM0031 A
			      , CMM0038 B
			      , CMR0020 C
			      , CMM0070 D
			 WHERE  C.CR_ITEMID = :pItemCD
			   AND  A.CM_SVRCD  = '03'
			   AND  A.CM_SVRIP  = :gSvrIp
			   AND  A.CM_CLOSEDT IS NULL
			   AND  C.CR_SYSCD  = A.CM_SYSCD
			   AND  C.CR_RSRCCD = B.CM_RSRCCD
			   AND  A.CM_SYSCD  = B.CM_SYSCD
			   AND  A.CM_SVRCD  = B.CM_SVRCD
			   AND  A.CM_SEQNO  = B.CM_SEQNO
			   AND  C.CR_SYSCD  = D.CM_SYSCD
			   AND  C.CR_DSNCD  = D.CM_DSNCD;

	    if (sqlca.sqlcode != 0) {
		    printf("SQLErrCheck 3: Real Server 정보 오류 [%s] 01 [%d] [%s]\n", pItemCD, sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
		    exit (3);
	    }

	    NotUseDataTruncate(gDVServerIP, 0x20);
	    NotUseDataTruncate(szRsrcCD   , 0x20);
	    NotUseDataTruncate(szSysCD    , 0x20);
	    NotUseDataTruncate(SvrPath    , 0x20);
        sprintf(gRsrcName, "%s", trunc_char(gRsrcName));

	    ChangeVolPath(szSysCD , "01", szRsrcCD, szSvrSeq, SvrPath, Dev_ProgPath);

	    sprintf(CmdInfo.szJobGub, "G");
		sprintf(CmdInfo.szServerIP, "%s" , gDVServerIP);
		CmdInfo.nPort = dfSendPort;
		sprintf(CmdInfo.szRemote , "%s/%s" , Dev_ProgPath, gRsrcName);
		sprintf(CmdInfo.szLocal  , "%s" , pLocal);
	  	Server_Cmd_JOB(&CmdInfo);
		LookCMD_INFO(&CmdInfo);
		
		if (strcmp(CmdInfo.szRstCond, "0000") != 0) return;

		return;
	}
	
	/*-----------------------------------------------------------*/
	/*   로컬파일을 형상관리에 저장(이클립스에서 저장) 후 비교   */
    /*-----------------------------------------------------------*/
	if (strcmp(gVer, "D") == 0) {
		printf("local file name [%s][%s]\n", devFile,pLocal);
		sprintf(SysCmd,"cp %s %s ",devFile,pLocal);
		mRet = system(SysCmd)/256;
		if (mRet == 0) {
		}
		else {
			remove(pLocal);
		}
		
		return;
	}
  	if (strcmp(gVer,"NEW") == 0 || strcmp(gVer,"LAST") == 0)
    	nVersion = nNewVer;
	else
		nVersion = atoi(gVer);

	sprintf(SysCmd,"FileRead_cmr0025 %s %s %d",pItemCD,pLocal,nVersion);
	system(SysCmd);
	printf(" [%s] \n",SysCmd);

}



/*****************************************************************/
/*                                                               */
/*       File  Compare    처리  M A I N                          */
/*                                                               */
/*   Parameter  :                                                */
/*      1. BackUp Directory                                      */
/*      2. OLD Sorc Name                                         */
/*      3. NEW Sorc Name                                         */
/*      4. UserID                                                */
/*      5. 개발서버 주소                                         */
/*      6. 개발서버 파일위치                                     */
/*****************************************************************/
int  main(int argc, char **argv, char **envp)
{

char	DiffFile1           [dfFullPath]; /* diff 결과 파일      */
char	DiffSorc1           [dfFullPath]; /* 최종버전파일        */
char	DiffSorc2           [dfFullPath]; /* 수정된파일          */
char	MergeFile           [dfFullPath]; /* Merge후파일         */
char	sysgb	                     [3]; /* 시스템 구분         */
char	sSysUp                       [3]; /* 시스템 OS 구분      */
char	sDown                        [3]; /* DOWN 여부           */
char	tmpDir                   [dfDir];

    if (argc < 4) {
		printf ("usage : %s <ITEMID1:최종> <AFT_VER> <EDITFILE:수정소스> <OUTFILE>\n", argv[0]);
        exit (1);
    }

    memset(SysCmd    , 0x00, sizeof(SysCmd    ));
    memset(DiffFile1 , 0x00, sizeof(DiffFile1 ));
    memset(DiffSorc1 , 0x00, sizeof(DiffSorc1 ));
    memset(DiffSorc2 , 0x00, sizeof(DiffSorc2 ));
    memset(devFile   , 0x00, sizeof(devFile   ));
    memset(MergeFile , 0x00, sizeof(MergeFile ));


    /*-----------------------------------------------------------*/
    /*   eCAMS  DB Server  Connect                               */
    /*-----------------------------------------------------------*/
	if (ConnectDB() == FALSE)
		exit(1);


    /*-----------------------------------------------------------*/
    /*   Temp 디렉토리명 조회                                    */
    /*-----------------------------------------------------------*/
    SetTempDir("99", tmpDir);
    
    sprintf(MergeFile , "%s/%s.merge", tmpDir, argv[4]);
    
    /*-----------------------------------------------------------*/
    /*   로컬파일명 조립                                         */
    /*-----------------------------------------------------------*/
	sprintf(DiffSorc1, "%s/%s_ecams", tmpDir, argv[4]);
	sprintf(DiffSorc2, "%s/%s_mine", tmpDir, argv[4]);
	
	/*sprintf(DiffSorc1, "%s", argv[1]);
	sprintf(DiffSorc2, "%s", argv[3]);
	sprintf(DiffSorc3, "%s", argv[5]);*/
	sprintf(devFile, "%s/%s", tmpDir, argv[4]);
	sprintf(DiffFile1, "%s/%s.1", tmpDir, argv[4]);
    
