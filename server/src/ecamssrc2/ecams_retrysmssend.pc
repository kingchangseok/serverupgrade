#define		dfMain		1


typedef struct
{
	short len;
	char  arr[100];
} vr;

/*---------------------------------------------------------------*/
/*       Oracle Sql Bind 변수 DEFINE                             */
/*---------------------------------------------------------------*/
EXEC SQL BEGIN DECLARE SECTION;
    EXEC SQL TYPE vr IS VARRAW(100);
    vr my_vr;
EXEC SQL END DECLARE SECTION;


EXEC SQL INCLUDE "ecams_acct.h";

#define DEBUG 1

/*---------------------------------------------------------------*/
/*		외부함수 include										 */
/*---------------------------------------------------------------*/
#include	<ecamsapi.h>
#include 	<ecams_util.h>

/*---------------------------------------------------------------*/
/*		내부함수			                                     */
/*---------------------------------------------------------------*/




/*---------------------------------------------------------------*/
/*		USER WORK DEFINE                                         */
/*---------------------------------------------------------------*/
char	gszRsultPath               [256];




/*****************************************************************/
/*                                                               */
/*             업무계 신청자원 처리 M A I N                      */
/*                                                               */
/*****************************************************************/
int		main (int argc, char **argv, char** envp)
{
char    szAcptNo       [20];          /* eCAMS Log 접수번호      */
char    szSerNo        [10];          /* eCAMS Log 일련번호      */
char    szJobID        [11];          /* 처리 구분               */
char 	szRstCond       [5];          /* 처리 결과 받을 변수     */
char	filename       [80];
int     nRemainCnt         ;
int     nSerNo             ;
int		nPid;

    if ( argc < 2 ) {
        printf ("usage : %s <신청번호> \n", argv[0]);
        exit (0);
	}

	sprintf(filename , "%s.log", argv[0]);

	#if 0
	TRACE = fopen (filename, "w+");
	if (TRACE == NULL)  {
		fprintf (stderr, "%s : file Open Err\n", filename);
		fflush  (stderr);
		exit (0);
	}
	#endif

	memset(szAcptNo , 0x00, sizeof(szAcptNo ));
    memset(szSerNo  , 0x00, sizeof(szSerNo  ));
    memset(szJobID  , 0x00, sizeof(szJobID  ));
    memset(szRstCond, 0x00, sizeof(szRstCond));

	OIC_SMSServerSet (OFF);

	/*-----------------------------------------------------------*/
	/* 로그 파일 Set	        	  		                     */
	/*-----------------------------------------------------------*/
	Get_Sys_Date(gszLogFile);
	strcat(gszLogFile,".log");
	strcpy(gszLogPath,"LogMessage/");

	/*-----------------------------------------------------------*/
	/* 신청번호 , 시리얼번호 초기화				                 */
	/*-----------------------------------------------------------*/
	sprintf(szAcptNo   , "%s", argv[1]);     /* 접수번호         */
	sprintf(szSerNo    , "%s", "0000");     /* 일련번호        */
	nSerNo = atoi(szSerNo);
	gEnvp = envp;				         /*### gEnvp = 환경변수  */

	/*-----------------------------------------------------------*/
    /*   Signal Define			                                 */
    /*-----------------------------------------------------------*/
    DefineSignal ();

    /*-----------------------------------------------------------*/
    /*   eCAMS  DB Server  Connect                               */
    /*-----------------------------------------------------------*/
	if (ConnectDB() == FALSE)
		exit(1);

	/*-----------------------------------------------------------*/
    /*   Set Temp Directory                                      */
    /*-----------------------------------------------------------*/
	SetTempDir("99", gszTempPath);
	memset(szJobID, 0x00, sizeof(szJobID));

	/*-----------------------------------------------------------*/
    /* 처리단계 조회                                             */
    /*-----------------------------------------------------------*/
	sprintf(szJobID, "%s", "RETRY");
	nPid = getpid ();
	
	/*-----------------------------------------------------------*/
	/* ResultFile Dir 체크                                       */
	/*-----------------------------------------------------------*/
	SetTempDir("11", gszRsultPath);
	Local_Dir_Make(gszRsultPath );

	Process_SMSSend (szAcptNo, szJobID);
	
	EXEC SQL COMMIT WORK RELEASE;

	exit(0);
}


/*---------------------------------------------------------------*/
/*             E N D    O F    P R O G R A M                     */
/*---------------------------------------------------------------*/
