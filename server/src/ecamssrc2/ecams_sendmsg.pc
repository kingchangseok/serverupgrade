#define		DATA_ARRAY		5000
#define 	_DEBUG_			1

#define 	chNil       	'\0'
#define 	chTab       	'\t'
#define 	chLF        	'\n'
#define 	chCR        	'\r'
#define 	chSpace     	' '

#ifndef TRUE
#define TRUE    1
#endif

#ifndef FALSE
#define FALSE   0
#endif

#define 	FreeStr(ptr)	free((void *) ptr)
#define 	RTrim(psz)		_RTrim(psz, (char *)NULL)

