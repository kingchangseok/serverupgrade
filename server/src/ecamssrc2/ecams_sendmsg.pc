	char	szSendUsr	     [DATA_ARRAY][  20+1];
	char	szLinkUrl	     [DATA_ARRAY][ 200+1];
	char	szAcptNo	     [DATA_ARRAY][  12+1];
	char	szNotiCD	     [DATA_ARRAY][   1+1];
	char	szSmsMsg         [DATA_ARRAY][ 500+1];
} APPROVAL_DATA;


