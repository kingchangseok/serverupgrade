		if (sqlca.sqlcode == 1403) {
			sprintf(gszLogMsg,"GetInnerList Before DB FETCH 1403 : [%s] [%d] [%d] [%s]", pAcptNo, szSerNo, sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
			eCAMS_Log(gszLogPath, gszLogFile, gszLogMsg);
			break;
		}

		if (sqlca.sqlcode != 0 && sqlca.sqlcode != -1405) {
