			EXEC SQL
				SELECT  A.CM_VOLPATH
				  INTO  :szChangDirPath
				  FROM  CMM0038 A
				 WHERE  A.CM_SysCD  = :szSysCD
				   AND  A.CM_SEQNO  = :szSvrSeq
