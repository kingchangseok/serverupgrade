#CFLAGS=-DLOGGING -g

AR=ar rc
CC=cc -D MULTIARG -D ON_LINE -D LOGGING
CCcurses=cc
eCAMS_HOME=$(APPHOME)
INCLUDE= $(eCAMS_HOME)/inc
LIBcurses=-lcurses -ltermcap
BINPATH=$(eCAMS_HOME)/bin
LIBPATH=$(eCAMS_HOME)/lib
TARGET =$(LIBPATH)/libecams_comm32.a
OBJECT_MODE=32

ZIPLIB= adler32.o	\
		compress.o	\
		crc32.o 	\
		gzio.o 		\
		uncompr.o 	\
		deflate.o 	\
		trees.o 	\
		zutil.o 	\
		inflate.o 	\
		infback.o 	\
		inftrees.o 	\
		inffast.o

all: libzip

.SUFFIXES: .c .o

clean:
	rm -f *.o core

.c.o:
	$(CC)  -c $*.c -o $@ -I$(INCLUDE)

libzip: $(ZIPLIB)
	$(AR) $(TARGET) $(ZIPLIB)
	rm *.o
