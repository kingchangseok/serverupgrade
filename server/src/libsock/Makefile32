CFLAGS=-DLOGGING -g

AR=ar rc
#CC=cc -D MULTIARG -D TEST_MODE -D ON_LINE -D LOGGING
CC=cc -D MULTIARG  -D ON_LINE -D LOGGING
CCcurses=cc
eCAMS_HOME=$(APPHOME)
INCLUDE= $(eCAMS_HOME)/inc
LIBcurses=-lcurses -ltermcap
BINPATH=$(eCAMS_HOME)/bin
LIBPATH=$(eCAMS_HOME)/lib
TARGET =$(LIBPATH)/libecams_comm32.a
OBJECT_MODE=32

SOCKLIB= lanapi.o	\
	 util.o 	\
	 ftplib.o	\
	 sockutil.o	\
	 md5.o		\
	 tarutil.o	\
	 strcvt.o   \

all: libsock

.SUFFIXES: .c .o

clean:
	rm -f *.o core

.c.o:
	$(CC)  -c $*.c -o $@ -I$(INCLUDE)

libsock: $(SOCKLIB)
	$(AR) $(TARGET) $(SOCKLIB)
	rm -rf *.o
