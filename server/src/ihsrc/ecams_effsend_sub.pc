#define		dfMain		1


/*---------------------------------------------------------------*/
/*     Header files                                              */
/*---------------------------------------------------------------*/
#include 	<ecamsapi.h>
#include	<ecams_util.h>

EXEC SQL INCLUDE "ecams_acct.h";


/*---------------------------------------------------------------*/
/*		Structure for VARRAW                                     */
/*---------------------------------------------------------------*/
typedef struct
{
	short len;
	char  arr[100];
} vr;

/*---------------------------------------------------------------*/
/*       Oracle Sql Bind 변수 DEFINE                             */
/*---------------------------------------------------------------*/
EXEC SQL BEGIN DECLARE SECTION;
    EXEC SQL TYPE vr IS VARRAW(100);
    vr my_vr;
EXEC SQL END DECLARE SECTION;


/*---------------------------------------------------------------*/
/*       USER  PROCEDURE  DEFINE                                 */
/*---------------------------------------------------------------*/




/*---------------------------------------------------------------*/
/*		USER WORK DEFINE                                         */
/*---------------------------------------------------------------*/


void	ChangeVolPath_Test	( char *szSysCd
						, char *szSvrCd
						, char *szRsrcCD
						, int   szSeqNo
						, char *szDirPath
						, char *szChangDirPath
						)
{
char	SV_DevHome	             [dfDir];
char	SV_ProdHome	             [dfDir];
char	szChangDirPath1	         [dfDir];
char	szBaseSvr                  [2+1];
int     nCnt = 0;

	memset(szBaseSvr, 0x00, sizeof(szBaseSvr));
	
	EXEC SQL
		SELECT  CM_DIRBASE
		  INTO  :szBaseSvr
		  FROM  CMM0030
		 WHERE  CM_SYSCD = :szSysCd;

	if (sqlca.sqlcode != 0) {
		sprintf(gszLogMsg, "SQLErrCheck 1: 기준 SVR GET ERR [%s] 01 [%d] [%s]", szSysCd, sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
		eCAMS_Log(gszLogPath,gszLogFile,gszLogMsg);
		return;
	}
	NotUseDataTruncate (szBaseSvr, 0x20);

	memset(szChangDirPath, 0x00, sizeof(szChangDirPath));
		
	if (strcmp(szBaseSvr,szSvrCd) == 0) {
		strcpy(szChangDirPath,szDirPath);
		return;
	}
    EXEC SQL
		SELECT  A.CM_VOLPATH
		  INTO	:SV_DevHome
		  FROM	CMM0038 A
		      , CMM0031 B
		 WHERE	A.CM_SysCD  = :szSysCd
		   AND  A.CM_SvrCD  = :szBaseSvr
		   AND  A.CM_RsrcCD = :szRsrcCD
		   AND  A.CM_SYSCD	= B.CM_SYSCD
		   AND  A.CM_SVRCD  = B.CM_SVRCD
		   AND  A.CM_SEQNO	= B.CM_SEQNO
		   AND  B.CM_CLOSEDT IS NULL
		   AND  NVL(B.CM_CMPSVR,'N') = 'Y'
		   AND  ROWNUM=1;
    if (sqlca.sqlcode == 1403) {
		EXEC SQL
			SELECT  A.CM_VOLPATH
			  INTO	:SV_DevHome
			  FROM	CMM0038 A
			      , CMM0031 B
			 WHERE	A.CM_SysCD  = :szSysCd
			   AND  A.CM_SvrCD  = :szBaseSvr
			   AND  A.CM_RsrcCD = :szRsrcCD
			   AND  A.CM_SYSCD	= B.CM_SYSCD
			   AND  A.CM_SVRCD  = B.CM_SVRCD
			   AND  A.CM_SEQNO	= B.CM_SEQNO
			   AND  B.CM_CLOSEDT IS NULL
			   AND  ROWNUM=1;   
	}			   
	if (sqlca.sqlcode != 0) {
		sprintf(gszLogMsg, "SQLErrCheck 1: Directory Base Server 정보 오류 syscd[%s]rsrccd[%s]svrcd[%s] 01 [%d] [%s]", szSysCd,szRsrcCD,szBaseSvr, sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
		eCAMS_Log(gszLogPath,gszLogFile,gszLogMsg);
		exit (1);
	}	   
	sprintf(SV_DevHome, "%s", trunc_char(SV_DevHome));
	
	EXEC SQL
		SELECT  CM_VOLPATH
		  INTO	:SV_ProdHome
		  FROM	CMM0038
		 WHERE	CM_SysCD  = :szSysCd
		   AND  CM_SEQNO  = :szSeqNo
		   AND  CM_SvrCD  = :szSvrCd
		   AND  CM_RsrcCD = :szRsrcCD;

	if (sqlca.sqlcode != 0) {
		sprintf(gszLogMsg, "SQLErrCheck 2: REAL Server 정보 오류 syscd[%s]rsrccd[%s]svrcd[%s]szSeqNo[%d] [%d] [%s]", szSysCd,szRsrcCD,szSvrCd,szSeqNo,sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
		eCAMS_Log(gszLogPath,gszLogFile,gszLogMsg);
		exit (1);
	}

	sprintf(SV_ProdHome, "%s", trunc_char(SV_ProdHome));
	sprintf(szDirPath  , "%s", rep_char(szDirPath  , "//", "/"));
	sprintf(SV_ProdHome, "%s", rep_char(SV_ProdHome, "//", "/"));
	sprintf(SV_DevHome , "%s", rep_char(SV_DevHome , "//", "/"));
   
	if (cmp_left_char(szDirPath, strlen(SV_DevHome), SV_DevHome) == 0) {
		printf ( "11111111111111 szDirPath[%s], SV_DevHome[%s] SV_DevHome len=[%d]\n", szDirPath, SV_DevHome, strlen(SV_DevHome));
		sprintf(szChangDirPath1, "%s/%s", SV_ProdHome, right_char(szDirPath, strlen(szDirPath) - strlen(SV_DevHome)));
		sprintf(szChangDirPath, "%s", rep_char(szChangDirPath1, "//", "/"));
		printf ( "11111111111111 szChangDirPath[%s] \n", szChangDirPath);

	}
	else {
		sprintf(szChangDirPath, "%s", szDirPath);
		printf ( "2222222222222 szDirPath[%s]\n", szDirPath);
	}
}



/*****************************************************************/
/*                                                               */
/*      계정/정보계 기존 버전자료 이행 처리  M A I N             */
/*                                                               */
/*****************************************************************/
int		main (int argc, char **argv, char **envp)
{
char 	szSysCD                [dfSysCD];
char	szRsrcCD              [dfRsrcCD];
char	szDsnCD               [dfDsnCD];
char 	szRsrcName          [dfRsrcName];
char	szItemID              [dfItemID];
char 	szVolDir                 [dfDir];
char	szDir                    [dfDir];
char	szTempDir                [dfDir];
char	szSvrIP                [dfSvrIP];
char	szSvrCD                [dfSvrCD];
int 	szSvrSeq                        ;
int 	nPort                           ;
char	szEditor              [dfEditor];
char	szChangDirPath           [dfDir];
char	szTeam                   [100+1];
char	szInItemID            [dfItemID];
int 	szLastVer                       ;
char	szSysCmd            [dfFullPath];
char	szLocal             [dfFullPath];
char	szASTACD             [4+1];
CMD_INFO	CmdInfo                     ;


	if (argc != 2) {
		fprintf(stderr, "Usage : %s <ITEMID> \n", argv[0]);
		exit (1);
	}
	
	Get_Sys_Date(gszLogFile);
	strcat(gszLogFile,"_effsend.log");
  sprintf(gszLogPath,"%s/",getenv("LOGDIR"));	
	
	memset(szInItemID, 0x00, sizeof(szInItemID));
	sprintf(szInItemID, "%s", argv[1]);
	
	NotUseDataTruncate (szInItemID, 0x20);
		

    /*-----------------------------------------------------------*/
    /*   Signal Define			                                 */
    /*-----------------------------------------------------------*/
    DefineSignal ();

	nPort = 0;
	
    /*-----------------------------------------------------------*/
    /*   eCAMS  DB Server  Connect                               */
    /*-----------------------------------------------------------*/
	if (ConnectDB() == FALSE) {
		fprintf(stderr, "DB 연결 않됨 \n");
		exit(1);
	}

	/*-----------------------------------------------------------*/
    /*   Set Temp Directory                                      */
    /*-----------------------------------------------------------*/
	SetTempDir("99", gszTempPath);
	NotUseDataTruncate(gszTempPath,0x20);
	if (strlen(gszTempPath) == 0) {
		strcpy(gszTempPath,"tmp/");
	}
	else {
		if (cmp_right_char(gszTempPath, 1, "/") != 0)
	       sprintf(gszTempPath,"%s%s", gszTempPath,"/");
	}
	
	memset ( szTempDir, 0x00, sizeof(szTempDir));

	/*-----------------------------------------------------------*/
    /*   소스백업 디렉토리                                       */
    /*-----------------------------------------------------------*/
	SetTempDir("93", gszBackPath);

	/*-----------------------------------------------------------*/
	/*	소켓 명령 변수 초기화                                    */
	/*-----------------------------------------------------------*/
	InitCmdInfo(&CmdInfo);
	strcpy(CmdInfo.szAcptNo  , "000000000000");
	sprintf(CmdInfo.szLogFile, "%sTransList.%s",gszLogPath,gszLogFile);

			
	/*-----------------------------------------------------------*/
	/*	영향분석 서버 정보 조회                                  */
	/*-----------------------------------------------------------*/
	EXEC SQL
		SELECT  A.CR_SYSCD
		      , A.CR_RSRCCD
		      , A.CR_RSRCNAME
		      , A.CR_ITEMID
		      , A.CR_LSTVER
		      , D.CM_DIRPATH
		  INTO  :szSysCD
		  	  , :szRsrcCD
		  	  , :szRsrcName
		  	  , :szItemID
		  	  , :szLastVer
		  	  , :szDir
		  FROM  CMR0020 A
		      , CMM0030 C
		      , CMM0070 D
		 WHERE  A.CR_ITEMID = :szInItemID
		   AND  A.CR_SYSCD  = C.CM_SYSCD
		   AND  A.CR_SYSCD  = D.CM_SYSCD
		   AND  A.CR_DSNCD  = D.CM_DSNCD
/*2017.01.20 추가 */
		   AND  A.CR_REALVER > 0 
		   AND  A.CR_STATUS <> '9';
		   
	if (sqlca.sqlcode != 0) {
		/*LOG*/sprintf(gszLogMsg,"영향분석 서버 ERROR [%d][%s]", sqlca.sqlcode,sqlca.sqlerrm.sqlerrmc);
		eCAMS_Log(gszLogPath,gszLogFile,gszLogMsg);		
		exit (1);
	}

	NotUseDataTruncate (szSysCD   , 0x20);
	NotUseDataTruncate (szRsrcCD  , 0x20);
	NotUseDataTruncate (szRsrcName, 0x20);
	NotUseDataTruncate (szItemID  , 0x20);
	NotUseDataTruncate (szDir     , 0x20);

	
	EXEC SQL
		SELECT  CM_SVRIP
		      , CM_SVRCD
		      , CM_SEQNO
		      , CM_PORTNO
		  INTO  :szSvrIP
		  	  , :szSvrCD
		  	  , :szSvrSeq
		  	  , :nPort
		  FROM  CMM0031
		 WHERE  CM_SYSCD = :szSysCD
		   AND  CM_SVRCD = '90'
		   AND  CM_CLOSEDT IS NULL
		   AND  ROWNUM = 1;
		   
	NotUseDataTruncate (szSvrIP   , 0x20);
	NotUseDataTruncate (szSvrCD   , 0x20);
	
	sprintf(CmdInfo.szServerIP, "%s", szSvrIP);
	CmdInfo.nPort	= nPort;
	
    /*-----------------------------------------------------------*/
    /*   버전파일 작성                                           */
    /*-----------------------------------------------------------*/
	sprintf(szLocal, "%s/%s/%s"  , gszTempPath, szItemID, szRsrcName);
    NotUseDataTruncate (szLocal, 0x20);

	sprintf(szSysCmd, "FileRead_cmr0025 '%s' '%s' %d", szItemID, szLocal, szLastVer);
	system (szSysCmd);
	
	
	ChangeVolPath_Test(szSysCD , szSvrCD, szRsrcCD, szSvrSeq, szDir, szChangDirPath);

	sprintf (szTempDir, "/ecams_src/%s", szSysCD);
	sprintf(szChangDirPath , "%s", rep_char(szChangDirPath  , "/ecams_src", szTempDir));		

	
	sprintf(CmdInfo.szJobGub,"F");
	sprintf(CmdInfo.szRemote, "%s/%s",  szChangDirPath, szRsrcName);
	sprintf(CmdInfo.szLocal , "%s", szLocal);	
	Server_Cmd_JOB(&CmdInfo);
	if (strcmp(CmdInfo.szRstCond, "0000") != 0) {
		/*LOG*/sprintf(gszLogMsg,"%s File Send Error (<%s><%s><%s><%s><%s><%s> <%s><%d>)", argv[0], szRsrcName, szChangDirPath, szLocal, CmdInfo.szRstCond, szItemID,CmdInfo.szRemote, CmdInfo.szRstCond, szLastVer);
		eCAMS_Log(gszLogPath,gszLogFile,gszLogMsg);
	}		
	remove (szLocal);
	
	sprintf(szSysCmd, "rm -r %s/%s", gszTempPath, szItemID);
	system(szSysCmd) / 256;
	
	EXEC SQL COMMIT WORK RELEASE;
	exit (0);
}


/*---------------------------------------------------------------*/
/*             E N D    O F    P R O G R A M                     */
/*---------------------------------------------------------------*/
