	EXEC SQL AT ASIS
		DECLARE ASIS_CMM0072 CURSOR FOR
			SELECT  CM_SYSCD
			      , CM_DSNCD
			      , CM_RSRCCD
   			  FROM  COVM_IMS.CMM0072 A
   			 WHERE  EXISTS (SELECT 'X'
   			                  FROM  COVM_IMS.CMM0070
   			                 WHERE  CM_SYSCD = A.CM_SYSCD
   			                   AND  CM_DSNCD = A.CM_DSNCD
   			                   AND  CM_DIRPATH IS NOT NULL
   			               );

	EXEC SQL AT ASIS OPEN ASIS_CMM0072;

	if (sqlca.sqlcode != 0) {
		fprintf(stderr, "ASIS_%s SQL ERROR [%d] [%s]\n", pTABLENM, sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
