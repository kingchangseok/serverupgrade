/*---------------------------------------------------------------*/
/*	Function  : CMR9900_CONVERT                                  */
/*	Action    : CMR9900 CONVERT                                  */
/*	            신청건별 결재 정보                               */
/*	Parameter : pTABLENM : 테이블명                              */
/*	Return    : 0 : 정상, 1 : 오류                               */
/*---------------------------------------------------------------*/
int 	CMR9900_CONVERT     ( char *pTABLENM
							)
{
char	szACPTNO                  [12+1];
int 	szSEQNO                         ;
char	szLOCAT                    [2+1];
char	szCONFNAME                [50+1];
char	szTEAM                    [10+1];
char	szTEAMCD                   [1+1];
char	szSTATUS                   [1+1];
char	szCONGBN                   [1+1];
char	szCOMMON                   [1+1];
char	szBLANK                    [1+1];
char	szEMGER                    [1+1];
char	szHOLI                     [1+1];
char	szSGNGBN                 [100+1];
char	szBLANKCD                  [2+1];
char	szORGSTEP                  [1+1];
char	szBASEUSR                 [10+1];
char	szCONFDATE                [14+1];
char	szCONFUSR                 [10+1];
char	szCONMSG                 [500+1];


	Get_Sys_Date(szStartDate);
	Get_Sys_Time(szStartTime);

	szTotalCnt   = 0;
	szSuccessCnt = 0;
	szErrorCnt   = 0;



	/*-----------------------------------------------------------*/
    /*	 AS-IS TABLE  READ                                       */
    /*-----------------------------------------------------------*/
	EXEC SQL AT ASIS
		DECLARE ASIS_CMR9900 CURSOR FOR
			SELECT  CR_ACPTNO
			      , NVL(CR_SEQNO, 0)
			      , CR_LOCAT
			      , CR_CONFNAME
			      , CR_TEAM
			      , CR_TEAMCD
			      , CR_STATUS
			      , CR_CONGBN
			      , CR_COMMON
			      , CR_BLANK
			      , CR_EMGER
			      , CR_HOLI
			      , CR_SGNGBN
			      , CR_BLANKCD
			      , CR_ORGSTEP
			      , CR_BASEUSR
			      , TO_CHAR(CR_CONFDATE, 'YYYYMMDDHH24MISS')
			      , CR_CONFUSR
			      , CR_CONMSG
   			  FROM  COVM_IMS.CMR9900 A
		     WHERE  EXISTS (SELECT  'X'
		                      FROM  COVM_IMS.CMR1000
                             WHERE  CR_SYSCD  = DECODE(:szINSysCD, 'ALL', CR_SYSCD, :szINSysCD)
                               AND  CR_ACPTNO = A.CR_ACPTNO
                           );

	EXEC SQL AT ASIS OPEN ASIS_CMR9900;

	if (sqlca.sqlcode != 0) {
		fprintf(stderr, "ASIS_%s SQL ERROR [%d] [%s]\n", pTABLENM, sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
		exit (1);
	}

    while (1) {
		EXEC SQL AT ASIS FETCH ASIS_CMR9900
			INTO  :szACPTNO
			    , :szSEQNO
			    , :szLOCAT
			    , :szCONFNAME
			    , :szTEAM
			    , :szTEAMCD
			    , :szSTATUS
			    , :szCONGBN
			    , :szCOMMON
			    , :szBLANK
			    , :szEMGER
			    , :szHOLI
			    , :szSGNGBN
			    , :szBLANKCD
			    , :szORGSTEP
			    , :szBASEUSR
			    , :szCONFDATE
			    , :szCONFUSR
			    , :szCONMSG  ;

		if (sqlca.sqlcode == 1403) break;

		szTotalCnt++;

		if (sqlca.sqlcode != 0 && sqlca.sqlcode != -1405) {
			fprintf(stderr, "%d %s\n", sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
			szErrorCnt++;
			break;
		}

		sprintf(szACPTNO  , "%s", trunc_char(szACPTNO  ));
		sprintf(szLOCAT   , "%s", trunc_char(szLOCAT   ));
		sprintf(szCONFNAME, "%s", trunc_char(szCONFNAME));
		sprintf(szTEAM    , "%s", trunc_char(szTEAM    ));
		sprintf(szTEAMCD  , "%s", trunc_char(szTEAMCD  ));
		sprintf(szSTATUS  , "%s", trunc_char(szSTATUS  ));
		sprintf(szCONGBN  , "%s", trunc_char(szCONGBN  ));
		sprintf(szCOMMON  , "%s", trunc_char(szCOMMON  ));
		sprintf(szBLANK   , "%s", trunc_char(szBLANK   ));
		sprintf(szEMGER   , "%s", trunc_char(szEMGER   ));
		sprintf(szHOLI    , "%s", trunc_char(szHOLI    ));
		sprintf(szSGNGBN  , "%s", trunc_char(szSGNGBN  ));
		sprintf(szBLANKCD , "%s", trunc_char(szBLANKCD ));
		sprintf(szORGSTEP , "%s", trunc_char(szORGSTEP ));
		sprintf(szBASEUSR , "%s", trunc_char(szBASEUSR ));
		sprintf(szCONFDATE, "%s", trunc_char(szCONFDATE));
		sprintf(szCONFUSR , "%s", trunc_char(szCONFUSR ));
		sprintf(szCONMSG  , "%s", trunc_char(szCONMSG  ));


		/*-------------------------------------------------------*/
	    /*	TO-BE TABLE INSERT                                   */
	    /*-------------------------------------------------------*/
		EXEC SQL AT TOBE
			INSERT INTO CMR9900
				( CR_ACPTNO
				, CR_SEQNO
				, CR_LOCAT
				, CR_CONFNAME
				, CR_TEAM
				, CR_TEAMCD
				, CR_STATUS
				, CR_CONGBN
				, CR_COMMON
				, CR_BLANK
				, CR_EMGER
				, CR_HOLI
				, CR_SGNGBN
				, CR_BLANKCD
				, CR_ORGSTEP
				, CR_BASEUSR
				, CR_CONFDATE
				, CR_CONFUSR
				, CR_CONMSG
				, CR_EMGAFT
				, CR_PRCSW
				, CR_QRYCD
				, CR_STDATE
				)
			VALUES
				( :szACPTNO
			    , :szSEQNO
			    , :szLOCAT
			    , :szCONFNAME
			    , :szTEAM
			    , :szTEAMCD
			    , :szSTATUS
			    , :szCONGBN
			    , :szCOMMON
			    , :szBLANK
			    , :szEMGER
			    , :szHOLI
			    , :szSGNGBN
			    , :szBLANKCD
			    , :szORGSTEP
			    , :szBASEUSR
			    , TO_DATE(:szCONFDATE, 'YYYYMMDDHH24MISS')
			    , :szCONFUSR
			    , :szCONMSG
			    , NULL
			    , 'N'
			    , DECODE(:szLOCAT, '00', NULL, SUBSTR(:szACPTNO, 5, 2))
			    , NULL
				);

		if (sqlca.sqlcode == 0)
			szSuccessCnt++;
		else {
			fprintf(stderr, "%d %s\n", sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
			szErrorCnt++;
		}

		EXEC SQL AT TOBE COMMIT;
 	}
 	EXEC SQL AT ASIS close ASIS_CMR9900;

	Get_Sys_Date(szEndDate);
	Get_Sys_Time(szEndTime);

	fprintf(stdout, "TABLE : %-20s TOTAL : %06d   SUCCESS : %06d   ERROR : %06d [%s %s ~ %s %s] %d\n"
				  , pTABLENM, szTotalCnt, szSuccessCnt, szErrorCnt, szStartDate, szStartTime, szEndDate, szEndTime
				  , Get_RunSecond(szStartDate, szStartTime, szEndDate, szEndTime));

	return (0);

}



/*---------------------------------------------------------------*/
/*	Function  : SYSTEM_TEAM_MAPPING_CONVERT                      */
/*	Action    : SYSTEM_TEAM_MAPPING CONVERT                      */
/*	            시스템-팀 MAPPING Table                          */
/*	Parameter : pTABLENM : 테이블명                              */
/*	Return    : 0 : 정상, 1 : 오류                               */
/*---------------------------------------------------------------*/
int 	SYSTEM_TEAM_MAPPING_CONVERT	( char *pTABLENM
									)
{
char	szSYSCD                    [3+1];
char	szSYSNM                   [50+1];
char	szDEPTCD                  [10+1];
char	szDEPTNM                  [50+1];


	Get_Sys_Date(szStartDate);
	Get_Sys_Time(szStartTime);

	szTotalCnt   = 0;
	szSuccessCnt = 0;
	szErrorCnt   = 0;



	/*-----------------------------------------------------------*/
    /*	 AS-IS TABLE  READ                                       */
    /*-----------------------------------------------------------*/
	EXEC SQL AT ASIS
		DECLARE ASIS_SYSTEM_TEAM_MAPPING CURSOR FOR
			SELECT  SYSCD 
			      , SYSNM 
			      , DEPTCD
			      , DEPTNM
   			  FROM  COVM_IMS.SYSTEM_TEAM_MAPPING;

	EXEC SQL AT ASIS OPEN ASIS_SYSTEM_TEAM_MAPPING;

	if (sqlca.sqlcode != 0) {
		fprintf(stderr, "ASIS_%s SQL ERROR [%d] [%s]\n", pTABLENM, sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
		exit (1);
	}

    while (1) {
		EXEC SQL AT ASIS FETCH ASIS_SYSTEM_TEAM_MAPPING
			INTO  :szSYSCD 
			    , :szSYSNM 
			    , :szDEPTCD
			    , :szDEPTNM;

		if (sqlca.sqlcode == 1403) break;

		szTotalCnt++;

		if (sqlca.sqlcode != 0 && sqlca.sqlcode != -1405) {
			fprintf(stderr, "%d %s\n", sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
			szErrorCnt++;
			break;
		}

		sprintf(szSYSCD , "%s", trunc_char(szSYSCD ));
		sprintf(szSYSNM , "%s", trunc_char(szSYSNM ));
		sprintf(szDEPTCD, "%s", trunc_char(szDEPTCD));
		sprintf(szDEPTNM, "%s", trunc_char(szDEPTNM));

		/*-------------------------------------------------------*/
	    /*	TO-BE TABLE INSERT                                   */
	    /*-------------------------------------------------------*/
		EXEC SQL AT TOBE
			INSERT INTO ASIS_SYSTEM_TEAM_MAPPING
				( SYSCD 
				, SYSNM 
				, DEPTCD
				, DEPTNM
				)
			VALUES
				( LPAD(:szSYSCD, 5, '0')
			    , :szSYSNM 
			    , :szDEPTCD
			    , :szDEPTNM
				);

		if (sqlca.sqlcode == 0)
			szSuccessCnt++;
		else {
			fprintf(stderr, "%d %s\n", sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
			szErrorCnt++;
		}

		EXEC SQL AT TOBE COMMIT;
 	}
 	EXEC SQL AT ASIS close ASIS_SYSTEM_TEAM_MAPPING;

	Get_Sys_Date(szEndDate);
	Get_Sys_Time(szEndTime);

	fprintf(stdout, "TABLE : %-20s TOTAL : %06d   SUCCESS : %06d   ERROR : %06d [%s %s ~ %s %s] %d\n"
				  , pTABLENM, szTotalCnt, szSuccessCnt, szErrorCnt, szStartDate, szStartTime, szEndDate, szEndTime
				  , Get_RunSecond(szStartDate, szStartTime, szEndDate, szEndTime));

	return (0);
}



/*---------------------------------------------------------------*/
/*	Function  : ITEMID_CHECK                                     */
/*	Action    : ITEMID_CHECK 및 작성                             */
/*	Parameter : pSYSCD    : 시스템코드                           */
/*	            pDSNCD    : 디렉토리코드                         */
/*	            pRSRCNAME : 프로그램명                           */
/*	            pITEMID   : 프로그램등록번호                     */
/*	            pGUBUN    : 구분 ( 01 : 조회, 02 :작성)          */
/*	Return    : 0 : 정상, 1 : 오류                               */
/*---------------------------------------------------------------*/
int 	ITEMID_CHECK	( char *pSYSCD
						, char *pDSNCD
						, char *pRSRCNAME
						, char *pITEMID
						, char *pGUBUN
						)
{
char	szDsnCD                    [5+1];
char	szITEMID                  [12+1];


	if (strcmp(pGUBUN, "01") == 0) {
		EXEC SQL AT TOBE
			SELECT  CR_ITEMID
			  INTO  :szITEMID
			  FROM  CMR0020
			 WHERE  CR_SYSCD    = LPAD(:pSYSCD , 5, '0')
			   AND  CR_DSNCD    = :pDSNCD
			   AND  CR_RSRCNAME = :pRSRCNAME;

		if (sqlca.sqlcode == 0) {
			NotUseDataTruncate (szITEMID, 0x20);
			sprintf(pITEMID, "%s", szITEMID);
			return (0);
		}

		EXEC SQL AT TOBE
			SELECT  CR_ITEMID
			  INTO  :szITEMID
			  FROM  CMR0020
			 WHERE  CR_SYSCD    = LPAD(:pSYSCD , 5, '0')
			   AND  CR_RSRCNAME = :pRSRCNAME
			   AND  ROWNUM = 1;

		if (sqlca.sqlcode != 0) {
			memset(szITEMID, 0x00, sizeof(szITEMID));
			sprintf(pITEMID, "%s", szITEMID);
			return (1);
		}
		NotUseDataTruncate (pITEMID, 0x20);
	}

	else
	if (strcmp(pGUBUN, "03") == 0) {
		EXEC SQL AT TOBE
			SELECT  CR_ITEMID
			  INTO  :szITEMID
			  FROM  CMR0020
			 WHERE  CR_SYSCD    = LPAD(:pSYSCD, 5, '0')
			   AND  CR_DSNCD    = LPAD(:pDSNCD, 7, '0')
			   AND  CR_RSRCNAME = :pRSRCNAME;

		if (sqlca.sqlcode != 0) {
			memset(szITEMID, 0x00, sizeof(szITEMID));
			sprintf(pITEMID, "%s", szITEMID);
			return (1);
		}
		NotUseDataTruncate (szITEMID, 0x20);
	}
	else {
		fprintf(stderr, "ITEMID_CHECK 구분코드 (01/03) 오류 : [%s][%s][%s][%s][%s]n"
		              , pSYSCD, pDSNCD, pRSRCNAME, pITEMID, pGUBUN);
		return (1);
	}

	sprintf(pITEMID, "%s", szITEMID);

    return (0);

}



/*---------------------------------------------------------------*/
/*	Function  : SVRSEQ_CHECK                                     */
/*	Action    : 서버 일련번호 조회                               */
/*	Parameter : pSYSCD   : 시스템코드                            */
/*	            pSVRCD   : 서버구분                              */
/*	            pSVRIP   : 서버주소                              */
/*	            pSVRPORT : 서버포트번호                          */
/*	            pSVRSEQ  : 서버일련번호                          */
/*	            pVOLPATH : HOME DIRECTORY                        */
/*	Return    : 0 : 정상, 1 : 오류                               */
/*---------------------------------------------------------------*/
int 	SVRSEQ_CHECK	( char *pSYSCD
						, char *pSVRCD
						, char *pSVRIP
						, int   pSVRPORT
						, int  *pSVRSEQ
						, char *pVOLPATH
						)
{
char	szVOLPATH                 [1024];


	EXEC SQL AT TOBE
		SELECT  NVL(CM_SEQNO, 0)
		      , CM_VOLPATH
		  INTO  :pSVRSEQ
		  	  , :szVOLPATH
		  FROM  CMM0031
		 WHERE  CM_SYSCD = LPAD(:pSYSCD, 5, '0')
		   AND  CM_SVRCD = :pSVRCD
		   AND  CM_SVRIP = :pSVRIP
		   AND  CM_PORTNO = 29895;

	if (sqlca.sqlcode != 0) {
		pSVRSEQ = 0;

		fprintf(stderr, ">>.. %s %s %s %d %d %s\n", pSYSCD, pSVRCD, pSVRIP, pSVRPORT, sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);

		memset(szVOLPATH, 0x00, sizeof(szVOLPATH));
		return (1);
	}

	sprintf(pVOLPATH , "%s", trunc_char(szVOLPATH));

    return (0);

}



/*---------------------------------------------------------------*/
/*	Function  : CONVERT_CMM0036_INFO                             */
/*	Action    : 처리팩터 변환                                    */
/*	Parameter : pINFO    : 처리팩터                              */
/*	            pRstINFO : 변환 처리팩터                         */
/*	Return    : 0 : 정상, 1 : 오류                               */
/*---------------------------------------------------------------*/
int 	CONVERT_CMM0036_INFO	( char *pINFO
								, char *pRstINFO
								)
{
int 	nINFOLEN	                    ;

	memset(pRstINFO, 0x00, sizeof(pRstINFO));

	EXEC SQL AT TOBE
		SELECT  NVL(MAX(CM_MICODE), 0)
		  INTO  :nINFOLEN
		  FROM  CMM0020
		 WHERE  CM_MACODE = 'RSCHKITEM';

	memset(pRstINFO, '0', nINFOLEN);

	if (memcmp((char *)mid_char(pINFO,  1, 1), "1", 1) == 0) memset(&pRstINFO[ 0], '1', 1);
	if (memcmp((char *)mid_char(pINFO,  2, 1), "1", 1) == 0) memset(&pRstINFO[ 1], '1', 1);
	if (memcmp((char *)mid_char(pINFO,  3, 1), "1", 1) == 0) memset(&pRstINFO[ 2], '1', 1);
	if (memcmp((char *)mid_char(pINFO,  4, 1), "1", 1) == 0) memset(&pRstINFO[ 3], '1', 1);
	if (memcmp((char *)mid_char(pINFO,  5, 1), "1", 1) == 0) memset(&pRstINFO[15], '1', 1);
	if (memcmp((char *)mid_char(pINFO,  6, 1), "1", 1) == 0) memset(&pRstINFO[30], '1', 1);
	if (memcmp((char *)mid_char(pINFO,  7, 1), "1", 1) == 0) memset(&pRstINFO[32], '1', 1);
	if (memcmp((char *)mid_char(pINFO,  8, 1), "1", 1) == 0) memset(&pRstINFO[ 7], '1', 1);
	if (memcmp((char *)mid_char(pINFO,  9, 1), "1", 1) == 0) memset(&pRstINFO[ 8], '1', 1);
	if (memcmp((char *)mid_char(pINFO, 10, 1), "1", 1) == 0) memset(&pRstINFO[ 9], '1', 1);
	if (memcmp((char *)mid_char(pINFO, 11, 1), "1", 1) == 0) memset(&pRstINFO[10], '1', 1);
	if (memcmp((char *)mid_char(pINFO, 12, 1), "1", 1) == 0) memset(&pRstINFO[11], '1', 1);
	if (memcmp((char *)mid_char(pINFO, 13, 1), "1", 1) == 0) memset(&pRstINFO[12], '1', 1);
	if (memcmp((char *)mid_char(pINFO, 15, 1), "1", 1) == 0) memset(&pRstINFO[14], '1', 1);
	if (memcmp((char *)mid_char(pINFO, 18, 1), "1", 1) == 0) memset(&pRstINFO[33], '1', 1);
	if (memcmp((char *)mid_char(pINFO, 19, 1), "1", 1) == 0) memset(&pRstINFO[40], '1', 1);
	if (memcmp((char *)mid_char(pINFO, 20, 1), "1", 1) == 0) memset(&pRstINFO[41], '1', 1);
	if (memcmp((char *)mid_char(pINFO, 21, 1), "1", 1) == 0) memset(&pRstINFO[26], '1', 1);
	if (memcmp((char *)mid_char(pINFO, 22, 1), "1", 1) == 0) memset(&pRstINFO[27], '1', 1);
	if (memcmp((char *)mid_char(pINFO, 26, 1), "1", 1) == 0) memset(&pRstINFO[47], '1', 1);
	if (memcmp((char *)mid_char(pINFO, 27, 1), "1", 1) == 0) memset(&pRstINFO[20], '1', 1);
	if (memcmp((char *)mid_char(pINFO, 28, 1), "1", 1) == 0) memset(&pRstINFO[23], '1', 1);
	if (memcmp((char *)mid_char(pINFO, 29, 1), "1", 1) == 0) memset(&pRstINFO[24], '1', 1);
	if (memcmp((char *)mid_char(pINFO, 32, 1), "1", 1) == 0) memset(&pRstINFO[48], '1', 1);
	if (memcmp((char *)mid_char(pINFO, 33, 1), "1", 1) == 0) memset(&pRstINFO[49], '1', 1);


	printf("<%s> <%s>\n", pINFO, pRstINFO);

    return (0);

}




/*---------------------------------------------------------------*/
/*	Function  : CONVERT_SERVERCD                                 */
/*	Action    : 서버구분 변환                                    */
/*	Parameter : pSVRCD    : 서버구분                             */
/*	            pRstSVRCD : 변환 서버구분                        */
/*	Return    : 0 : 정상, 1 : 오류                               */
/*---------------------------------------------------------------*/
int 	CONVERT_SERVERCD	( char *pSVRCD
							, char *pRstSVRCD
							)
{

	/*-----------------------------------------------------------*/
	/*	01 : CHECK-OUT서버                                       */
	/*	05 : 운영서버	                                         */
	/*	07 : 배포서버                                            */
	/*-----------------------------------------------------------*/

	if (strcmp(pSVRCD, "01") == 0)	sprintf(pRstSVRCD, "%s", "01");

	else
	if (strcmp(pSVRCD, "05") == 0)	sprintf(pRstSVRCD, "%s", "03");

	else
	if (strcmp(pSVRCD, "07") == 0)	sprintf(pRstSVRCD, "%s", "05");

	else {
		fprintf(stderr, "서버구분 코드 오류 <%s>\n", pSVRCD);
		return (1);
	}

    return (0);

}




/*---------------------------------------------------------------*/
/*	Function  : Get_RunSecond                                    */
/*	Action    : 이행처리시간 계산 (초)                           */
/*	Parameter : pStartDate : 시작일자                            */
/*	            pStartTime : 시작시간                            */
/*	            pEndDate   : 종료일자                            */
/*	            pEndTime   : 종료시간                            */
/*	Return    : -1 : 오류, 이행소요시간                          */
/*---------------------------------------------------------------*/
int 	Get_RunSecond	( char *pStartDate
						, char *pStartTime
						, char *pEndDate
						, char *pEndTime
						)
{
int 	szSecond                        ;
char	szStartTM                   [20];
char	szEndTM                     [20];

	sprintf(szStartTM, "%s%s", pStartDate, pStartTime);
	sprintf(szEndTM  , "%s%s", pEndDate  , pEndTime  );

	EXEC SQL AT TOBE
		SELECT  (TO_DATE(:szEndTM, 'YYYYMMDDHH24MISS') - TO_DATE(:szStartTM, 'YYYYMMDDHH24MISS')) * 1440 * 60
		  INTO  :szSecond
		  FROM  DUAL;

	if (sqlca.sqlcode != 0)
		szSecond = 0;

	return szSecond;

}



/*---------------------------------------------------------------*/
/*	Function  : Get_RunSecond                                    */
/*	Action    : 이행처리시간 계산 (초)                           */
/*	Parameter : pErrMsg   : 오류내용                             */
/*	            pSYSCD    : 시스템코드                           */
/*	            pDSNCD    : 디렉토리코드                         */
/*	            pRSRCNAME : 프로그램명                           */
/*	            pItemID   : 프로그램등록번호                     */
/*	Return    : -1 : 오류, 이행소요시간                          */
/*---------------------------------------------------------------*/
int 	ITEMID_Check_Err_Log	( char *pTABNAME
								, char *pErrMsg
								, char *pSYSCD
								, char *pDSNCD
								, char *pRSRCNAME
								, char *pBASEDSNCD
								, char *pBASERSRCNAME
								)
{
char	szLogDir 	               [256];
char	szLogFile	               [256];
char	szCmd                      [256];
FILE	*LogPtr;


	sprintf(szLogDir, "%s", "IHLOG");
	sprintf(szCmd, "mkdir %s 1>/dev/null 2>&1", szLogDir);
	system (szCmd);

	sprintf(szLogFile, "%s/ITEMID.err", szLogDir);

	Get_Sys_Date(szEndDate);
	Get_Sys_Time(szEndTime);

	LogPtr = fopen(szLogFile, "a+");
	if (LogPtr == (FILE *)NULL) {
		exit (1);
	}

	fprintf(LogPtr, "%s %s %s %s : [%s] [%s] [%s] [%s] [%s]\n", szEndDate, szEndTime, pTABNAME, pErrMsg, pSYSCD, pDSNCD, pRSRCNAME, pBASEDSNCD, pBASERSRCNAME);
	fclose (LogPtr);
	fflush (LogPtr);

	return (0);

}


