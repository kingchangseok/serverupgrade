	}

    while (1) {
		EXEC SQL AT ASIS FETCH ASIS_CMM0072
			INTO  :szSYSCD
				, :szDSNCD
				, :szRSRCCD;

		if (sqlca.sqlcode == 1403) break;

		szTotalCnt++;

		if (sqlca.sqlcode != 0 && sqlca.sqlcode != -1405) {
			fprintf(stderr, "%d %s\n", sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
