/*---------------------------------------------------------------*/
/*	Function  : CMM0040_CONVERT                                  */
/*	Action    : CMM0040 CONVERT                                  */
/*	            사용자정보                                       */
/*	Parameter : pTABLENM : 테이블명                              */
/*	Return    : 0 : 정상, 1 : 오류                               */
/*---------------------------------------------------------------*/
int 	CMM0040_CONVERT     ( char *pTABLENM
							)
{
char	szUSERID                  [10+1];
char	szUSERNAME                [20+1];
char	szCPASSWD                [255+1];
char	szCHANGEDT                [14+1];
char	szLOGINDT                 [14+1];
int 	szERCOUNT                       ;
char	szADMIN                    [1+1];
char	szMANID                    [1+1];
char	szSTATUS                   [1+1];
char	szPROJECT                 [10+1];
char	szPOSITION                 [3+1];
char	szDUTY                    [20+1];
char	szIPADDRESS               [16+1];
char	szLOCALNAME               [20+1];
char	szACTIVE                   [1+1];
char	szTELNO1                  [20+1];
char	szTELNO2                  [20+1];
char	szCLSDATE                 [14+1];
char	szDEPTSEQ                 [50+1];
char	szDAEGYUL                 [10+1];
char	szDAEGMSG                 [10+1];
char	szDAESAYU                [100+1];
char	szBLANKDTS                 [8+1];
char	szBLANKDTE                 [8+1];
char	szPROJECT2                [10+1];
char	szDEPTSEQ2                [50+1];
char	szCONURL                 [100+1];
char	szMOBILE                  [20+1];

	Get_Sys_Date(szStartDate);
	Get_Sys_Time(szStartTime);

	szTotalCnt   = 0;
	szSuccessCnt = 0;
	szErrorCnt   = 0;


	/*-----------------------------------------------------------*/
    /*	 AS-IS TABLE  READ                                       */
    /*-----------------------------------------------------------*/
	EXEC SQL AT ASIS
		DECLARE ASIS_CMM0040 CURSOR FOR
			SELECT  CM_USERID
			      , CM_USERNAME
			      , CM_CPASSWD
			      , TO_CHAR(CM_CHANGEDT, 'YYYYMMDDHH24MISS')
			      , TO_CHAR(CM_LOGINDT , 'YYYYMMDDHH24MISS')
			      , CM_ERCOUNT
			      , CM_ADMIN
			      , CM_MANID
