		sprintf(szTMAXUSER, "%s", trunc_char(szTMAXUSER));
		sprintf(szTMAXPASS, "%s", trunc_char(szTMAXPASS));

		/*-------------------------------------------------------*/
	    /*	TO-BE TABLE INSERT                                   */
	    /*-------------------------------------------------------*/
		EXEC SQL AT TOBE
			INSERT INTO CMM0039
				( CM_SYSCD
				, CM_DIRCD
				, CM_DIRPATH
				, CM_SVRIP
				, CM_PORT
				, CM_SHELL
				, CM_SVRUSR
				, CM_SVRPASS
				)
			VALUES
				( LPAD(:szSYSCD, 5, '0')
				, '01'
				, '/'
				, :szTMAXIP
				, :szTMAXPORT
				, NULL
				, :szTMAXUSER
				, :szTMAXPASS
				);

		if (sqlca.sqlcode == 0)
