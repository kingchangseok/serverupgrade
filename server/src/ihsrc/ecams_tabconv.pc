/*	            파일비교기록                                     */
/*	Parameter : pTABLENM : 테이블명                              */
/*	Return    : 0 : 정상, 1 : 오류                               */
/*---------------------------------------------------------------*/
int 	CMD0021_CONVERT     ( char *pTABLENM
							)
{
char	szSYSCD                    [3+1];
char	szEDITOR                  [10+1];
char	szBASICDT                 [14+1];
char	szREQCD                    [1+1];
char	szDIRPATH                [300+1];
char	szRSRCNAME               [100+1];
char	szDIFFECAMS                [1+1];
char	szEXTNAME                 [50+1];
char	szSVRIP                  [200+1];
char	szDIFFDATE                [14+1];
char 	szREQDT                   [14+1];
char	szSTATUS                   [1+1];


	Get_Sys_Date(szStartDate);
	Get_Sys_Time(szStartTime);

	szTotalCnt   = 0;
	szSuccessCnt = 0;
	szErrorCnt   = 0;

	/*-----------------------------------------------------------*/
    /*	 AS-IS TABLE  READ                                       */
    /*-----------------------------------------------------------*/
	EXEC SQL AT ASIS
		DECLARE ASIS_CMD0021 CURSOR FOR
			SELECT  CD_SYSCD
			      , CD_EDITOR
			      , CD_BASICDT
			      , CD_REQCD
			      , CD_DIRPATH
			      , CD_RSRCNAME
			      , CD_DIFFECAMS
			      , CD_EXTNAME
			      , CD_SVRIP
			      , TO_CHAR(CD_DIFFDATE, 'YYYYMMDDHH24MISS')
			      , CD_REQDT
			      , CD_STATUS
   			  FROM  COVM_IMS.CMD0021
   			 WHERE  CD_SYSCD = DECODE(:szINSysCD, 'ALL', CD_SYSCD, :szINSysCD);


	EXEC SQL AT ASIS OPEN ASIS_CMD0021;

	if (sqlca.sqlcode != 0) {
		fprintf(stderr, "ASIS_%s SQL ERROR [%d] [%s]\n", pTABLENM, sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
		exit (1);
	}

    while (1) {
		EXEC SQL AT ASIS FETCH ASIS_CMD0021
			INTO  :szSYSCD
				, :szEDITOR
				, :szBASICDT
				, :szREQCD
				, :szDIRPATH
				, :szRSRCNAME
				, :szDIFFECAMS
				, :szEXTNAME
				, :szSVRIP
				, :szDIFFDATE
				, :szREQDT
				, :szSTATUS   ;

		if (sqlca.sqlcode == 1403) break;

		if (sqlca.sqlcode != 0 && sqlca.sqlcode != -1405) {
			fprintf(stderr, "%d %s\n", sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
			szErrorCnt++;
			break;
		}

		sprintf(szSYSCD    , "%s", trunc_char(szSYSCD    ));
		sprintf(szEDITOR   , "%s", trunc_char(szEDITOR   ));
		sprintf(szBASICDT  , "%s", trunc_char(szBASICDT  ));
		sprintf(szREQCD    , "%s", trunc_char(szREQCD    ));
		sprintf(szDIRPATH  , "%s", trunc_char(szDIRPATH  ));
		sprintf(szRSRCNAME , "%s", trunc_char(szRSRCNAME ));
		sprintf(szDIFFECAMS, "%s", trunc_char(szDIFFECAMS));
		sprintf(szEXTNAME  , "%s", trunc_char(szEXTNAME  ));
		sprintf(szSVRIP    , "%s", trunc_char(szSVRIP    ));
		sprintf(szDIFFDATE , "%s", trunc_char(szDIFFDATE ));
		sprintf(szREQDT    , "%s", trunc_char(szREQDT    ));
		sprintf(szSTATUS   , "%s", trunc_char(szSTATUS   ));

		szTotalCnt++;

		/*-------------------------------------------------------*/
	    /*	TO-BE TABLE INSERT                                   */
	    /*-------------------------------------------------------*/
		EXEC SQL AT TOBE
			INSERT INTO CMD0021
				( CD_SYSCD
			    , CD_EDITOR
			    , CD_BASICDT
			    , CD_REQCD
			    , CD_DIRPATH
			    , CD_RSRCNAME
			    , CD_DIFFECAMS
			    , CD_EXTNAME
			    , CD_SVRIP
			    , CD_DIFFDATE
			    , CD_REQDT
			    , CD_STATUS
			    )
			VALUES
				( LPAD(:szSYSCD, 5, '0')
				, :szEDITOR
				, :szBASICDT
				, :szREQCD
				, :szDIRPATH
				, :szRSRCNAME
				, :szDIFFECAMS
				, :szEXTNAME
				, :szSVRIP
				, TO_DATE(:szDIFFDATE, 'YYYYMMDDHH24MISS')
				, :szREQDT
				, :szSTATUS
				);

		if (sqlca.sqlcode == 0)
			szSuccessCnt++;
		else {
			szErrorCnt++;
		}
		EXEC SQL AT TOBE COMMIT;
 	}
 	EXEC SQL AT ASIS close ASIS_CMD0021;

	Get_Sys_Date(szEndDate);
	Get_Sys_Time(szEndTime);

	fprintf(stdout, "TABLE : %-20s TOTAL : %06d   SUCCESS : %06d   ERROR : %06d [%s %s ~ %s %s] %d\n"
				  , pTABLENM, szTotalCnt, szSuccessCnt, szErrorCnt, szStartDate, szStartTime, szEndDate, szEndTime
				  , Get_RunSecond(szStartDate, szStartTime, szEndDate, szEndTime));

 	return (0);

}





