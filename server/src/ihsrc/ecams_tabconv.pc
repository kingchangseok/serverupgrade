int 	CMM0041_CONVERT     ( char *pTABLENM
							)
{

char	szUSERID                 [10+1];
char	szCHANGDT                [14+1];
char	szPASSWD                 [20+1];

	Get_Sys_Date(szStartDate);
	Get_Sys_Time(szStartTime);

	szTotalCnt   = 0;
	szSuccessCnt = 0;
	szErrorCnt   = 0;


	/*-----------------------------------------------------------*/
    /*	 AS-IS TABLE  READ                                       */
    /*-----------------------------------------------------------*/
	EXEC SQL AT ASIS
		DECLARE ASIS_CMM0041 CURSOR FOR
			SELECT  CM_USERID
			      , TO_CHAR(CM_CHANGDT, 'YYYYMMDDHH24MISS')
			      , CM_PASSWD
   			  FROM  COVM_IMS.CMM0041;

