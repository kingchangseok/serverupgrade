			break;
		}

		sprintf(szRPOSITION, "%s", trunc_char(szRPOSITION));
		sprintf(szSPOSITION, "%s", trunc_char(szSPOSITION));


		/*-------------------------------------------------------*/
	    /*	TO-BE TABLE INSERT                                   */
