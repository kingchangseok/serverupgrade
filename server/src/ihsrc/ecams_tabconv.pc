		sprintf(szSAYUCD   , "%s", trunc_char(szSAYUCD   ));
		sprintf(szOPENDAY  , "%s", trunc_char(szOPENDAY  ));

		szTotalCnt++;

		/*-------------------------------------------------------*/
	    /*	TO-BE TABLE INSERT                                   */
	    /*-------------------------------------------------------*/
		EXEC SQL AT TOBE
			INSERT INTO CMD0028
				( CD_SYSCD
				, CD_DSNCD
				, CD_JOBCD
				, CD_RSRCCD
				, CD_RSRCNAME
				, CD_CREATOR
				, CD_EDITOR
				, CD_CLSEDITOR
				, CD_REQDOC
				, CD_OPENDATE
				, CD_CLSDATE
				, CD_LASTDATE
				, CD_GUBUN
				, CD_SAYUCD
				, CD_OPENDAY
			    )
			VALUES
				( LPAD(:szSYSCD, 5, '0')
				, DECODE(LENGTH(:szDSNCD), 5, LPAD(:szDSNCD, 7, '0'), :szDSNCD)
				, :szJOBCD
				, :szRSRCCD
				, :szRSRCNAME
				, :szCREATOR
				, :szEDITOR
				, :szCLSEDITOR
				, :szREQDOC
				, TO_DATE(:szOPENDATE, 'YYYYMMDDHH24MISS')
				, TO_DATE(:szCLSDATE , 'YYYYMMDDHH24MISS')
				, TO_DATE(:szLASTDATE, 'YYYYMMDDHH24MISS')
				, :szGUBUN
				, :szSAYUCD
				, :szOPENDAY
				);

		if (sqlca.sqlcode == 0)
			szSuccessCnt++;
		else {
			szErrorCnt++;
		}
		EXEC SQL AT TOBE COMMIT;
 	}
 	EXEC SQL AT ASIS close ASIS_CMD0028;

	Get_Sys_Date(szEndDate);
	Get_Sys_Time(szEndTime);

	fprintf(stdout, "TABLE : %-20s TOTAL : %06d   SUCCESS : %06d   ERROR : %06d [%s %s ~ %s %s] %d\n"
				  , pTABLENM, szTotalCnt, szSuccessCnt, szErrorCnt, szStartDate, szStartTime, szEndDate, szEndTime
				  , Get_RunSecond(szStartDate, szStartTime, szEndDate, szEndTime));

 	return (0);

}




/*---------------------------------------------------------------*/
/*	Function  : CMD0029_CONVERT                                  */
/*	Action    : CMD0029 CONVERT                                  */
/*	            파일대사결과관리                                 */
/*	Parameter : pTABLENM : 테이블명                              */
/*	Return    : 0 : 정상, 1 : 오류                               */
/*---------------------------------------------------------------*/
int 	CMD0029_CONVERT     ( char *pTABLENM
							)
{
char	szDIFFDT                   [8+1];
char    szSVRIP                  [200+1];
char    szSYSCD                    [3+1];
char    szDIRPATH                [300+1];
char    szRSRCNAME               [300+1];
char    szSVRCD                    [2+1];
char    szSVRNAME                 [50+1];
char    szDIFFRST                 [10+1];
int     szECAMSSIZE                     ;
char    szECAMSDATE               [14+1];
char    szECAMSMD5                [32+1];
int     szSVRSIZE                       ;
char    szSVRDATE                 [14+1];
char    szSVRMD5                  [32+1];
char    szDSNCD                    [5+1];
char    szRSTCOND                  [5+1];
char    szRUNDATE                 [14+1];
char    szCLOSEYN                  [1+1];
char    szOPENYN                   [1+1];
char    szVERYN                    [1+1];
char    szRSRCCD                   [5+1];
char    szVIEWYN                   [1+1];
char    szERRCLSDT                 [8+1];
int     szERRDAYCNT                     ;
char    szSAYU                  [2000+1];


	Get_Sys_Date(szStartDate);
	Get_Sys_Time(szStartTime);

	szTotalCnt   = 0;
	szSuccessCnt = 0;
	szErrorCnt   = 0;

	/*-----------------------------------------------------------*/
    /*	 AS-IS TABLE  READ                                       */
    /*-----------------------------------------------------------*/
	EXEC SQL AT ASIS
		DECLARE ASIS_CMD0029 CURSOR FOR
			SELECT  CD_DIFFDT
			      , CD_SVRIP
			      , CD_SYSCD
			      , CD_DIRPATH
			      , CD_RSRCNAME
			      , CD_SVRCD
			      , CD_SVRNAME
			      , CD_DIFFRST
			      , CD_ECAMSSIZE
			      , CD_ECAMSDATE
			      , CD_ECAMSMD5
			      , CD_SVRSIZE
			      , CD_SVRDATE
			      , CD_SVRMD5
			      , CD_DSNCD
			      , CD_RSTCOND
			      , TO_CHAR(CD_RUNDATE, 'YYYYMMDDHH24MISS')
			      , CD_CLOSEYN
			      , CD_OPENYN
			      , CD_VERYN
			      , CD_RSRCCD
			      , CD_VIEWYN
			      , CD_ERRCLSDT
			      , CD_ERRDAYCNT
			      , CD_SAYU
   			  FROM  COVM_IMS.CMD0029
   			 WHERE  CD_SYSCD = DECODE(:szINSysCD, 'ALL', CD_SYSCD, :szINSysCD);

	EXEC SQL AT ASIS OPEN ASIS_CMD0029;

	if (sqlca.sqlcode != 0) {
		fprintf(stderr, "ASIS_%s SQL ERROR [%d] [%s]\n", pTABLENM, sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
		exit (1);
	}

    while (1) {
		EXEC SQL AT ASIS FETCH ASIS_CMD0029
			INTO  :szDIFFDT
			    , :szSVRIP
			    , :szSYSCD
			    , :szDIRPATH
			    , :szRSRCNAME
			    , :szSVRCD
			    , :szSVRNAME
			    , :szDIFFRST
			    , :szECAMSSIZE
			    , :szECAMSDATE
			    , :szECAMSMD5
			    , :szSVRSIZE
			    , :szSVRDATE
			    , :szSVRMD5
			    , :szDSNCD
			    , :szRSTCOND
			    , :szRUNDATE
			    , :szCLOSEYN
			    , :szOPENYN
			    , :szVERYN
			    , :szRSRCCD
			    , :szVIEWYN
			    , :szERRCLSDT
			    , :szERRDAYCNT
			    , :szSAYU      ;


		if (sqlca.sqlcode == 1403) break;

		if (sqlca.sqlcode != 0 && sqlca.sqlcode != -1405) {
			fprintf(stderr, "%d %s\n", sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
			szErrorCnt++;
			break;
		}

		sprintf(szDIFFDT   , "%s", trunc_char(szDIFFDT   ));
		sprintf(szSVRIP    , "%s", trunc_char(szSVRIP    ));
		sprintf(szSYSCD    , "%s", trunc_char(szSYSCD    ));
		sprintf(szDIRPATH  , "%s", trunc_char(szDIRPATH  ));
		sprintf(szRSRCNAME , "%s", trunc_char(szRSRCNAME ));
		sprintf(szSVRCD    , "%s", trunc_char(szSVRCD    ));
		sprintf(szSVRNAME  , "%s", trunc_char(szSVRNAME  ));
		sprintf(szDIFFRST  , "%s", trunc_char(szDIFFRST  ));
		sprintf(szECAMSDATE, "%s", trunc_char(szECAMSDATE));
		sprintf(szECAMSMD5 , "%s", trunc_char(szECAMSMD5 ));
		sprintf(szSVRDATE  , "%s", trunc_char(szSVRDATE  ));
		sprintf(szSVRMD5   , "%s", trunc_char(szSVRMD5   ));
		sprintf(szDSNCD    , "%s", trunc_char(szDSNCD    ));
		sprintf(szRSTCOND  , "%s", trunc_char(szRSTCOND  ));
		sprintf(szRUNDATE  , "%s", trunc_char(szRUNDATE  ));
		sprintf(szCLOSEYN  , "%s", trunc_char(szCLOSEYN  ));
		sprintf(szOPENYN   , "%s", trunc_char(szOPENYN   ));
		sprintf(szVERYN    , "%s", trunc_char(szVERYN    ));
		sprintf(szRSRCCD   , "%s", trunc_char(szRSRCCD   ));
		sprintf(szVIEWYN   , "%s", trunc_char(szVIEWYN   ));
		sprintf(szERRCLSDT , "%s", trunc_char(szERRCLSDT ));
		sprintf(szSAYU     , "%s", trunc_char(szSAYU     ));

		szTotalCnt++;

		/*-------------------------------------------------------*/
	    /*	TO-BE TABLE INSERT                                   */
	    /*-------------------------------------------------------*/
		EXEC SQL AT TOBE
			INSERT INTO CMD0029
				( CD_DIFFDT
			    , CD_SVRIP
			    , CD_SYSCD
			    , CD_DIRPATH
			    , CD_RSRCNAME
			    , CD_SVRCD
			    , CD_SVRNAME
			    , CD_DIFFRST
			    , CD_ECAMSSIZE
			    , CD_ECAMSDATE
			    , CD_ECAMSMD5
			    , CD_SVRSIZE
			    , CD_SVRDATE
			    , CD_SVRMD5
			    , CD_DSNCD
			    , CD_RSTCOND
			    , CD_RUNDATE
			    , CD_CLOSEYN
			    , CD_OPENYN
			    , CD_VERYN
			    , CD_RSRCCD
			    , CD_VIEWYN
			    , CD_ERRCLSDT
			    , CD_ERRDAYCNT
			    , CD_SAYU
			    )
			VALUES
				( :szDIFFDT
			    , :szSVRIP
			    , LPAD(:szSYSCD, 5, '0')
			    , :szDIRPATH
			    , :szRSRCNAME
			    , :szSVRCD
			    , :szSVRNAME
			    , :szDIFFRST
			    , :szECAMSSIZE
			    , :szECAMSDATE
			    , :szECAMSMD5
			    , :szSVRSIZE
			    , :szSVRDATE
			    , :szSVRMD5
			    , LPAD(:szDSNCD, 7, '0')
			    , :szRSTCOND
			    , TO_DATE(:szRUNDATE, 'YYYYMMDDHH24MISS')
			    , :szCLOSEYN
			    , :szOPENYN
			    , :szVERYN
			    , :szRSRCCD
			    , :szVIEWYN
			    , :szERRCLSDT
			    , :szERRDAYCNT
			    , :szSAYU
				);

		if (sqlca.sqlcode == 0)
			szSuccessCnt++;
		else {
			szErrorCnt++;
		}
		EXEC SQL AT TOBE COMMIT;
 	}
 	EXEC SQL AT ASIS close ASIS_CMD0029;

	Get_Sys_Date(szEndDate);
	Get_Sys_Time(szEndTime);

	fprintf(stdout, "TABLE : %-20s TOTAL : %06d   SUCCESS : %06d   ERROR : %06d [%s %s ~ %s %s] %d\n"
				  , pTABLENM, szTotalCnt, szSuccessCnt, szErrorCnt, szStartDate, szStartTime, szEndDate, szEndTime
				  , Get_RunSecond(szStartDate, szStartTime, szEndDate, szEndTime));

 	return (0);

}

