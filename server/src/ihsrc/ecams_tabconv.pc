/*---------------------------------------------------------------*/
/*	Function  : CMM0074_CONVERT                                  */
/*	Action    : CMM0074 CONVERT                                  */
/*	            홈디렉토리관리정보                               */
/*	Parameter : pTABLENM : 테이블명                              */
/*	Return    : 0 : 정상, 1 : 오류                               */
/*---------------------------------------------------------------*/
int 	CMM0074_CONVERT     ( char *pTABLENM
							)
{
char	szSYSCD	                   [3+1];
char	szDIRPATH                [300+1];
char	szSVRIP                  [100+1];
char	szSVRCD                    [2+1];
char	szDSNCD                    [5+1];
char	szDIFFYN                   [1+1];


	Get_Sys_Date(szStartDate);
	Get_Sys_Time(szStartTime);

	szTotalCnt   = 0;
	szSuccessCnt = 0;
	szErrorCnt   = 0;


	/*-----------------------------------------------------------*/
    /*	 AS-IS TABLE  READ                                       */
    /*-----------------------------------------------------------*/
	EXEC SQL AT ASIS
		DECLARE ASIS_CMM0074 CURSOR FOR
			SELECT  CM_SYSCD
			      , CM_DIRPATH
			      , CM_SVRIP
			      , NVL(CM_SVRCD, '03')
			      , CM_DSNCD
			      , CM_DIFFYN
   			  FROM  COVM_IMS.CMM0074;

	EXEC SQL AT ASIS OPEN ASIS_CMM0074;

	if (sqlca.sqlcode != 0) {
		fprintf(stderr, "ASIS_%s SQL ERROR [%d] [%s]\n", pTABLENM, sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
		exit (1);
	}

    while (1) {
		EXEC SQL AT ASIS FETCH ASIS_CMM0074
			INTO  :szSYSCD
			    , :szDIRPATH
			    , :szSVRIP
			    , :szSVRCD
			    , :szDSNCD
			    , :szDIFFYN ;


		if (sqlca.sqlcode == 1403) break;

		szTotalCnt++;

		if (sqlca.sqlcode != 0 && sqlca.sqlcode != -1405) {
			fprintf(stderr, "%d %s\n", sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
			szErrorCnt++;
			break;
		}

		sprintf(szSYSCD	 , "%s", trunc_char(szSYSCD	 ));
		sprintf(szDIRPATH, "%s", trunc_char(szDIRPATH));
		sprintf(szSVRIP  , "%s", trunc_char(szSVRIP  ));
		sprintf(szSVRCD  , "%s", trunc_char(szSVRCD  ));
		sprintf(szDSNCD  , "%s", trunc_char(szDSNCD  ));
		sprintf(szDIFFYN , "%s", trunc_char(szDIFFYN ));

		/*-------------------------------------------------------*/
	    /*	TO-BE TABLE INSERT                                   */
	    /*-------------------------------------------------------*/
		EXEC SQL AT TOBE
			INSERT INTO CMM0074
				( CM_SYSCD
				, CM_DIRPATH
				, CM_SVRIP
				, CM_SVRCD
				, CM_DSNCD
				, CM_DIFFYN
				, CM_SEQNO
				)
			VALUES
				( LPAD(:szSYSCD, 5, '0')
				, :szDIRPATH
				, :szSVRIP
				, :szSVRCD
				, LPAD(:szDSNCD, 7, '0')
				, :szDIFFYN
				, CONV_SVRSEQ(LPAD(:szSYSCD, 5, '0'), :szSVRCD, :szSVRIP)
				);

		if (sqlca.sqlcode == 0)
			szSuccessCnt++;
		else {
			fprintf(stderr, "ERROR : %s %s %s %d\n", szSYSCD, szDSNCD, szDIRPATH, sqlca.sqlcode);
			szErrorCnt++;
		}
		EXEC SQL AT TOBE COMMIT;

 	}
 	EXEC SQL AT ASIS close ASIS_CMM0074;

	Get_Sys_Date(szEndDate);
	Get_Sys_Time(szEndTime);

	fprintf(stdout, "TABLE : %-20s TOTAL : %06d   SUCCESS : %06d   ERROR : %06d [%s %s ~ %s %s] %d\n"
				  , pTABLENM, szTotalCnt, szSuccessCnt, szErrorCnt, szStartDate, szStartTime, szEndDate, szEndTime
				  , Get_RunSecond(szStartDate, szStartTime, szEndDate, szEndTime));

	return (0);
}


