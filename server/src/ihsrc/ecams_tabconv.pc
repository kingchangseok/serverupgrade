	    /*-------------------------------------------------------*/
		EXEC SQL AT TOBE
			INSERT INTO CMM0072
				( CM_SYSCD
			    , CM_DSNCD
			    , CM_RSRCCD
				)
			VALUES
				( LPAD(:szSYSCD, 5, '0')
				, LPAD(:szDSNCD, 7, '0')
				, :szRSRCCD
				);

		if (sqlca.sqlcode == 0)
			szSuccessCnt++;
		else {
