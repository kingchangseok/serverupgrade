		}

		sprintf(szUSERID , "%s", trunc_char(szUSERID ));
		sprintf(szCHANGDT, "%s", trunc_char(szCHANGDT));
		sprintf(szPASSWD , "%s", trunc_char(szPASSWD ));


		/*-------------------------------------------------------*/
	    /*	TO-BE TABLE INSERT                                   */
