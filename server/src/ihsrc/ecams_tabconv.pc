int 	CMR0010_CONVERT     ( char *pTABLENM
							)
{
char	szGUBUN                    [2+1];
int 	szNO                            ;
char	szLASTDT                  [14+1];
char	szLASTID                  [10+1];


	Get_Sys_Date(szStartDate);
	Get_Sys_Time(szStartTime);

	szTotalCnt   = 0;
	szSuccessCnt = 0;
	szErrorCnt   = 0;


	EXEC SQL AT TOBE
		DELETE  CMR0010;

	/*-----------------------------------------------------------*/
    /*	 AS-IS TABLE  READ                                       */
    /*-----------------------------------------------------------*/
	EXEC SQL AT ASIS
		DECLARE ASIS_CMR0010 CURSOR FOR
			SELECT  CR_GUBUN
			      , NVL(CR_NO, 0)
			      , TO_CHAR(CR_LASTDT, 'YYYYMMDDHH24MISS')
			      , CR_LASTID
   			  FROM  COVM_IMS.CMR0010;

	EXEC SQL AT ASIS OPEN ASIS_CMR0010;

	if (sqlca.sqlcode != 0) {
