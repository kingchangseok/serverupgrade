/*---------------------------------------------------------------*/
/*	Function  : CMM0200_CONVERT                                  */
/*	Action    : CMM0200 CONVERT                                  */
/*	            게시판 관리                                      */
/*	Parameter : pTABLENM : 테이블명                              */
/*	Return    : 0 : 정상, 1 : 오류                               */
/*---------------------------------------------------------------*/
int 	CMM0200_CONVERT     ( char *pTABLENM
							)
{

char	szACPTNO                  [12+1];
char	szGBNCD                    [2+1];
char	szACPTDATE                [14+1];
char	szTITLE                  [100+1];
char	szEDITOR                  [10+1];
char	szCONTENTS              [2000+1];
char	szDEPTCD                  [10+1];
char	szPOPUP                    [1+1];
char	szSTDATE                   [8+1];
char	szEDDATE                   [8+1];


	Get_Sys_Date(szStartDate);
	Get_Sys_Time(szStartTime);

	szTotalCnt   = 0;
	szSuccessCnt = 0;
	szErrorCnt   = 0;


	/*-----------------------------------------------------------*/
    /*	 AS-IS TABLE  READ                                       */
    /*-----------------------------------------------------------*/
	EXEC SQL AT ASIS
		DECLARE ASIS_CMM0200 CURSOR FOR
			SELECT  CM_ACPTNO  
			      , CM_GBNCD   
			      , TO_CHAR(CM_ACPTDATE, 'YYYYMMDDHH24MISS')
			      , CM_TITLE   
			      , CM_EDITOR  
			      , CM_CONTENTS
			      , CM_DEPTCD  
			      , CM_POPUP   
			      , CM_STDATE  
			      , CM_EDDATE  
   			  FROM  COVM_IMS.CMM0200;

	EXEC SQL AT ASIS OPEN ASIS_CMM0200;

	if (sqlca.sqlcode != 0) {
		fprintf(stderr, "ASIS_%s SQL ERROR [%d] [%s]\n", pTABLENM, sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
		exit (1);
	}

    while (1) {
		EXEC SQL AT ASIS FETCH ASIS_CMM0200
			INTO  :szACPTNO  
			    , :szGBNCD   
			    , :szACPTDATE
			    , :szTITLE   
			    , :szEDITOR  
			    , :szCONTENTS
			    , :szDEPTCD  
			    , :szPOPUP   
			    , :szSTDATE  
			    , :szEDDATE  ;
;

		if (sqlca.sqlcode == 1403) break;

		szTotalCnt++;

		if (sqlca.sqlcode != 0 && sqlca.sqlcode != -1405) {
			fprintf(stderr, "%d %s\n", sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
			szErrorCnt++;
			break;
		}

		sprintf(szACPTNO  , "%s", trunc_char(szACPTNO  ));
		sprintf(szGBNCD   , "%s", trunc_char(szGBNCD   ));
		sprintf(szACPTDATE, "%s", trunc_char(szACPTDATE));
		sprintf(szTITLE   , "%s", trunc_char(szTITLE   ));
		sprintf(szEDITOR  , "%s", trunc_char(szEDITOR  ));
		sprintf(szCONTENTS, "%s", trunc_char(szCONTENTS));
		sprintf(szDEPTCD  , "%s", trunc_char(szDEPTCD  ));
		sprintf(szPOPUP   , "%s", trunc_char(szPOPUP   ));
		sprintf(szSTDATE  , "%s", trunc_char(szSTDATE  ));
		sprintf(szEDDATE  , "%s", trunc_char(szEDDATE  ));

		/*-------------------------------------------------------*/
	    /*	TO-BE TABLE INSERT                                   */
	    /*-------------------------------------------------------*/
		EXEC SQL AT TOBE
			INSERT INTO CMM0200
				( CM_ACPTNO
				, CM_GBNCD
				, CM_ACPTDATE
				, CM_TITLE
				, CM_EDITOR
				, CM_CONTENTS
				, CM_DEPTCD
				, CM_NOTIYN
				, CM_STDATE
				, CM_EDDATE
				)
			VALUES
				( :szACPTNO  
			    , :szGBNCD   
			    , TO_DATE(:szACPTDATE, 'YYYYMMDDHH24MISS')
			    , :szTITLE   
			    , :szEDITOR  
			    , :szCONTENTS
			    , :szDEPTCD  
			    , :szPOPUP   
			    , :szSTDATE  
			    , :szEDDATE 
				);

		if (sqlca.sqlcode == 0)
			szSuccessCnt++;
		else
			szErrorCnt++;

 	}
 	EXEC SQL AT ASIS close ASIS_CMM0200;

	Get_Sys_Date(szEndDate);
	Get_Sys_Time(szEndTime);

	fprintf(stdout, "TABLE : %-20s TOTAL : %06d   SUCCESS : %06d   ERROR : %06d [%s %s ~ %s %s] %d\n"
				  , pTABLENM, szTotalCnt, szSuccessCnt, szErrorCnt, szStartDate, szStartTime, szEndDate, szEndTime
				  , Get_RunSecond(szStartDate, szStartTime, szEndDate, szEndTime));

	return (0);

}


/*---------------------------------------------------------------*/
/*	Function  : CMM0210_CONVERT                                  */
/*	Action    : CMM0210 CONVERT                                  */
/*	            게시판답변                                       */
/*	Parameter : pTABLENM : 테이블명                              */
/*	Return    : 0 : 정상, 1 : 오류                               */
/*---------------------------------------------------------------*/
int 	CMM0210_CONVERT     ( char *pTABLENM
							)
{

char	szACPTNO                  [12+1];
char	szGBNCD                    [2+1];
char	szANSTIT                 [300+1];
char	szANSCONT               [2000+1];
char	szEDITOR                  [10+1];
char	szLASTDATE                [14+1];
char	szDEPTCD                  [10+1];


	Get_Sys_Date(szStartDate);
	Get_Sys_Time(szStartTime);

	szTotalCnt   = 0;
	szSuccessCnt = 0;
	szErrorCnt   = 0;


	/*-----------------------------------------------------------*/
    /*	 AS-IS TABLE  READ                                       */
    /*-----------------------------------------------------------*/
	EXEC SQL AT ASIS
		DECLARE ASIS_CMM0210 CURSOR FOR
			SELECT  CM_ACPTNO
			      , CM_GBNCD
			      , CM_ANSTIT
			      , CM_ANSCONT
			      , CM_EDITOR
			      , CM_LASTDATE
			      , CM_DEPTCD
   			  FROM  COVM_IMS.CMM0210;

	EXEC SQL AT ASIS OPEN ASIS_CMM0210;

	if (sqlca.sqlcode != 0) {
		fprintf(stderr, "ASIS_%s SQL ERROR [%d] [%s]\n", pTABLENM, sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
		exit (1);
	}

    while (1) {
		EXEC SQL AT ASIS FETCH ASIS_CMM0210
			INTO  :szACPTNO  
			    , :szGBNCD   
			    , :szANSTIT  
			    , :szANSCONT 
			    , :szEDITOR  
			    , :szLASTDATE
			    , :szDEPTCD  ;

		if (sqlca.sqlcode == 1403) break;

		szTotalCnt++;

		if (sqlca.sqlcode != 0 && sqlca.sqlcode != -1405) {
			fprintf(stderr, "%d %s\n", sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
			szErrorCnt++;
			break;
		}

		sprintf(szACPTNO  , "%s", trunc_char(szACPTNO  ));
		sprintf(szGBNCD   , "%s", trunc_char(szGBNCD   ));
		sprintf(szANSTIT  , "%s", trunc_char(szANSTIT  ));
		sprintf(szANSCONT , "%s", trunc_char(szANSCONT ));
		sprintf(szEDITOR  , "%s", trunc_char(szEDITOR  ));
		sprintf(szLASTDATE, "%s", trunc_char(szLASTDATE));
		sprintf(szDEPTCD  , "%s", trunc_char(szDEPTCD  ));

		/*-------------------------------------------------------*/
	    /*	TO-BE TABLE INSERT                                   */
	    /*-------------------------------------------------------*/
		EXEC SQL AT TOBE
			INSERT INTO CMM0210
				( CM_ACPTNO
			    , CM_GBNCD
			    , CM_ANSTIT
			    , CM_ANSCONT
			    , CM_EDITOR
			    , CM_LASTDATE
			    , CM_DEPTCD
				)
			VALUES
				( :szACPTNO  
			    , :szGBNCD   
			    , :szANSTIT  
			    , :szANSCONT 
			    , :szEDITOR  
			    , :szLASTDATE
			    , :szDEPTCD  
				);

		if (sqlca.sqlcode == 0)
			szSuccessCnt++;
		else
			szErrorCnt++;

 	}
 	EXEC SQL AT ASIS close ASIS_CMM0210;

	Get_Sys_Date(szEndDate);
	Get_Sys_Time(szEndTime);

	fprintf(stdout, "TABLE : %-20s TOTAL : %06d   SUCCESS : %06d   ERROR : %06d [%s %s ~ %s %s] %d\n"
				  , pTABLENM, szTotalCnt, szSuccessCnt, szErrorCnt, szStartDate, szStartTime, szEndDate, szEndTime
				  , Get_RunSecond(szStartDate, szStartTime, szEndDate, szEndTime));

	return (0);

}


