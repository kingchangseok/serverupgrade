			      , CM_RUNCD
			      , CM_SYSCD
			      , TO_CHAR(CM_LASTDT, 'YYYYMMDDHH24MISS')
			      , CM_EXISTYN
			      , CM_EXENAME
			      , CM_BASEDIRCD
			      , CM_EXECD
