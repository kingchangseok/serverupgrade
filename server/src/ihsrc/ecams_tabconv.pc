/*---------------------------------------------------------------*/
/*	Function  : CMM0044_CONVERT                                  */
/*	Action    : CMM0044 CONVERT                                  */
/*	            사용자별 업무권한정보                            */
/*	Parameter : pTABLENM : 테이블명                              */
/*	Return    : 0 : 정상, 1 : 오류                               */
/*---------------------------------------------------------------*/
int 	CMM0044_CONVERT     ( char *pTABLENM
							)
{

char	szUSERID                  [10+1];
char	szSYSCD                    [3+1];
char	szJOBCD                    [5+1];
char	szCREATDT                 [14+1];
char	szCLOSEDT                 [14+1];


	Get_Sys_Date(szStartDate);
	Get_Sys_Time(szStartTime);

	szTotalCnt   = 0;
	szSuccessCnt = 0;
	szErrorCnt   = 0;


	/*-----------------------------------------------------------*/
    /*	 AS-IS TABLE  READ                                       */
    /*-----------------------------------------------------------*/
	EXEC SQL AT ASIS
		DECLARE ASIS_CMM0044 CURSOR FOR
			SELECT  CM_USERID
			      , CM_SYSCD
			      , CM_JOBCD
			      , TO_CHAR(CM_CREATDT, 'YYYYMMDDHH24MISS')
			      , TO_CHAR(CM_CLOSEDT, 'YYYYMMDDHH24MISS')
   			  FROM  COVM_IMS.CMM0044;

	EXEC SQL AT ASIS OPEN ASIS_CMM0044;

	if (sqlca.sqlcode != 0) {
		fprintf(stderr, "ASIS_%s SQL ERROR [%d] [%s]\n", pTABLENM, sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
		exit (1);
	}

    while (1) {
		EXEC SQL AT ASIS FETCH ASIS_CMM0044
			INTO  :szUSERID
				, :szSYSCD
				, :szJOBCD
				, :szCREATDT
				, :szCLOSEDT;

		if (sqlca.sqlcode == 1403) break;

		szTotalCnt++;

		if (sqlca.sqlcode != 0 && sqlca.sqlcode != -1405) {
			fprintf(stderr, "%d %s\n", sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
			szErrorCnt++;
			break;
		}

		sprintf(szUSERID , "%s", trunc_char(szUSERID ));
		sprintf(szSYSCD  , "%s", trunc_char(szSYSCD  ));
		sprintf(szJOBCD  , "%s", trunc_char(szJOBCD  ));
		sprintf(szCREATDT, "%s", trunc_char(szCREATDT));
		sprintf(szCLOSEDT, "%s", trunc_char(szCLOSEDT));


		/*-------------------------------------------------------*/
	    /*	TO-BE TABLE INSERT                                   */
	    /*-------------------------------------------------------*/
		EXEC SQL AT TOBE
			INSERT INTO CMM0044
				( CM_USERID
			    , CM_SYSCD
			    , CM_JOBCD
			    , CM_CREATDT
			    , CM_CLOSEDT
				)
			VALUES
				( :szUSERID
				, LPAD(:szSYSCD, 5, '0')
				, :szJOBCD
				, TO_DATE(:szCREATDT, 'YYYYMMDDHH24MISS')
				, TO_DATE(:szCLOSEDT, 'YYYYMMDDHH24MISS')
				);

		if (sqlca.sqlcode == 0)
			szSuccessCnt++;
		else {
			fprintf(stderr, "%s %d\n", szUSERID, sqlca.sqlcode);
			szErrorCnt++;
		}

 	}
 	EXEC SQL AT ASIS close ASIS_CMM0044;

	Get_Sys_Date(szEndDate);
	Get_Sys_Time(szEndTime);

	fprintf(stdout, "TABLE : %-20s TOTAL : %06d   SUCCESS : %06d   ERROR : %06d [%s %s ~ %s %s] %d\n"
				  , pTABLENM, szTotalCnt, szSuccessCnt, szErrorCnt, szStartDate, szStartTime, szEndDate, szEndTime
				  , Get_RunSecond(szStartDate, szStartTime, szEndDate, szEndTime));

	return (0);

}


/*---------------------------------------------------------------*/
/*	Function  : CMM0045_CONVERT                                  */
/*	Action    : CMM0045 CONVERT                                  */
/*	            My결재선                                         */
/*	Parameter : pTABLENM : 테이블명                              */
/*	Return    : 0 : 정상, 1 : 오류                               */
/*---------------------------------------------------------------*/
int 	CMM0045_CONVERT     ( char *pTABLENM
							)
{

char	szUSERID                  [10+1];
char	szREQCD                    [2+1];
int 	szSIGNSTEP                      ;
char	szSIGNUSER                [10+1];
char	szCREATDT                 [14+1];
char 	szLASTDT                  [14+1];
char	szREQName                [100+1];


	Get_Sys_Date(szStartDate);
	Get_Sys_Time(szStartTime);

	szTotalCnt   = 0;
	szSuccessCnt = 0;
	szErrorCnt   = 0;


	/*-----------------------------------------------------------*/
    /*	 AS-IS TABLE  READ                                       */
    /*-----------------------------------------------------------*/
	EXEC SQL AT ASIS
		DECLARE ASIS_CMM0045 CURSOR FOR
			SELECT  A.CM_USERID
			      , A.CM_REQCD
			      , A.CM_SIGNSTEP
			      , A.CM_SIGNUSER
			      , TO_CHAR(A.CM_CREATDT, 'YYYYMMDDHH24MISS')
			      , TO_CHAR(A.CM_LASTDT , 'YYYYMMDDHH24MISS')
			      , B.CM_CODENAME
   			  FROM  COVM_IMS.CMM0045 A
   			      , COVM_IMS.CMM0020 B
   			 WHERE  B.CM_MACODE = 'REQUEST'
   			   AND  B.CM_MICODE = A.CM_REQCD;  /*%%%%%% REQCD  변환 필요 */
   			   

	EXEC SQL AT ASIS OPEN ASIS_CMM0045;

	if (sqlca.sqlcode != 0) {
		fprintf(stderr, "ASIS_%s SQL ERROR [%d] [%s]\n", pTABLENM, sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
		exit (1);
	}

    while (1) {
		EXEC SQL AT ASIS FETCH ASIS_CMM0045
			INTO  :szUSERID
				, :szREQCD
				, :szSIGNSTEP
				, :szSIGNUSER
				, :szCREATDT
				, :szLASTDT  
				, :szREQName;

		if (sqlca.sqlcode == 1403) break;

		szTotalCnt++;

		if (sqlca.sqlcode != 0 && sqlca.sqlcode != -1405) {
			fprintf(stderr, "%d %s\n", sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
			szErrorCnt++;
			break;
		}

		sprintf(szUSERID  , "%s", trunc_char(szUSERID  ));
		sprintf(szREQCD   , "%s", trunc_char(szREQCD   ));
		sprintf(szSIGNUSER, "%s", trunc_char(szSIGNUSER));
		sprintf(szCREATDT , "%s", trunc_char(szCREATDT ));
		sprintf(szLASTDT  , "%s", trunc_char(szLASTDT  ));
		sprintf(szREQName , "%s", trunc_char(szREQName ));


		/*-------------------------------------------------------*/
	    /*	TO-BE TABLE INSERT                                   */
	    /*-------------------------------------------------------*/
		EXEC SQL AT TOBE
			INSERT INTO CMM0045
				( CM_USERID
			    , CM_SIGNUSER
			    , CM_LASTDT
			    , CM_SIGNNM
			    , CM_SIGNSTEP
			    , CM_SIGNCD
				)
			VALUES
				( :szUSERID
				, :szSIGNUSER
				, TO_DATE(:szLASTDT , 'YYYYMMDDHH24MISS')
				, :szREQName
				, :szSIGNSTEP
				, NULL
				);

		if (sqlca.sqlcode == 0)
			szSuccessCnt++;
		else {
			fprintf(stderr, "%s %s %s %d %s %s %d\n"
						  , szUSERID, szSIGNUSER, szLASTDT, szSIGNSTEP, szREQCD, szREQName, sqlca.sqlcode);
			szErrorCnt++;
		}

 	}
 	EXEC SQL AT ASIS close ASIS_CMM0045;

	Get_Sys_Date(szEndDate);
	Get_Sys_Time(szEndTime);

	fprintf(stdout, "TABLE : %-20s TOTAL : %06d   SUCCESS : %06d   ERROR : %06d [%s %s ~ %s %s] %d\n"
				  , pTABLENM, szTotalCnt, szSuccessCnt, szErrorCnt, szStartDate, szStartTime, szEndDate, szEndTime
				  , Get_RunSecond(szStartDate, szStartTime, szEndDate, szEndTime));

	return (0);

}


