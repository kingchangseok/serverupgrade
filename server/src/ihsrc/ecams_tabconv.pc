/*---------------------------------------------------------------*/
/*	Function  : CMM0038_CONVERT                                  */
/*	Action    : CMM0038 CONVERT                                  */
/*	            시스템상세자원매칭                               */
/*	Parameter : pTABLENM : 테이블명                              */
/*	Return    : 0 : 정상, 1 : 오류                               */
/*---------------------------------------------------------------*/
int 	CMM0038_CONVERT     ( char *pTABLENM
							)
{
char	szSYSCD                    [3+1];
char	szSVRCD                    [2+1];
char	szSVRIP                   [20+1];
char	szRSRCCD                   [2+1];
char	szJOBCD                    [5+1];
int 	szPORTNO                        ;
char	szConvSVRCD                [2+1];
int 	szConvSVRSEQ                    ;
char	szVOLPATH               [1024+1];


	Get_Sys_Date(szStartDate);
	Get_Sys_Time(szStartTime);

	szTotalCnt   = 0;
	szSuccessCnt = 0;
	szErrorCnt   = 0;


	/*-----------------------------------------------------------*/
    /*	 AS-IS TABLE  READ                                       */
    /*-----------------------------------------------------------*/
	EXEC SQL AT ASIS
		DECLARE ASIS_CMM0038 CURSOR FOR
			SELECT  CM_SYSCD
			      , CM_SVRCD
			      , CM_SVRIP
			      , CM_RSRCCD
			      , CM_JOBCD
   			  FROM  COVM_IMS.CMM0038;

	EXEC SQL AT ASIS OPEN ASIS_CMM0038;

	if (sqlca.sqlcode != 0) {
		fprintf(stderr, "ASIS_%s SQL ERROR [%d] [%s]\n", pTABLENM, sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
		exit (1);
	}

    while (1) {
		EXEC SQL AT ASIS FETCH ASIS_CMM0038
			INTO  :szSYSCD
				, :szSVRCD
				, :szSVRIP
				, :szRSRCCD
				, :szJOBCD;

		if (sqlca.sqlcode == 1403) break;

		szTotalCnt++;

		if (sqlca.sqlcode != 0 && sqlca.sqlcode != -1405) {
			fprintf(stderr, "%d %s\n", sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
			szErrorCnt++;
			break;
		}

		sprintf(szSYSCD , "%s", trunc_char(szSYSCD ));
		sprintf(szSVRCD , "%s", trunc_char(szSVRCD ));
		sprintf(szSVRIP , "%s", trunc_char(szSVRIP ));
		sprintf(szRSRCCD, "%s", trunc_char(szRSRCCD));
		sprintf(szJOBCD , "%s", trunc_char(szJOBCD ));

		if (CONVERT_SERVERCD(szSVRCD, szConvSVRCD) != 0) {
			memset(szConvSVRCD, 0x00, sizeof(szConvSVRCD));
		}

		if (SVRSEQ_CHECK(szSYSCD, szConvSVRCD, szSVRIP, szPORTNO, &szConvSVRSEQ, szVOLPATH) != 0) {
			szConvSVRSEQ = 0;
		}


		/*-------------------------------------------------------*/
	    /*	TO-BE TABLE INSERT                                   */
	    /*-------------------------------------------------------*/
		EXEC SQL AT TOBE
			INSERT INTO CMM0038
				( CM_SYSCD
				, CM_SVRCD
				, CM_SEQNO
				, CM_RSRCCD
				, CM_JOBCD
				, CM_PORTNO
				, CM_VOLPATH
				, CM_TIME
				)
			VALUES
				( LPAD(:szSYSCD, 5, '0')
				, :szConvSVRCD
				, :szConvSVRSEQ
				, :szRSRCCD
				, :szJOBCD
				, NULL
				, :szVOLPATH
				, '0000'
				);

		if (sqlca.sqlcode == 0)
			szSuccessCnt++;
		else {
			fprintf(stderr, "%s %s %d %s %d %s\n", szSYSCD, szConvSVRCD, szConvSVRSEQ, szRSRCCD, sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
			szErrorCnt++;
		}

 	}
 	EXEC SQL AT ASIS close ASIS_CMM0038;

	Get_Sys_Date(szEndDate);
	Get_Sys_Time(szEndTime);

	fprintf(stdout, "TABLE : %-20s TOTAL : %06d   SUCCESS : %06d   ERROR : %06d [%s %s ~ %s %s] %d\n"
				  , pTABLENM, szTotalCnt, szSuccessCnt, szErrorCnt, szStartDate, szStartTime, szEndDate, szEndTime
				  , Get_RunSecond(szStartDate, szStartTime, szEndDate, szEndTime));

	return (0);

}


