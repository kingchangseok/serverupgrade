/*---------------------------------------------------------------*/
/*	Function  : CMM0036_CONVERT                                  */
/*	Action    : CMM0036 CONVERT                                  */
/*	            시스템자원매칭                                   */
/*	Parameter : pTABLENM : 테이블명                              */
/*	Return    : 0 : 정상, 1 : 오류                               */
/*---------------------------------------------------------------*/
int 	CMM0036_CONVERT     ( char *pTABLENM
							)
{
char	szSYSCD                    [3+1];
char	szRSRCCD                   [2+1];
int 	szPRCSTEP                       ;
int 	szSTEPSTA                       ;
char	szINFO                    [50+1];
char	szCREATDT                 [14+1];
char	szLASTDT                  [14+1];
char	szCLOSEDT                 [14+1];
char	szEDITOR                  [10+1];
char	szBASEDIR                 [20+1];
char	szTIME                     [4+1];
char	szEXENAME                [100+1];
char	szRstINFO                [100+1];



	Get_Sys_Date(szStartDate);
	Get_Sys_Time(szStartTime);

	szTotalCnt   = 0;
	szSuccessCnt = 0;
	szErrorCnt   = 0;

	/*-----------------------------------------------------------*/
    /*	 AS-IS TABLE  READ                                       */
    /*-----------------------------------------------------------*/
	EXEC SQL AT ASIS
		DECLARE ASIS_CMM0036 CURSOR FOR
			SELECT  CM_SYSCD
			      , CM_RSRCCD
			      , CM_PRCSTEP
			      , CM_STEPSTA
			      , CM_INFO
			      , TO_CHAR(CM_CREATDT, 'YYYYMMDDHH24MISS')
			      , TO_CHAR(CM_LASTDT , 'YYYYMMDDHH24MISS')
			      , TO_CHAR(CM_CLOSEDT, 'YYYYMMDDHH24MISS')
			      , CM_EDITOR
			      , CM_BASEDIR
			      , CM_TIME
   			  FROM  COVM_IMS.CMM0036;

	EXEC SQL AT ASIS OPEN ASIS_CMM0036;

	if (sqlca.sqlcode != 0) {
		fprintf(stderr, "ASIS_%s SQL ERROR [%d] [%s]\n", pTABLENM, sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
		exit (1);
	}

    while (1) {
		EXEC SQL AT ASIS FETCH ASIS_CMM0036
			INTO  :szSYSCD  
				, :szRSRCCD 
				, :szPRCSTEP
				, :szSTEPSTA
				, :szINFO   
				, :szCREATDT
				, :szLASTDT 
				, :szCLOSEDT
				, :szEDITOR 
				, :szBASEDIR
				, :szTIME   ;

		if (sqlca.sqlcode == 1403) break;

		szTotalCnt++;

		if (sqlca.sqlcode != 0 && sqlca.sqlcode != -1405) {
			fprintf(stderr, "%d %s\n", sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
			szErrorCnt++;
			break;
		}

		sprintf(szSYSCD   , "%s", trunc_char(szSYSCD   ));
		sprintf(szRSRCCD  , "%s", trunc_char(szRSRCCD  ));
		sprintf(szINFO    , "%s", trunc_char(szINFO    ));
		sprintf(szCREATDT , "%s", trunc_char(szCREATDT ));
		sprintf(szLASTDT  , "%s", trunc_char(szLASTDT  ));
		sprintf(szCLOSEDT , "%s", trunc_char(szCLOSEDT ));
		sprintf(szEDITOR  , "%s", trunc_char(szEDITOR  ));
		sprintf(szBASEDIR , "%s", trunc_char(szBASEDIR ));
		sprintf(szTIME    , "%s", trunc_char(szTIME    ));

		EXEC SQL AT TOBE
			SELECT  CM_EXENAME
			  INTO  :szEXENAME
			  FROM  COVM_IMS.CMM0032 A
			      , COVM_IMS.CMM0023 B
			 WHERE  A.CM_SYSCD = :szSYSCD
			   AND  A.CM_RSRCCD = :szRSRCCD
			   AND  A.CM_LANGCD = B.CM_LANGCD;
			   
		if (sqlca.sqlcode != 0)
			memset(szEXENAME, 0x00, sizeof(szEXENAME));
			
		sprintf(szEXENAME, "%s", trunc_char(szEXENAME));
		
					   
		memset(szRstINFO, 0x00, sizeof(szRstINFO));
		CONVERT_CMM0036_INFO(szINFO, szRstINFO);

		/*-------------------------------------------------------*/
	    /*	TO-BE TABLE INSERT                                   */
	    /*-------------------------------------------------------*/
		EXEC SQL AT TOBE
			INSERT INTO CMM0036
				( CM_SYSCD
				, CM_RSRCCD
				, CM_PRCSTEP
				, CM_STEPSTA
				, CM_INFO
				, CM_CREATDT
				, CM_LASTDT
				, CM_CLOSEDT
				, CM_EDITOR
				, CM_BASEDIR
				, CM_TIME
				, CM_VERCNT
				, CM_EXENAME
				)
			VALUES
				( LPAD(:szSYSCD, 5, '0')
				, :szRSRCCD
				, :szPRCSTEP
				, :szSTEPSTA
				, :szRstINFO
				, TO_DATE(:szCREATDT, 'YYYYMMDDHH24MISS')
				, TO_DATE(:szLASTDT , 'YYYYMMDDHH24MISS')
				, TO_DATE(:szCLOSEDT, 'YYYYMMDDHH24MISS')
				, :szEDITOR
				, :szBASEDIR
				, :szTIME
				, 9999
				, :szEXENAME 
				);

		if (sqlca.sqlcode == 0)
			szSuccessCnt++;
		else {
			fprintf(stderr, "%s %s %s %d %s\n", szSYSCD, szRSRCCD, szRstINFO, sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
			szErrorCnt++;
		}

 	}
 	EXEC SQL AT ASIS close ASIS_CMM0036;

	Get_Sys_Date(szEndDate);
	Get_Sys_Time(szEndTime);

	fprintf(stdout, "TABLE : %-20s TOTAL : %06d   SUCCESS : %06d   ERROR : %06d [%s %s ~ %s %s] %d\n"
				  , pTABLENM, szTotalCnt, szSuccessCnt, szErrorCnt, szStartDate, szStartTime, szEndDate, szEndTime
				  , Get_RunSecond(szStartDate, szStartTime, szEndDate, szEndTime));

	return (0);

}


