/*****************************************************************/
/*                                                               */
/*        형상관리 테이블 CONVERSION 처리 M A I N                */
/*                                                               */
/*****************************************************************/
int		main (int argc, char **argv, char** envp)
{
char	szTABLENM                  [256];
char	szCMD                      [256];
int 	retval                          ;


    if (argc != 3) {
        fprintf (stderr, "Usage : %s <테이블명> <시스템> \n", argv[0]);
        exit (1);
	}

	sprintf(szTABLENM, "%s", argv[1]);
	NotUseDataTruncate (szTABLENM, 0x20);
	sprintf(szTABLENM, "%s", upper_char(szTABLENM));

	memset(szINSysCD, 0x00, sizeof(szINSysCD));
	sprintf(szINSysCD, "%s", argv[2]);

	gEnvp = envp;				         /*### gEnvp = 환경변수  */

	/*-----------------------------------------------------------*/
    /*   Signal Define			                                 */
    /*-----------------------------------------------------------*/
    DefineSignal ();

 	/*-----------------------------------------------------------*/
    /*	 ASIS  DB Server  Connect                                */
    /*-----------------------------------------------------------*/
	if (CONVDB_CONNECTING() != 0) {
		fprintf(stderr, "DB CONNECTING ERROR \n");
		exit (1);
	}

	/*-----------------------------------------------------------*/
    /*	 테이블별 전환 Function Call                             */
    /*-----------------------------------------------------------*/
	Process_TABCONV		(szTABLENM);

	EXEC SQL AT ASIS ROLLBACK WORK RELEASE;
	EXEC SQL AT TOBE COMMIT   WORK RELEASE;

	exit(0);
}


