	return (1);

}


/*---------------------------------------------------------------*/
/*	Function  : CMM0023_CONVERT                                  */
/*	Action    : CMM0023 CONVERT                                  */
/*	            언어정보                                         */
/*	Parameter : pTABLENM : 테이블명                              */
/*	Return    : 0 : 정상, 1 : 오류                               */
/*---------------------------------------------------------------*/
int 	CMM0023_CONVERT     ( char *pTABLENM
							)
{
char	szLANGCD                   [2+1];
char	szEXENAME                [100+1];



	Get_Sys_Date(szStartDate);
	Get_Sys_Time(szStartTime);

	szTotalCnt   = 0;
	szSuccessCnt = 0;
	szErrorCnt   = 0;

	/*-----------------------------------------------------------*/
    /*	 AS-IS TABLE  READ                                       */
    /*-----------------------------------------------------------*/
	EXEC SQL AT ASIS
		DECLARE ASIS_CMM0023 CURSOR FOR
			SELECT  CM_LANGCD
			      , CM_EXENAME
   			  FROM  COVM_IMS.CMM0023;

	EXEC SQL AT ASIS OPEN ASIS_CMM0023;

	if (sqlca.sqlcode != 0) {
		fprintf(stderr, "ASIS_%s SQL ERROR [%d] [%s]\n", pTABLENM, sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
		exit (1);
	}

    while (1) {
		EXEC SQL AT ASIS FETCH ASIS_CMM0023
			INTO  :szLANGCD
				, :szEXENAME;

		if (sqlca.sqlcode == 1403) break;

		if (sqlca.sqlcode != 0 && sqlca.sqlcode != -1405) {
			fprintf(stderr, "%d %s\n", sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
			szErrorCnt++;
			break;
		}

		sprintf(szLANGCD , "%s", trunc_char(szLANGCD ));
		sprintf(szEXENAME, "%s", trunc_char(szEXENAME));

		szTotalCnt++;

		/*-------------------------------------------------------*/
	    /*	TO-BE TABLE INSERT                                   */
	    /*-------------------------------------------------------*/
		EXEC SQL AT TOBE
			INSERT INTO CMM0023
				( CM_LANGCD
				, CM_EXENAME
				, CM_EXENO
				)
			VALUES
				( :szLANGCD
				, :szEXENAME
				, NULL
				);

		if (sqlca.sqlcode == 0)
			szSuccessCnt++;
		else {
			fprintf(stderr, "%s %s %d\n", szLANGCD, szEXENAME, sqlca.sqlcode);
			szErrorCnt++;
		}

 	}
 	EXEC SQL AT ASIS close ASIS_CMM0023;

	Get_Sys_Date(szEndDate);
	Get_Sys_Time(szEndTime);

	fprintf(stdout, "TABLE : %-20s TOTAL : %06d   SUCCESS : %06d   ERROR : %06d [%s %s ~ %s %s] %d\n"
				  , pTABLENM, szTotalCnt, szSuccessCnt, szErrorCnt, szStartDate, szStartTime, szEndDate, szEndTime
				  , Get_RunSecond(szStartDate, szStartTime, szEndDate, szEndTime));

 	return (0);
 	
}



/*---------------------------------------------------------------*/
/*	Function  : CMM0030_CONVERT                                  */
/*	Action    : CMM0030 CONVERT                                  */
/*	            시스템정보                                       */
/*	Parameter : pTABLENM : 테이블명                              */
/*	Return    : 0 : 정상, 1 : 오류                               */
/*---------------------------------------------------------------*/
int 	CMM0030_CONVERT		( char *pTABLENM
							)
{
char	szSYSCD	                   [3+1];
char	szSYSMSG                  [30+1];
char	szSYSGB	                   [1+1];
char	szDIRBASE	               [2+1];
char	szCOMSTTIME	               [4+1];
char	szCOMEDTIME	               [4+1];
char	szBATTIME1	               [4+1];
char	szBATTIME2	               [4+1];
char	szCREATDT	              [14+1];
char	szLASTUPDT	              [14+1];
char	szCLOSEDT	              [14+1];
char	szONLINE	               [1+1];
char	szSYSFC1	               [5+1];
char	szSYSFC2	               [5+1];
char	szSRCDSN	              [20+1];
char	szPROCNM	              [20+1];
char    szSRCNM                   [20+1];
char    szADMIN                   [20+1];
char    szTESTYN                   [1+1];
char    szEXEYN                    [1+1];
char    szEFFECTYN                 [1+1];
char    szSRCVIEW                  [1+1];
char    szCHKDOC1                  [1+1];
char    szCHKDOC2                  [1+1];
char    szORGTESTYN                [1+1];
int 	szReqCnt                        ;
char	szSYSINFO                 [20+1];


	Get_Sys_Date(szStartDate);
	Get_Sys_Time(szStartTime);

	szTotalCnt   = 0;
	szSuccessCnt = 0;
	szErrorCnt   = 0;

	/*-----------------------------------------------------------*/
    /*	 AS-IS TABLE  READ                                       */
    /*-----------------------------------------------------------*/
	EXEC SQL AT ASIS
		DECLARE ASIS_CMM0030 CURSOR FOR
			SELECT  CM_SYSCD
			      , CM_SYSMSG
			      , CM_SYSGB
			      , NVL(CM_DIRBASE, '01')
			      , CM_COMSTTIME
			      , CM_COMEDTIME
			      , CM_BATTIME1
			      , CM_BATTIME2
			      , TO_CHAR(CM_CREATDT , 'YYYYMMDD')
			      , TO_CHAR(CM_LASTUPDT, 'YYYYMMDD')
			      , TO_CHAR(CM_CLOSEDT , 'YYYYMMDD')
			      , CM_ONLINE
			      , CM_SYSFC1
			      , CM_SYSFC2
			      , CM_SRCDSN
			      , CM_PROCNM
			      , CM_SRCNM
			      , CM_ADMIN
   			  FROM  COVM_IMS.CMM0030
   			 WHERE  CM_SYSCD = DECODE(:szINSysCD, 'ALL', CM_SYSCD, :szINSysCD);

	EXEC SQL AT ASIS OPEN ASIS_CMM0030;

	if (sqlca.sqlcode != 0) {
		fprintf(stderr, "ASIS_%s SQL ERROR [%d] [%s]\n", pTABLENM, sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
		exit (1);
	}

	EXEC SQL
		SELECT  NVL(CM_ACPTCOUNT, 0)
		  INTO  :szReqCnt
		  FROM  CMM0010
		 WHERE  CM_STNO = 'ECAMS';
		 
	if (sqlca.sqlcode != 0)
		szReqCnt = 100;
		
    while (1) {
		EXEC SQL AT ASIS FETCH ASIS_CMM0030
			INTO  :szSYSCD
				, :szSYSMSG
				, :szSYSGB
				, :szDIRBASE
				, :szCOMSTTIME
				, :szCOMEDTIME
				, :szBATTIME1
				, :szBATTIME2
				, :szCREATDT
				, :szLASTUPDT
				, :szCLOSEDT
				, :szONLINE
				, :szSYSFC1
				, :szSYSFC2
				, :szSRCDSN
				, :szPROCNM
				, :szSRCNM
				, :szADMIN;

		if (sqlca.sqlcode == 1403) break;

		if (sqlca.sqlcode != 0 && sqlca.sqlcode != -1405) {
			fprintf(stderr, "%d %s\n", sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
			szErrorCnt++;
			break;
		}

		sprintf(szSYSCD    , "%s", trunc_char(szSYSCD    ));
		sprintf(szSYSMSG   , "%s", trunc_char(szSYSMSG   ));
		sprintf(szSYSGB    , "%s", trunc_char(szSYSGB    ));
		sprintf(szDIRBASE  , "%s", trunc_char(szDIRBASE  ));
		sprintf(szCOMSTTIME, "%s", trunc_char(szCOMSTTIME));
		sprintf(szCOMEDTIME, "%s", trunc_char(szCOMEDTIME));
		sprintf(szBATTIME1 , "%s", trunc_char(szBATTIME1 ));
		sprintf(szBATTIME2 , "%s", trunc_char(szBATTIME2 ));
		sprintf(szCREATDT  , "%s", trunc_char(szCREATDT  ));
		sprintf(szLASTUPDT , "%s", trunc_char(szLASTUPDT ));
		sprintf(szCLOSEDT  , "%s", trunc_char(szCLOSEDT  ));
		sprintf(szONLINE   , "%s", trunc_char(szONLINE   ));
		sprintf(szSYSFC1   , "%s", trunc_char(szSYSFC1   ));
		sprintf(szSYSFC2   , "%s", trunc_char(szSYSFC2   ));
		sprintf(szSRCDSN   , "%s", trunc_char(szSRCDSN   ));
		sprintf(szPROCNM   , "%s", trunc_char(szPROCNM   ));
		sprintf(szSRCNM    , "%s", trunc_char(szSRCNM    ));
		sprintf(szADMIN    , "%s", trunc_char(szADMIN    ));
		fprintf(stdout, "%s %s\n", szSYSCD, szSYSMSG);

		/*-------------------------------------------------------*/
	    /*	이행완료여부 체크                                    */
	    /*-------------------------------------------------------*/
		EXEC SQL AT TOBE
			SELECT  NVL(COUNT(*), 0)
			  INTO  :nCnt
			  FROM  CMM0030
			 WHERE  CM_SYSCD = LPAD(:szSYSCD, 5, '0');

		if (sqlca.sqlcode != 0)
			nCnt = 0;

		if (nCnt > 0) {
			printf("CMM0030 SKIP : [%s]\n", szSYSCD);
			continue;
		}

		szTotalCnt++;
		sprintf(szSYSINFO, "%s", "00000000000000000");
		
		if (strcmp(szSYSGB, "3") == 0)
			memset(&szSYSINFO[11], '1', 1);
			
		if (strcmp(szORGTESTYN, "Y") == 0)
			memset(&szSYSINFO[10], '1', 1);
						
		
		/*-------------------------------------------------------*/
	    /*	TO-BE TABLE INSERT                                   */
	    /*-------------------------------------------------------*/
		EXEC SQL AT TOBE
			INSERT INTO CMM0030
				( CM_SYSCD
			    , CM_SYSMSG
			    , CM_SYSGB
			    , CM_DIRBASE
			    , CM_CREATDT
			    , CM_LASTUPDT
			    , CM_CLOSEDT
			    , CM_ONLINE
			    , CM_SYSFC1
			    , CM_SYSFC2
			    , CM_SYSINFO
			    , CM_PRCCNT
			    , CM_STOPST
			    , CM_STOPED
			    , CM_SYSTIME
			    , CM_SCMOPEN
			    , CM_SYSOPEN
			    , CM_BASESYS
			    , CM_RELTIME
			    , CM_GRPCD
			    , CM_EXEMSG
			    , CM_REQCNT
			    , CM_SRCDSN
			    , CM_PROCNM
			    , CM_SRCNM)
			VALUES
				( LPAD(:szSYSCD, 5, '0')
				, :szSYSMSG
				, :szSYSGB
				, :szDIRBASE
				, TO_DATE(:szCREATDT , 'YYYYMMDDHH24MISS')
				, TO_DATE(:szLASTUPDT, 'YYYYMMDDHH24MISS')
				, TO_DATE(:szCLOSEDT , 'YYYYMMDDHH24MISS')
				, :szONLINE
				, :szSYSFC1
				, :szSYSFC2
				, :szSYSINFO
				, 20
				, NULL
				, NULL
				, NULL
				, SUBSTR(:szCREATDT, 1, 8)
				, SUBSTR(:szCREATDT, 1, 8)
				, NULL
				, NULL
				, NULL
				, NULL
				, :szReqCnt
				, :szSRCDSN
				, :szPROCNM
				, :szSRCNM);

		if (sqlca.sqlcode == 0)
			szSuccessCnt++;
		else {
			fprintf(stderr, "%s %s %d\n", szSYSCD, szSYSMSG, sqlca.sqlcode);
			szErrorCnt++;
		}

 	}
 	EXEC SQL AT ASIS close ASIS_CMM0030;

	Get_Sys_Date(szEndDate);
	Get_Sys_Time(szEndTime);

	fprintf(stdout, "TABLE : %-20s TOTAL : %06d   SUCCESS : %06d   ERROR : %06d [%s %s ~ %s %s] %d\n"
				  , pTABLENM, szTotalCnt, szSuccessCnt, szErrorCnt, szStartDate, szStartTime, szEndDate, szEndTime
				  , Get_RunSecond(szStartDate, szStartTime, szEndDate, szEndTime));

 	return (0);
}



/*---------------------------------------------------------------*/
/*	Function  : CMM0031_CONVERT                                  */
/*	Action    : CMM0031 CONVERT                                  */
/*	            시스템별상세정보                                 */
/*	Parameter : pTABLENM : 테이블명                              */
/*	Return    : 0 : 정상, 1 : 오류                               */
/*---------------------------------------------------------------*/
int 	CMM0031_CONVERT     ( char *pTABLENM
							)
{
char	szSYSCD                    [3+1];
char	szSVRCD                    [2+1];
char	szSVRIP                   [20+1];
char	szSVRUSR                  [20+1];
char	szSVRNAME                 [20+1];
char	szVOLPATH                [100+1];
char	szCREATDT                 [14+1];
char	szLASTUPDT                [14+1];
char	szEDITOR                  [10+1];
char	szCLOSEDT                 [14+1];
char	szAGENT                    [2+1];
int 	szPORTNO                        ;
char	szDBSTRING               [500+1];
char	szDBUSR                   [20+1];
char	szDBPASS                  [20+1];
char	szSYSOS                    [2+1];
char	szSVRUSE                  [10+1];
char	szDIR                    [100+1];
char	szCMPSVR                   [1+1];
char	szSaveSYSCD                [3+1];
char	szSaveSVRCD                [2+1];
int 	nSeqNo                          ;
char	szConvSVRCD                [2+1];
char	szAGTTIME                 [20+1];



	Get_Sys_Date(szStartDate);
	Get_Sys_Time(szStartTime);

	szTotalCnt   = 0;
	szSuccessCnt = 0;
	szErrorCnt   = 0;


	/*-----------------------------------------------------------*/
    /*	 AS-IS TABLE  READ                                       */
    /*-----------------------------------------------------------*/
	EXEC SQL AT ASIS
		DECLARE ASIS_CMM0031 CURSOR FOR
			SELECT  CM_SYSCD
			      , CM_SVRCD
			      , CM_SVRIP
			      , CM_SVRUSR
			      , CM_SVRNAME
			      , CM_VOLPATH
			      , TO_CHAR(CM_CREATDT , 'YYYYMMDDHH24MISS')
			      , TO_CHAR(CM_LASTUPDT, 'YYYYMMDDHH24MISS')
			      , CM_EDITOR
			      , TO_CHAR(CM_CLOSEDT , 'YYYYMMDDHH24MISS')
			      , CM_AGENT
			      , NVL(CM_PORTNO, 0)
			      , CM_DBSTRING
			      , CM_DBUSR
			      , CM_DBPASS
			      , CM_SYSOS
			      , CM_SVRUSE
			      , CM_DIR
			      , CM_CMPSVR
			      , CM_AGTTIME
   			  FROM  COVM_IMS.CMM0031
   			 WHERE  CM_SYSCD = DECODE(:szINSysCD, 'ALL', CM_SYSCD, :szINSysCD)
   			 ORDER  BY  CM_SYSCD, CM_SVRCD, CM_SVRIP;

	EXEC SQL AT ASIS OPEN ASIS_CMM0031;

	if (sqlca.sqlcode != 0) {
		fprintf(stderr, "ASIS_%s SQL ERROR [%d] [%s]\n", pTABLENM, sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
		exit (1);
	}

	memset(szSaveSYSCD, 0x00, sizeof(szSaveSYSCD));
	memset(szSaveSVRCD, 0x00, sizeof(szSaveSVRCD));
	nSeqNo = 0;


    while (1) {
		EXEC SQL AT ASIS FETCH ASIS_CMM0031
			INTO  :szSYSCD
			    , :szSVRCD
			    , :szSVRIP
			    , :szSVRUSR
			    , :szSVRNAME
			    , :szVOLPATH
			    , :szCREATDT
			    , :szLASTUPDT
			    , :szEDITOR
			    , :szCLOSEDT
			    , :szAGENT
			    , :szPORTNO
			    , :szDBSTRING
			    , :szDBUSR
			    , :szDBPASS
			    , :szSYSOS
			    , :szSVRUSE
			    , :szDIR
			    , :szCMPSVR
			    , :szAGTTIME;

		if (sqlca.sqlcode == 1403) break;

		szTotalCnt++;

		if (sqlca.sqlcode != 0 && sqlca.sqlcode != -1405) {
			fprintf(stderr, "%d %s\n", sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
			szErrorCnt++;
			break;
		}

		sprintf(szSYSCD   , "%s", trunc_char(szSYSCD   ));
		sprintf(szSVRCD   , "%s", trunc_char(szSVRCD   ));
		sprintf(szSVRIP   , "%s", trunc_char(szSVRIP   ));
		sprintf(szSVRUSR  , "%s", trunc_char(szSVRUSR  ));
		sprintf(szSVRNAME , "%s", trunc_char(szSVRNAME ));
		sprintf(szVOLPATH , "%s", trunc_char(szVOLPATH ));
		sprintf(szCREATDT , "%s", trunc_char(szCREATDT ));
		sprintf(szLASTUPDT, "%s", trunc_char(szLASTUPDT));
		sprintf(szEDITOR  , "%s", trunc_char(szEDITOR  ));
		sprintf(szCLOSEDT , "%s", trunc_char(szCLOSEDT ));
		sprintf(szAGENT   , "%s", trunc_char(szAGENT   ));
		sprintf(szDBSTRING, "%s", trunc_char(szDBSTRING));
		sprintf(szDBUSR   , "%s", trunc_char(szDBUSR   ));
		sprintf(szDBPASS  , "%s", trunc_char(szDBPASS  ));
		sprintf(szSYSOS   , "%s", trunc_char(szSYSOS   ));
		sprintf(szSVRUSE  , "%s", trunc_char(szSVRUSE  ));
		sprintf(szDIR     , "%s", trunc_char(szDIR     ));
		sprintf(szCMPSVR  , "%s", trunc_char(szCMPSVR  ));
		sprintf(szAGTTIME , "%s", trunc_char(szAGTTIME ));

		if (strcmp(szSaveSYSCD, szSYSCD) != 0) {
			sprintf(szSaveSYSCD, "%s", szSYSCD);
			memset(szSaveSVRCD, 0x00, sizeof(szSaveSVRCD));
			nSeqNo = 0;
		}

		if (strcmp(szSaveSVRCD, szSVRCD) != 0) {
			sprintf(szSaveSVRCD, "%s", szSVRCD);
			nSeqNo = 0;
		}

		if (CONVERT_SERVERCD(szSVRCD, szConvSVRCD) != 0) {
			memset(szConvSVRCD, 0x00, sizeof(szConvSVRCD));
		}

		nSeqNo++;

		/*-------------------------------------------------------*/
	    /*	TO-BE TABLE INSERT                                   */
	    /*-------------------------------------------------------*/
		EXEC SQL AT TOBE
			INSERT INTO CMM0031
				( CM_SYSCD
				, CM_SVRCD
				, CM_SEQNO
				, CM_SVRIP
				, CM_SVRUSR
				, CM_SVRNAME
				, CM_VOLPATH
				, CM_CREATDT
				, CM_LASTUPDT
				, CM_EDITOR
				, CM_CLOSEDT
				, CM_AGENT
				, CM_PORTNO
				, CM_DBSTRING
				, CM_DBUSR
				, CM_DBPASS
				, CM_SYSOS
				, CM_DIR
				, CM_CMPSVR
				, CM_PERMISSION
				, CM_SVRSTOP
				, CM_GRPID
				, CM_FTPUSR
				, CM_FTPPASS
				, CM_SVRUSE
				, CM_BUFFSIZE
				, CM_PRCSEQ
				, CM_GRPNO
				, CM_AGTTIME
				)
			VALUES
				( LPAD(:szSYSCD, 5, '0')
			    , :szConvSVRCD
			    , :nSeqNo
			    , :szSVRIP
			    , :szSVRUSR
			    , :szSVRNAME
			    , :szVOLPATH
			    , TO_DATE(:szCREATDT , 'YYYYMMDDHH24MISS')
			    , TO_DATE(:szLASTUPDT, 'YYYYMMDDHH24MISS')
			    , :szEDITOR
			    , TO_DATE(:szCLOSEDT , 'YYYYMMDDHH24MISS')
			    , :szAGENT
			    , :szPORTNO + 10000
			    , :szDBSTRING
			    , :szDBUSR
			    , :szDBPASS
			    , :szSYSOS
			    , :szDIR
			    , :szCMPSVR
			    , NULL
			    , 'N'
			    , NULL
			    , NULL
			    , NULL
			    , '0000000000'
			    , 1000000
			    , 1
			    , NULL
			    , :szAGTTIME
				);

		if (sqlca.sqlcode == 0)
			szSuccessCnt++;
		else {
			fprintf(stderr, "%s %s %s %d %s\n", szSYSCD, szSVRCD, szSVRIP, sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
			szErrorCnt++;
		}

 	}
 	EXEC SQL AT ASIS close ASIS_CMM0031;

	Get_Sys_Date(szEndDate);
	Get_Sys_Time(szEndTime);

	fprintf(stdout, "TABLE : %-20s TOTAL : %06d   SUCCESS : %06d   ERROR : %06d [%s %s ~ %s %s] %d\n"
				  , pTABLENM, szTotalCnt, szSuccessCnt, szErrorCnt, szStartDate, szStartTime, szEndDate, szEndTime
				  , Get_RunSecond(szStartDate, szStartTime, szEndDate, szEndTime));


	return (0);

}


/*---------------------------------------------------------------*/
/*	Function  : CMM0031_OS_CONVERT                               */
/*	Action    : CMM0031_OS CONVERT                               */
/*	            시스템별서버정보                                 */
/*	Parameter : pTABLENM : 테이블명                              */
/*	Return    : 0 : 정상, 1 : 오류                               */
/*---------------------------------------------------------------*/
int 	CMM0031_OS_CONVERT  ( char *pTABLENM
							)
{

	Get_Sys_Date(szStartDate);
	Get_Sys_Time(szStartTime);

	EXEC SQL AT TOBE
		INSERT INTO CMM0031_OS
			  ( CM_SVRIP
			  , CM_SVRUNIT
			  , CM_SVRNAME
			  , CM_SVROS
			  )
		SELECT  CM_SVRIP
		      , CM_SVRUNIT
		      , CM_SVRNAME
		      , CM_SVROS
		  FROM  COVM_IMS.CMM0031_OS;

	Get_Sys_Date(szEndDate);
	Get_Sys_Time(szEndTime);

	fprintf(stdout, "TABLE : %-20s TOTAL : %06d   SUCCESS : %06d   ERROR : %06d [%s %s ~ %s %s] %d\n"
				  , pTABLENM, szTotalCnt, szSuccessCnt, szErrorCnt, szStartDate, szStartTime, szEndDate, szEndTime
				  , Get_RunSecond(szStartDate, szStartTime, szEndDate, szEndTime));

	return (1);

}



/*---------------------------------------------------------------*/
/*	Function  : CMM0034_CONVERT                                  */
/*	Action    : CMM0034 CONVERT                                  */
/*	            시스템업무매칭                                   */
/*	Parameter : pTABLENM : 테이블명                              */
/*	Return    : 0 : 정상, 1 : 오류                               */
/*---------------------------------------------------------------*/
int 	CMM0034_CONVERT     ( char *pTABLENM
							)
{

char	szSYSCD                    [3+1];
char	szJOBCD                    [5+1];
char	szCREATDT                 [14+1];
char	szLASTDT                  [14+1];
char	szCLOSEDT                 [14+1];
char	szEDITOR                  [10+1];


	Get_Sys_Date(szStartDate);
	Get_Sys_Time(szStartTime);

	szTotalCnt   = 0;
	szSuccessCnt = 0;
	szErrorCnt   = 0;


	/*-----------------------------------------------------------*/
    /*	 AS-IS TABLE  READ                                       */
    /*-----------------------------------------------------------*/
	EXEC SQL AT ASIS
		DECLARE ASIS_CMM0034 CURSOR FOR
			SELECT  CM_SYSCD
			      , CM_JOBCD
			      , TO_CHAR(CM_CREATDT, 'YYYYMMDDHH24MISS')
			      , TO_CHAR(CM_LASTDT , 'YYYYMMDDHH24MISS')
			      , TO_CHAR(CM_CLOSEDT, 'YYYYMMDDHH24MISS')
			      , CM_EDITOR
   			  FROM  COVM_IMS.CMM0034
   			 WHERE  CM_SYSCD = DECODE(:szINSysCD, 'ALL', CM_SYSCD, LPAD(:szINSysCD, 5, '0'));

	EXEC SQL AT ASIS OPEN ASIS_CMM0034;

	if (sqlca.sqlcode != 0) {
		fprintf(stderr, "ASIS_%s SQL ERROR [%d] [%s]\n", pTABLENM, sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
		exit (1);
	}

    while (1) {
		EXEC SQL AT ASIS FETCH ASIS_CMM0034
			INTO  :szSYSCD
			    , :szJOBCD
			    , :szCREATDT
			    , :szLASTDT
			    , :szCLOSEDT
			    , :szEDITOR ;

		if (sqlca.sqlcode == 1403) break;

		szTotalCnt++;

		if (sqlca.sqlcode != 0 && sqlca.sqlcode != -1405) {
			fprintf(stderr, "%d %s\n", sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
			szErrorCnt++;
			break;
		}

		sprintf(szSYSCD  , "%s", trunc_char(szSYSCD  ));
		sprintf(szJOBCD  , "%s", trunc_char(szJOBCD  ));
		sprintf(szCREATDT, "%s", trunc_char(szCREATDT));
		sprintf(szLASTDT , "%s", trunc_char(szLASTDT ));
		sprintf(szCLOSEDT, "%s", trunc_char(szCLOSEDT));
		sprintf(szEDITOR , "%s", trunc_char(szEDITOR ));


		/*-------------------------------------------------------*/
	    /*	TO-BE TABLE INSERT                                   */
	    /*-------------------------------------------------------*/
		EXEC SQL AT TOBE
			INSERT INTO CMM0034
				( CM_SYSCD
				, CM_JOBCD
				, CM_CREATDT
				, CM_LASTDT
				, CM_CLOSEDT
				, CM_EDITOR
				)
			VALUES
				( LPAD(:szSYSCD, 5, '0')
			    , :szJOBCD
			    , TO_DATE(:szCREATDT, 'YYYYMMDDHH24MISS')
			    , TO_DATE(:szLASTDT , 'YYYYMMDDHH24MISS')
			    , TO_DATE(:szCLOSEDT, 'YYYYMMDDHH24MISS')
			    , :szEDITOR
				);

		if (sqlca.sqlcode == 0)
			szSuccessCnt++;
		else
			szErrorCnt++;

 	}
 	EXEC SQL AT ASIS close ASIS_CMM0034;

	Get_Sys_Date(szEndDate);
	Get_Sys_Time(szEndTime);

	fprintf(stdout, "TABLE : %-20s TOTAL : %06d   SUCCESS : %06d   ERROR : %06d [%s %s ~ %s %s] %d\n"
				  , pTABLENM, szTotalCnt, szSuccessCnt, szErrorCnt, szStartDate, szStartTime, szEndDate, szEndTime
				  , Get_RunSecond(szStartDate, szStartTime, szEndDate, szEndTime));

	return (0);

}


