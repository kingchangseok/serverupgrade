		sprintf(szSYSCD   , "%s", trunc_char(szSYSCD   ));
		sprintf(szRSRCCD  , "%s", trunc_char(szRSRCCD  ));
		sprintf(szSAMERSRC, "%s", trunc_char(szSAMERSRC));
		sprintf(szSAMENAME, "%s", trunc_char(szSAMENAME));
		sprintf(szBASENAME, "%s", trunc_char(szBASENAME));
		sprintf(szBASEDIR , "%s", trunc_char(szBASEDIR ));
		sprintf(szSAMEDIR , "%s", trunc_char(szSAMEDIR ));
