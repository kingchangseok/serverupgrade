/*---------------------------------------------------------------*/
/*	Function  : CONVDB_CONNECTING                                */
/*	Action    : DB_CONNECTING                                    */
/*	Parameter : NONE                                             */
/*	Return    : 0 : 정상, 1 : 오류                               */
/*---------------------------------------------------------------*/
int 	CONVDB_CONNECTING	(
							)
{
char	szASISConnStr              [256];
char	szTOBEConnStr              [256];


    memset(szASISConnStr , 0x00, sizeof(szASISConnStr));
    memset(szTOBEConnStr , 0x00, sizeof(szTOBEConnStr));

	/*-----------------------------------------------------------*/
    /*	 ASIS  DB Server  Connect                                */
    /*-----------------------------------------------------------*/
	EXEC SQL DECLARE ASIS DATABASE;
	sprintf(szASISConnStr, "%s/%s@%s", (char *)getenv("DBUSER"),(char *)getenv("DBPASS"),(char *)getenv("DBCONN"));
	EXEC SQL AT ASIS CONNECT :szASISConnStr;
	if (sqlca.sqlcode != 0) {
	    fprintf(stderr, "ASIS ConnectDB Failed exit !!! \n");
	    return (1);
	}

	/*-----------------------------------------------------------*/
    /*	 TOBE  DB Server  Connect                                */
    /*-----------------------------------------------------------*/
	EXEC SQL DECLARE TOBE DATABASE;

	sprintf(szTOBEConnStr, "%s/%s@%s", (char *)getenv("DBUSER"),(char *)getenv("DBPASS"),(char *)getenv("DBCONN"));
	EXEC SQL AT TOBE CONNECT :szTOBEConnStr;
	if (sqlca.sqlcode != 0) {
	    fprintf(stderr, "TOBE ConnectDB Failed exit !!! \n");
	    return (1);
	}
	return (0);

}



/*---------------------------------------------------------------*/
/*	Function  : CMD0010_CONVERT                                  */
/*	Action    : CMD0010_CONVERT                                  */
/*	            MAKE파일정보                                     */
/*	Parameter : pTABLENM : 테이블명                              */
/*	Return    : 0 : 정상, 1 : 오류                               */
/*---------------------------------------------------------------*/
int 	CMD0010_CONVERT     ( char *pTABLENM
							)
{
char	szSYSCD                    [3+1];
char	szDSNCD                    [5+1];
char	szEDITOR                  [10+1];
char	szLASTDT                   [8+1];
char	szMAKEDSN                  [5+1];
char	szMAKEFILE                [50+1];
char	szRSRCNAME               [100+1];
char	szITEMID              [dfItemID];
char	szMakeITEMID          [dfItemID];


	Get_Sys_Date(szStartDate);
	Get_Sys_Time(szStartTime);

	szTotalCnt   = 0;
	szSuccessCnt = 0;
	szErrorCnt   = 0;
	szItemIDErrCnt = 0;
	szItemIDErrCnt1 = 0;


	/*-----------------------------------------------------------*/
    /*	 AS-IS TABLE  READ                                       */
    /*-----------------------------------------------------------*/
	EXEC SQL AT ASIS
		DECLARE ASIS_CMD0010 CURSOR FOR
			SELECT  CD_SYSCD
			      , CD_DSNCD
			      , CD_EDITOR
			      , CD_LASTDT
			      , CD_RSRCNAME
			      , CD_MAKEDSN
			      , CD_MAKEFILE
   			  FROM  COVM_IMS.CMD0010
   			 WHERE  CD_SYSCD = DECODE(:szINSysCD, 'ALL', CD_SYSCD, :szINSysCD);

	EXEC SQL AT ASIS OPEN ASIS_CMD0010;

	if (sqlca.sqlcode != 0) {
		fprintf(stderr, "ASIS_%s SQL ERROR [%d] [%s]\n", pTABLENM, sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
		exit (1);
	}

    while (1) {
		EXEC SQL AT ASIS FETCH ASIS_CMD0010
			INTO  :szSYSCD
				, :szDSNCD
				, :szEDITOR
				, :szLASTDT
				, :szRSRCNAME
				, :szMAKEDSN
				, :szMAKEFILE;

		if (sqlca.sqlcode == 1403) break;

		szTotalCnt++;

		if (sqlca.sqlcode != 0 && sqlca.sqlcode != -1405) {
			fprintf(stderr, "%d %s\n", sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
			szErrorCnt++;
			break;
		}

		sprintf(szSYSCD   , "%s", trunc_char(szSYSCD   ));
		sprintf(szDSNCD   , "%s", trunc_char(szDSNCD   ));
		sprintf(szEDITOR  , "%s", trunc_char(szEDITOR  ));
		sprintf(szLASTDT  , "%s", trunc_char(szLASTDT  ));
		sprintf(szRSRCNAME, "%s", trunc_char(szRSRCNAME));
		sprintf(szMAKEDSN , "%s", trunc_char(szMAKEDSN ));
		sprintf(szMAKEFILE, "%s", trunc_char(szMAKEFILE));

		if (ITEMID_CHECK (szSYSCD, szDSNCD, szRSRCNAME, szITEMID, "03") != 0) {
			ITEMID_Check_Err_Log(pTABLENM, "ITEMID CHECK ERROR ", szSYSCD, szDSNCD, szRSRCNAME, "", "");
			szItemIDErrCnt++;
			continue;
		}

		if (ITEMID_CHECK (szSYSCD, szMAKEDSN, szMAKEFILE, szMakeITEMID, "03") != 0) {
			ITEMID_Check_Err_Log(pTABLENM, "MAKEFILE ITEMID CHECK ERROR ", szSYSCD, szMAKEDSN, szMAKEFILE, "", "");
			szItemIDErrCnt1++;
			continue;
		}


		/*-------------------------------------------------------*/
	    /*	TO-BE TABLE INSERT                                   */
	    /*-------------------------------------------------------*/
		EXEC SQL AT TOBE
			INSERT INTO CMD0010
				( CD_ITEMID
				, CD_MAKEITEM
				, CD_EDITOR
				, CD_LASTDT
				)
			VALUES
				( :szITEMID
				, :szMakeITEMID
				, :szEDITOR
				, TO_DATE(:szLASTDT, 'YYYYMMDD')
				);

		if (sqlca.sqlcode == 0)
			szSuccessCnt++;
		else {
			fprintf(stderr, "%d %s\n", sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
			szErrorCnt++;
		}

		EXEC SQL AT TOBE COMMIT;
 	}
 	EXEC SQL AT ASIS close ASIS_CMD0010;

	Get_Sys_Date(szEndDate);
	Get_Sys_Time(szEndTime);

	fprintf(stdout, "TABLE : %-20s TOTAL : %06d   SUCCESS : %06d   ERROR : %06d ITEMID SKIP : %06d MAKE ITEMID SKIP : %06d [%s %s ~ %s %s] %d\n"
				  , pTABLENM, szTotalCnt, szSuccessCnt, szErrorCnt, szItemIDErrCnt, szItemIDErrCnt1, szStartDate, szStartTime, szEndDate, szEndTime
				  , Get_RunSecond(szStartDate, szStartTime, szEndDate, szEndTime));

	return (0);

}


/*---------------------------------------------------------------*/
/*	Function  : CMD0011_CONVERT                                  */
/*	Action    : CMD0011_CONVERT                                  */
/*	            프로세스정보                                     */
/*	Parameter : pTABLENM : 테이블명                              */
/*	Return    : 0 : 정상, 1 : 오류                               */
/*---------------------------------------------------------------*/
int 	CMD0011_CONVERT     ( char *pTABLENM
							)
{
char	szSYSCD                    [3+1];
char	szDSNCD                    [5+1];
char	szEDITOR                  [10+1];
char	szLASTDT                  [14+1];
char	szPROCDSN                  [5+1];
char	szPROCNM                  [50+1];
char	szRSRCNAME               [100+1];
char	szITEMID              [dfItemID];
char	szPrcITEMID           [dfItemID];


	Get_Sys_Date(szStartDate);
	Get_Sys_Time(szStartTime);

	szTotalCnt   = 0;
	szSuccessCnt = 0;
	szErrorCnt   = 0;
	szItemIDErrCnt = 0;


	/*-----------------------------------------------------------*/
    /*	 AS-IS TABLE  READ                                       */
    /*-----------------------------------------------------------*/
	EXEC SQL AT ASIS
		DECLARE ASIS_CMD0011 CURSOR FOR
			SELECT  CD_SYSCD
			      , CD_DSNCD
			      , CD_EDITOR
			      , CD_LASTDT
			      , CD_RSRCNAME
			      , CD_PROCDSN
			      , CD_PROCNM
   			  FROM  COVM_IMS.CMD0011
   			 WHERE  CD_SYSCD = DECODE(:szINSysCD, 'ALL', CD_SYSCD, :szINSysCD);


	EXEC SQL AT ASIS OPEN ASIS_CMD0011;

	if (sqlca.sqlcode != 0) {
		fprintf(stderr, "ASIS_%s SQL ERROR [%d] [%s]\n", pTABLENM, sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
		exit (1);
	}

    while (1) {
		EXEC SQL AT ASIS FETCH ASIS_CMD0011
			INTO  :szSYSCD
				, :szDSNCD
				, :szEDITOR
				, :szLASTDT
				, :szRSRCNAME
				, :szPROCDSN
				, :szPROCNM;

		if (sqlca.sqlcode == 1403) break;

		szTotalCnt++;

		if (sqlca.sqlcode != 0 && sqlca.sqlcode != -1405) {
			fprintf(stderr, "%d %s\n", sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
			szErrorCnt++;
			break;
		}

		sprintf(szSYSCD   , "%s", trunc_char(szSYSCD   ));
		sprintf(szDSNCD   , "%s", trunc_char(szDSNCD   ));
		sprintf(szEDITOR  , "%s", trunc_char(szEDITOR  ));
		sprintf(szLASTDT  , "%s", trunc_char(szLASTDT  ));
		sprintf(szRSRCNAME, "%s", trunc_char(szRSRCNAME));
		sprintf(szPROCDSN , "%s", trunc_char(szPROCDSN ));
		sprintf(szPROCNM  , "%s", trunc_char(szPROCNM  ));

		if (ITEMID_CHECK (szSYSCD, szDSNCD, szRSRCNAME, szITEMID, "03") != 0) {
			ITEMID_Check_Err_Log(pTABLENM, "ITEMID CHECK ERROR ", szSYSCD, szDSNCD, szRSRCNAME, "", "");
			szItemIDErrCnt++;
			continue;
		}

		/*-------------------------------------------------------*/
	    /*	TO-BE TABLE INSERT                                   */
	    /*-------------------------------------------------------*/
		EXEC SQL AT TOBE
			INSERT INTO CMD0011
				( CD_ITEMID
				, CD_PRCITEM
				, CD_EDITOR
				, CD_LASTDT
				)
			VALUES
				( :szITEMID
				, :szPROCNM
				, :szEDITOR
				, TO_DATE(:szLASTDT, 'YYYYMMDD')
				);

		if (sqlca.sqlcode == 0)
			szSuccessCnt++;
		else {
			fprintf(stderr, "%d %s\n", sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
			szErrorCnt++;
		}

		EXEC SQL AT TOBE COMMIT;
 	}
 	EXEC SQL AT ASIS close ASIS_CMD0011;

	Get_Sys_Date(szEndDate);
	Get_Sys_Time(szEndTime);

	fprintf(stdout, "TABLE : %-20s TOTAL : %06d   SUCCESS : %06d   ERROR : %06d ITEMID SKIP : %06d [%s %s ~ %s %s] %d\n"
				  , pTABLENM, szTotalCnt, szSuccessCnt, szErrorCnt, szItemIDErrCnt, szStartDate, szStartTime, szEndDate, szEndTime
				  , Get_RunSecond(szStartDate, szStartTime, szEndDate, szEndTime));

	return (0);

}



/*---------------------------------------------------------------*/
/*	Function  : CMD0020_CONVERT                                  */
/*	Action    : CMD0020 CONVERT                                  */
/*	            파일비교결과                                     */
/*	Parameter : pTABLENM : 테이블명                              */
/*	Return    : 0 : 정상, 1 : 오류                               */
/*---------------------------------------------------------------*/
int 	CMD0020_CONVERT     ( char *pTABLENM
							)
{
char	szSYSCD                    [3+1];
char	szDSNCD                    [5+1];
char	szRSRCNAME               [100+1];
char	szSYSGB                    [1+1];
char	szSVRCD    	               [2+1];
char	szSVRIP    	              [20+1];
char	szEDITOR                  [10+1];
char	szBASICDT                 [14+1];
char	szJOBCD                    [5+1];
char	szCHGTIME                 [14+1];
int 	szSIZE                          ;
char	szDIFFDT                  [14+1];
char	szSTATUS                   [1+1];
char	szOBJNAME                 [50+1];
char	szOBJTIME                 [14+1];
int 	szOBJSIZE                       ;
int     szDIFFRST                       ;
char    szOBJECT                   [1+1];
char    szOWNER                   [10+1];
char    szGROUP                   [10+1];
char    szCKCRC                   [20+1];
int     szCKSIZE                        ;
char    szOBJOWNER                [10+1];
char    szOBJGROUP                [10+1];
char    szOBJCKCRC                [20+1];
int     szOBJCKSIZE                     ;
char    szPRENAME                 [50+1];
char    szPRETIME                 [14+1];
int     szPRESIZE                       ;
char    szPREOWNER                [10+1];
char    szPREGROUP                [10+1];
char    szPRECKCRC                [20+1];
int     szPRECKSIZE                     ;
char    szECAMSDT                 [14+1];
int     szECAMSSIZE                     ;


	Get_Sys_Date(szStartDate);
	Get_Sys_Time(szStartTime);

	szTotalCnt   = 0;
	szSuccessCnt = 0;
	szErrorCnt   = 0;

	/*-----------------------------------------------------------*/
    /*	 AS-IS TABLE  READ                                       */
    /*-----------------------------------------------------------*/
	EXEC SQL AT ASIS
		DECLARE ASIS_CMD0020 CURSOR FOR
			SELECT  CD_SYSCD
			      , CD_DSNCD
			      , CD_RSRCNAME
			      , CD_SYSGB
			      , CD_SVRCD
			      , CD_SVRIP
			      , CD_EDITOR
			      , CD_BASICDT
			      , CD_JOBCD
			      , CD_CHGTIME
			      , CD_SIZE
			      , TO_CHAR(CD_DIFFDT, 'YYYYMMDDHH24MISS')
			      , CD_STATUS
			      , CD_OBJNAME
			      , CD_OBJTIME
			      , CD_OBJSIZE
			      , CD_DIFFRST
			      , CD_OBJECT
			      , CD_OWNER
			      , CD_GROUP
			      , CD_CKCRC
			      , CD_CKSIZE
			      , CD_OBJOWNER
			      , CD_OBJGROUP
			      , CD_OBJCKCRC
			      , CD_OBJCKSIZE
			      , CD_PRENAME
			      , CD_PRETIME
			      , CD_PRESIZE
			      , CD_PREOWNER
			      , CD_PREGROUP
			      , CD_PRECKCRC
			      , CD_PRECKSIZE
			      , CD_ECAMSDT
			      , CD_ECAMSSIZE
   			  FROM  COVM_IMS.CMD0020
   			 WHERE  CD_SYSCD = DECODE(:szINSysCD, 'ALL', CD_SYSCD, :szINSysCD);


	EXEC SQL AT ASIS OPEN ASIS_CMD0020;

	if (sqlca.sqlcode != 0) {
		fprintf(stderr, "ASIS_%s SQL ERROR [%d] [%s]\n", pTABLENM, sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
		exit (1);
	}

    while (1) {
		EXEC SQL AT ASIS FETCH ASIS_CMD0020
			INTO  :szSYSCD
				, :szDSNCD
				, :szRSRCNAME
				, :szSYSGB
				, :szSVRCD
				, :szSVRIP
				, :szEDITOR
				, :szBASICDT
				, :szJOBCD
				, :szCHGTIME
				, :szSIZE
				, :szDIFFDT
				, :szSTATUS
				, :szOBJNAME
				, :szOBJTIME
				, :szOBJSIZE
				, :szDIFFRST
				, :szOBJECT
				, :szOWNER
				, :szGROUP
				, :szCKCRC
				, :szCKSIZE
				, :szOBJOWNER
				, :szOBJGROUP
				, :szOBJCKCRC
				, :szOBJCKSIZE
				, :szPRENAME
				, :szPRETIME
				, :szPRESIZE
				, :szPREOWNER
				, :szPREGROUP
				, :szPRECKCRC
				, :szPRECKSIZE
				, :szECAMSDT
				, :szECAMSSIZE;

		if (sqlca.sqlcode == 1403) break;

		if (sqlca.sqlcode != 0 && sqlca.sqlcode != -1405) {
			fprintf(stderr, "%d %s\n", sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
			szErrorCnt++;
			break;
		}

		sprintf(szSYSCD   , "%s", trunc_char(szSYSCD   ));
		sprintf(szDSNCD   , "%s", trunc_char(szDSNCD   ));
		sprintf(szRSRCNAME, "%s", trunc_char(szRSRCNAME));
		sprintf(szSYSGB   , "%s", trunc_char(szSYSGB   ));
		sprintf(szSVRCD   , "%s", trunc_char(szSVRCD   ));
		sprintf(szSVRIP   , "%s", trunc_char(szSVRIP   ));
		sprintf(szEDITOR  , "%s", trunc_char(szEDITOR  ));
		sprintf(szBASICDT , "%s", trunc_char(szBASICDT ));
		sprintf(szJOBCD   , "%s", trunc_char(szJOBCD   ));
		sprintf(szCHGTIME , "%s", trunc_char(szCHGTIME ));
		sprintf(szDIFFDT  , "%s", trunc_char(szDIFFDT  ));
		sprintf(szSTATUS  , "%s", trunc_char(szSTATUS  ));
		sprintf(szOBJNAME , "%s", trunc_char(szOBJNAME ));
		sprintf(szOBJTIME , "%s", trunc_char(szOBJTIME ));
		sprintf(szOBJECT  , "%s", trunc_char(szOBJECT  ));
		sprintf(szOWNER   , "%s", trunc_char(szOWNER   ));
		sprintf(szGROUP   , "%s", trunc_char(szGROUP   ));
		sprintf(szCKCRC   , "%s", trunc_char(szCKCRC   ));
		sprintf(szOBJOWNER, "%s", trunc_char(szOBJOWNER));
		sprintf(szOBJGROUP, "%s", trunc_char(szOBJGROUP));
		sprintf(szOBJCKCRC, "%s", trunc_char(szOBJCKCRC));
		sprintf(szPRENAME , "%s", trunc_char(szPRENAME ));
		sprintf(szPRETIME , "%s", trunc_char(szPRETIME ));
		sprintf(szPREOWNER, "%s", trunc_char(szPREOWNER));
		sprintf(szPREGROUP, "%s", trunc_char(szPREGROUP));
		sprintf(szPRECKCRC, "%s", trunc_char(szPRECKCRC));
		sprintf(szECAMSDT , "%s", trunc_char(szECAMSDT ));

		szTotalCnt++;

		/*-------------------------------------------------------*/
	    /*	TO-BE TABLE INSERT                                   */
	    /*-------------------------------------------------------*/
		EXEC SQL AT TOBE
			INSERT INTO CMD0020
				( CD_SYSCD
			    , CD_DSNCD
			    , CD_RSRCNAME
			    , CD_SYSGB
			    , CD_SVRCD
			    , CD_SVRIP
			    , CD_EDITOR
			    , CD_BASICDT
			    , CD_JOBCD
