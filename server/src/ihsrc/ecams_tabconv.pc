/*---------------------------------------------------------------*/
/*	Function  : CMM0060_CONVERT                                  */
/*	Action    : CMM0060 CONVERT                                  */
/*	            결재단계 정보 관리                               */
/*	Parameter : pTABLENM : 테이블명                              */
/*	Return    : 0 : 정상, 1 : 오류                               */
/*---------------------------------------------------------------*/
int 	CMM0060_CONVERT     ( char *pTABLENM
							)
{
char	szSYSCD	                   [3+1];
char	szREQCD                    [2+1];
int 	szSEQNO                         ;
char	szMANID                    [1+1];
char	szNAME                    [30+1];
char	szGUBUN                    [1+1];
char	szCOMMON                   [1+1];
char	szBLANK                    [1+1];
char	szHOLIDAY                  [1+1];
char	szEMG                      [1+1];
char	szEMG2                     [1+1];
char	szORGSTEP                  [1+1];
char	szPOSITION                [60+1];
char	szJOBCD                   [30+1];
char	szRSRCCD                  [30+1];
char	szPGMTYPE                 [50+1];


	Get_Sys_Date(szStartDate);
	Get_Sys_Time(szStartTime);

	szTotalCnt   = 0;
	szSuccessCnt = 0;
	szErrorCnt   = 0;


	EXEC SQL AT TOBE
		DELETE  CMM0060
          WHERE CM_SYSCD NOT IN ('99999');

	/*-----------------------------------------------------------*/
    /*	 AS-IS TABLE  READ                                       */
    /*-----------------------------------------------------------*/
	EXEC SQL AT ASIS
		DECLARE ASIS_CMM0060 CURSOR FOR
			SELECT  CM_SYSCD
                  , CM_REQCD
                  , CM_SEQNO
                  , CM_MANID
                  , CM_NAME
                  , CM_GUBUN
                  , CM_COMMON
                  , CM_BLANK
                  , CM_HOLIDAY
                  , CM_EMG
                  , CM_EMG2
                  , CM_ORGSTEP
                  , CM_POSITION
                  , CM_JOBCD
                  , CM_RSRCCD
                  , CM_PGMTYPE
   			  FROM  COVM_IMS.CMM0060;

	EXEC SQL AT ASIS OPEN ASIS_CMM0060;

	if (sqlca.sqlcode != 0) {
		fprintf(stderr, "ASIS_%s SQL ERROR [%d] [%s]\n", pTABLENM, sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
		exit (1);
	}

    while (1) {
		EXEC SQL AT ASIS FETCH ASIS_CMM0060
			INTO  :szSYSCD
				, :szREQCD
				, :szSEQNO
				, :szMANID
				, :szNAME
				, :szGUBUN
				, :szCOMMON
				, :szBLANK
				, :szHOLIDAY
				, :szEMG
				, :szEMG2
				, :szORGSTEP
				, :szPOSITION
				, :szJOBCD
				, :szRSRCCD
				, :szPGMTYPE ;

		if (sqlca.sqlcode == 1403) break;

		szTotalCnt++;

		if (sqlca.sqlcode != 0 && sqlca.sqlcode != -1405) {
			fprintf(stderr, "%d %s\n", sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
			szErrorCnt++;
			break;
		}

		sprintf(szSYSCD	  , "%s", trunc_char(szSYSCD	));
		sprintf(szREQCD   , "%s", trunc_char(szREQCD   ));
		sprintf(szMANID   , "%s", trunc_char(szMANID   ));
		sprintf(szNAME    , "%s", trunc_char(szNAME    ));
		sprintf(szGUBUN   , "%s", trunc_char(szGUBUN   ));
		sprintf(szCOMMON  , "%s", trunc_char(szCOMMON  ));
		sprintf(szBLANK   , "%s", trunc_char(szBLANK   ));
		sprintf(szHOLIDAY , "%s", trunc_char(szHOLIDAY ));
		sprintf(szEMG     , "%s", trunc_char(szEMG     ));
		sprintf(szEMG2    , "%s", trunc_char(szEMG2    ));
		sprintf(szORGSTEP , "%s", trunc_char(szORGSTEP ));
		sprintf(szPOSITION, "%s", trunc_char(szPOSITION));
		sprintf(szJOBCD   , "%s", trunc_char(szJOBCD   ));
		sprintf(szRSRCCD  , "%s", trunc_char(szRSRCCD  ));
		sprintf(szPGMTYPE , "%s", trunc_char(szPGMTYPE ));


		/*-------------------------------------------------------*/
	    /*	TO-BE TABLE INSERT                                   */
	    /*-------------------------------------------------------*/
		EXEC SQL AT TOBE
			INSERT INTO CMM0060
				( CM_SYSCD
				, CM_REQCD
				, CM_SEQNO
				, CM_MANID
				, CM_NAME
				, CM_GUBUN
				, CM_COMMON
				, CM_BLANK
				, CM_HOLIDAY
				, CM_EMG
				, CM_EMG2
				, CM_ORGSTEP
				, CM_POSITION
				, CM_JOBCD
				, CM_RSRCCD
				, CM_PGMTYPE
				, CM_PRCSW
				)
			VALUES
				( LPAD(:szSYSCD, 5, '0')
				, :szREQCD
				, :szSEQNO
				, :szMANID
				, :szNAME
				, :szGUBUN
				, :szCOMMON
				, :szBLANK
				, :szHOLIDAY
				, :szEMG
				, NVL(:szEMG2, '2')
				, :szORGSTEP
				, DECODE(SUBSTR(:szJOBCD,1,3), 'SYS', :szPOSITION, :szJOBCD)
				, DECODE(SUBSTR(:szJOBCD,1,3), 'SYS', :szJOBCD, NULL)
				, :szRSRCCD
				, :szPGMTYPE
				, 'N'
				);

		if (sqlca.sqlcode == 0)
			szSuccessCnt++;
		else
			szErrorCnt++;

 	}
 	EXEC SQL AT ASIS close ASIS_CMM0060;

	Get_Sys_Date(szEndDate);
	Get_Sys_Time(szEndTime);

	fprintf(stdout, "TABLE : %-20s TOTAL : %06d   SUCCESS : %06d   ERROR : %06d [%s %s ~ %s %s] %d\n"
				  , pTABLENM, szTotalCnt, szSuccessCnt, szErrorCnt, szStartDate, szStartTime, szEndDate, szEndTime
				  , Get_RunSecond(szStartDate, szStartTime, szEndDate, szEndTime));

	return (0);

}


/*---------------------------------------------------------------*/
/*	Function  : CMM0070_CONVERT                                  */
/*	Action    : CMM0070 CONVERT                                  */
/*	            서버자원별 디렉토리 정보                         */
/*	Parameter : pTABLENM : 테이블명                              */
/*	Return    : 0 : 정상, 1 : 오류                               */
/*---------------------------------------------------------------*/
int 	CMM0070_CONVERT     ( char *pTABLENM
							)
{
char	szSYSCD                    [3+1];
char	szDSNCD                    [5+1];
char	szDIRPATH                [500+1];
char	szEDITOR                  [10+1];
char	szOPENDT                  [14+1];
char	szLASTUPDT                [14+1];
char	szCLSDT                   [14+1];
char	szRUNSTA                   [1+1];


	Get_Sys_Date(szStartDate);
	Get_Sys_Time(szStartTime);

	szTotalCnt   = 0;
	szSuccessCnt = 0;
	szErrorCnt   = 0;


	/*-----------------------------------------------------------*/
    /*	 AS-IS TABLE  READ                                       */
    /*-----------------------------------------------------------*/
	EXEC SQL AT ASIS
		DECLARE ASIS_CMM0070 CURSOR FOR
			SELECT  CM_SYSCD
			      , CM_DSNCD
			      , CM_DIRPATH
			      , CM_EDITOR
			      , TO_CHAR(CM_OPENDT  , 'YYYYMMDDHH24MISS')
			      , TO_CHAR(CM_LASTUPDT, 'YYYYMMDDHH24MISS')
			      , TO_CHAR(CM_CLSDT   , 'YYYYMMDDHH24MISS')
			      , CM_RUNSTA
   			  FROM  COVM_IMS.CMM0070
   			 WHERE  CM_DIRPATH IS NOT NULL;

	EXEC SQL AT ASIS OPEN ASIS_CMM0070;

	if (sqlca.sqlcode != 0) {
		fprintf(stderr, "ASIS_%s SQL ERROR [%d] [%s]\n", pTABLENM, sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
		exit (1);
	}

    while (1) {
		EXEC SQL AT ASIS FETCH ASIS_CMM0070
			INTO  :szSYSCD
				, :szDSNCD
				, :szDIRPATH
				, :szEDITOR
				, :szOPENDT
				, :szLASTUPDT
				, :szCLSDT
				, :szRUNSTA  ;

		if (sqlca.sqlcode == 1403) break;

		szTotalCnt++;

		if (sqlca.sqlcode != 0 && sqlca.sqlcode != -1405) {
			fprintf(stderr, "%d %s\n", sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
			szErrorCnt++;
			break;
		}

		sprintf(szSYSCD   , "%s", trunc_char(szSYSCD   ));
		sprintf(szDSNCD   , "%s", trunc_char(szDSNCD   ));
		sprintf(szDIRPATH , "%s", trunc_char(szDIRPATH ));
		sprintf(szEDITOR  , "%s", trunc_char(szEDITOR  ));
		sprintf(szOPENDT  , "%s", trunc_char(szOPENDT  ));
		sprintf(szLASTUPDT, "%s", trunc_char(szLASTUPDT));
		sprintf(szCLSDT   , "%s", trunc_char(szCLSDT   ));
		sprintf(szRUNSTA  , "%s", trunc_char(szRUNSTA  ));

		/*-------------------------------------------------------*/
	    /*	TO-BE TABLE INSERT                                   */
	    /*-------------------------------------------------------*/
		EXEC SQL AT TOBE
			INSERT INTO CMM0070
				( CM_SYSCD
			    , CM_DSNCD
			    , CM_DIRPATH
			    , CM_EDITOR
			    , CM_OPENDT
			    , CM_LASTUPDT
			    , CM_CLSDT
			    , CM_RUNSTA
				)
			VALUES
				( LPAD(:szSYSCD, 5, '0')
				, LPAD(:szDSNCD, 7, '0')
				, :szDIRPATH
				, :szEDITOR
				, TO_DATE(:szOPENDT  , 'YYYYMMDDHH24MISS')
				, TO_DATE(:szLASTUPDT, 'YYYYMMDDHH24MISS')
				, TO_DATE(:szCLSDT   , 'YYYYMMDDHH24MISS')
				, :szRUNSTA
				);

		if (sqlca.sqlcode == 0)
			szSuccessCnt++;
		else {
			fprintf(stderr, "ERROR : %s %s %s %d\n", szSYSCD, szDSNCD, szDIRPATH, sqlca.sqlcode);
			szErrorCnt++;
		}

 	}
 	EXEC SQL AT ASIS close ASIS_CMM0070;

	Get_Sys_Date(szEndDate);
	Get_Sys_Time(szEndTime);

	fprintf(stdout, "TABLE : %-20s TOTAL : %06d   SUCCESS : %06d   ERROR : %06d [%s %s ~ %s %s] %d\n"
				  , pTABLENM, szTotalCnt, szSuccessCnt, szErrorCnt, szStartDate, szStartTime, szEndDate, szEndTime
				  , Get_RunSecond(szStartDate, szStartTime, szEndDate, szEndTime));

	return (0);


}


/*---------------------------------------------------------------*/
/*	Function  : CMM0071_CONVERT                                  */
