		if (sqlca.sqlcode == 1403) break;

		szTotalCnt++;

		if (sqlca.sqlcode != 0 && sqlca.sqlcode != -1405) {
			fprintf(stderr, "%d %s\n", sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
			szErrorCnt++;
			break;
		}

		sprintf(szSTNO     , "%s", trunc_char(szSTNO     ));
		sprintf(szRUNCD    , "%s", trunc_char(szRUNCD    ));
		sprintf(szSYSCD    , "%s", trunc_char(szSYSCD    ));
		sprintf(szSVRIP    , "%s", trunc_char(szSVRIP    ));
		sprintf(szLASTDT   , "%s", trunc_char(szLASTDT   ));
		sprintf(szEXENAME  , "%s", trunc_char(szEXENAME  ));
		sprintf(szBASEDIRCD, "%s", trunc_char(szBASEDIRCD));
		sprintf(szEXECD    , "%s", trunc_char(szEXECD    ));
		sprintf(szEXISTYN  , "%s", trunc_char(szEXISTYN  ));

		/*-------------------------------------------------------*/
	    /*	TO-BE TABLE INSERT                                   */
	    /*-------------------------------------------------------*/
		EXEC SQL AT TOBE
			INSERT INTO CMM0017
				( CM_STNO
				, CM_RUNCD
				, CM_SYSCD
				, CM_SVRIP
				, CM_LASTDT
				, CM_EXENAME
				, CM_BASEDIRCD
				, CM_EXECD
				, CM_EXISTYN
				)
			VALUES
				( :szSTNO     
			    , :szRUNCD    
			    , LPAD(:szSYSCD, 5, '0')
			    , :szSVRIP    
			    , TO_DATE(:szLASTDT, 'YYYYMMDDHH24MISS')
			    , :szEXENAME  
			    , :szBASEDIRCD
			    , :szEXECD    
			    , :szEXISTYN  
				);

		if (sqlca.sqlcode == 0)
			szSuccessCnt++;
		else {
			fprintf(stderr, "%s %s %s %d %s\n", szRUNCD, szSYSCD, szSVRIP, sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
			szErrorCnt++;
		}

 	}
 	EXEC SQL AT ASIS close ASIS_CMM0017;

	Get_Sys_Date(szEndDate);
	Get_Sys_Time(szEndTime);

	fprintf(stdout, "TABLE : %-20s TOTAL : %06d   SUCCESS : %06d   ERROR : %06d [%s %s ~ %s %s] %d\n"
				  , pTABLENM, szTotalCnt, szSuccessCnt, szErrorCnt, szStartDate, szStartTime, szEndDate, szEndTime
				  , Get_RunSecond(szStartDate, szStartTime, szEndDate, szEndTime));


	return (0);

}

