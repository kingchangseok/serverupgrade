		EXEC SQL AT TOBE
			INSERT INTO CMM0041
				( CM_USERID
			    , CM_CHANGDT
			    , CM_PASSWD
				)
			VALUES
				( :szUSERID
				, TO_DATE(:szCHANGDT, 'YYYYMMDDHH24MISS')
				, :szPASSWD
				);

		if (sqlca.sqlcode == 0)
