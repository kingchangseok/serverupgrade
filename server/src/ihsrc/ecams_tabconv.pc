				, :szLASTID;

		if (sqlca.sqlcode == 1403) break;

		szTotalCnt++;

		if (sqlca.sqlcode != 0 && sqlca.sqlcode != -1405) {
			fprintf(stderr, "%d %s\n", sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
			szErrorCnt++;
			break;
		}

		sprintf(szGUBUN , "%s", trunc_char(szGUBUN ));
		sprintf(szLASTDT, "%s", trunc_char(szLASTDT));
		sprintf(szLASTID, "%s", trunc_char(szLASTID));

		/*-------------------------------------------------------*/
	    /*	TO-BE TABLE INSERT                                   */
	    /*-------------------------------------------------------*/
		EXEC SQL AT TOBE
			INSERT INTO CMR0010
				( CR_GUBUN
				, CR_NO
				, CR_LASTDT
				, CR_LASTID
				)
			VALUES
				( :szGUBUN
				, :szNO
				, TO_DATE(:szLASTDT, 'YYYYMMDDHH24MISS')
				, :szLASTID
				);

		if (sqlca.sqlcode == 0)
			szSuccessCnt++;
		else
			szErrorCnt++;

 	}
 	EXEC SQL AT ASIS close ASIS_CMR0010;

	Get_Sys_Date(szEndDate);
	Get_Sys_Time(szEndTime);

	fprintf(stdout, "TABLE : %-20s TOTAL : %06d   SUCCESS : %06d   ERROR : %06d [%s %s ~ %s %s] %d\n"
				  , pTABLENM, szTotalCnt, szSuccessCnt, szErrorCnt, szStartDate, szStartTime, szEndDate, szEndTime
				  , Get_RunSecond(szStartDate, szStartTime, szEndDate, szEndTime));

	return (0);

}


/*---------------------------------------------------------------*/
/*	Function  : CMR0020_CONVERT                                  */
/*	Action    : CMR0020 CONVERT                                  */
/*	            형상관리대상파일원장                             */
/*	Parameter : pTABLENM : 테이블명                              */
/*	Return    : 0 : 정상, 1 : 오류                               */
/*---------------------------------------------------------------*/
int 	CMR0020_CONVERT     ( char *pTABLENM
							)
{
char	szSYSCD	                   [3+1];
char	szDSNCD	                   [5+1];
char	szRSRCNAME	             [100+1];
char	szRSRCCD	               [5+1];
char	szJOBCD	                   [5+1];
char	szLANGCD	               [2+1];
char	szYONGDO	               [2+1];
char	szSTATUS	               [1+1];
char	szCREATOR	              [10+1];
char	szSTORY	                [1000+1];
char	szOPENDATE	              [14+1];
char	szCLSDATE	              [14+1];
char	szLASTDATE	              [14+1];
int 	szLSTVER	                    ;
char	szEDITOR	              [10+1];
int 	szSTEPCNT	                    ;
int 	szFILESIZE	                    ;
char	szFILEDATE	              [14+1];
char	szFILEUSER	              [20+1];
char	szFILEGRP	              [20+1];
char	szFILEMODE	              [10+1];
char	szPGMTYPE	               [2+1];
int 	szTSTVER	                    ;
char	szBASEDSN	               [5+1];
char	szBASEPGM	             [128+1];
char	szINFOYN	               [1+1];
char	szMD5SUM	              [32+1];
char	szNOCMP	                   [1+1];
char	szBaseItem            [dfItemID];
int 	szIsrtFg                        ;
char	szItemID              [dfItemID];
char	szOWNER               [dfEditor];
char	szPGMINFO                [100+1];
char	szPGMINFO2               [100+1];


	Get_Sys_Date(szStartDate);
	Get_Sys_Time(szStartTime);

	szTotalCnt   = 0;
	szSuccessCnt = 0;
	szErrorCnt   = 0;
	szItemIDErrCnt = 0;


	/*-----------------------------------------------------------*/
    /*	 AS-IS TABLE  READ                                       */
    /*-----------------------------------------------------------*/
	EXEC SQL AT ASIS
		DECLARE ASIS_CMR0020 CURSOR FOR
			SELECT  CR_SYSCD
			      , CR_DSNCD
			      , CR_RSRCNAME
			      , CR_RSRCCD
			      , CR_JOBCD
			      , CR_LANGCD
			      , CR_YONGDO
			      , CR_STATUS
			      , CR_CREATOR
			      , CR_STORY
			      , TO_CHAR(CR_OPENDATE, 'YYYYMMDDHH24MISS')
			      , TO_CHAR(CR_CLSDATE , 'YYYYMMDDHH24MISS')
			      , TO_CHAR(CR_LASTDATE, 'YYYYMMDDHH24MISS')
			      , CR_LSTVER
			      , CR_EDITOR
			      , NVL(CR_STEPCNT, 0)
			      , CR_FILESIZE
			      , CR_FILEDATE
			      , CR_FILEUSER
			      , CR_FILEGRP
			      , CR_FILEMODE
			      , CR_PGMTYPE
			      , CR_TSTVER
			      , CR_BASEDSN
			      , CR_BASEPGM
			      , CR_INFOYN
			      , CR_MD5SUM
			      , CR_NOCMP
			      , CR_OWNER
			      , CR_PGMINFO
			      , CR_PGMINFO2
   			  FROM  COVM_IMS.CMR0020
   			 WHERE  CR_SYSCD = DECODE(:szINSysCD, 'ALL', CR_SYSCD, :szINSysCD)
   			 ORDER BY NVL(LENGTH(CR_BASEDSN), 0) + NVL(LENGTH(CR_BASEPGM), 0);

	EXEC SQL AT ASIS OPEN ASIS_CMR0020;

	if (sqlca.sqlcode != 0) {
		fprintf(stderr, "ASIS_%s SQL ERROR [%d] [%s]\n", pTABLENM, sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
		exit (1);
	}

    while (1) {
		EXEC SQL AT ASIS FETCH ASIS_CMR0020
			INTO  :szSYSCD
				, :szDSNCD
				, :szRSRCNAME
				, :szRSRCCD
				, :szJOBCD
				, :szLANGCD
				, :szYONGDO
				, :szSTATUS
				, :szCREATOR
				, :szSTORY
				, :szOPENDATE
				, :szCLSDATE
				, :szLASTDATE
				, :szLSTVER
				, :szEDITOR
				, :szSTEPCNT
				, :szFILESIZE
				, :szFILEDATE
				, :szFILEUSER
				, :szFILEGRP
				, :szFILEMODE
				, :szPGMTYPE
				, :szTSTVER
				, :szBASEDSN
				, :szBASEPGM
				, :szINFOYN
				, :szMD5SUM
				, :szNOCMP
				, :szOWNER
				, :szPGMINFO
				, :szPGMINFO2;

		if (sqlca.sqlcode == 1403) break;

		szTotalCnt++;

		if (sqlca.sqlcode != 0 && sqlca.sqlcode != -1405) {
			fprintf(stderr, "%d %s\n", sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
			szErrorCnt++;
			break;
		}

		sprintf(szSYSCD   , "%s", trunc_char(szSYSCD   ));
		sprintf(szDSNCD   , "%s", trunc_char(szDSNCD   ));
		sprintf(szRSRCNAME, "%s", trunc_char(szRSRCNAME));
		sprintf(szRSRCCD  , "%s", trunc_char(szRSRCCD  ));
		sprintf(szJOBCD   , "%s", trunc_char(szJOBCD   ));
		sprintf(szLANGCD  , "%s", trunc_char(szLANGCD  ));
		sprintf(szYONGDO  , "%s", trunc_char(szYONGDO  ));
		sprintf(szSTATUS  , "%s", trunc_char(szSTATUS  ));
		sprintf(szCREATOR , "%s", trunc_char(szCREATOR ));
		sprintf(szSTORY   , "%s", trunc_char(szSTORY   ));
		sprintf(szOPENDATE, "%s", trunc_char(szOPENDATE));
		sprintf(szCLSDATE , "%s", trunc_char(szCLSDATE ));
		sprintf(szLASTDATE, "%s", trunc_char(szLASTDATE));
		sprintf(szEDITOR  , "%s", trunc_char(szEDITOR  ));
		sprintf(szFILEDATE, "%s", trunc_char(szFILEDATE));
		sprintf(szFILEUSER, "%s", trunc_char(szFILEUSER));
		sprintf(szFILEGRP , "%s", trunc_char(szFILEGRP ));
		sprintf(szFILEMODE, "%s", trunc_char(szFILEMODE));
		sprintf(szPGMTYPE , "%s", trunc_char(szPGMTYPE ));
		sprintf(szBASEDSN , "%s", trunc_char(szBASEDSN ));
		sprintf(szBASEPGM , "%s", trunc_char(szBASEPGM ));
		sprintf(szINFOYN  , "%s", trunc_char(szINFOYN  ));
		sprintf(szMD5SUM  , "%s", trunc_char(szMD5SUM  ));
		sprintf(szNOCMP   , "%s", trunc_char(szNOCMP   ));
		sprintf(szOWNER   , "%s", trunc_char(szOWNER   ));
		sprintf(szPGMINFO , "%s", trunc_char(szPGMINFO ));
		sprintf(szPGMINFO2, "%s", trunc_char(szPGMINFO2));

		if (strlen(szBASEPGM) == 0 ) {
			memset(szBaseItem, 0x00, sizeof(szBaseItem));
		}
		else {
			if (ITEMID_CHECK (szSYSCD, szBASEDSN, szBASEPGM, szBaseItem, "01") != 0) {
				sprintf(szBaseItem, "%s", "000000000000");
				ITEMID_Check_Err_Log(pTABLENM, "BASE ITEM CHECK ERROR", szSYSCD, szDSNCD, szRSRCNAME, szBASEDSN, szBASEPGM);
				szItemIDErrCnt++;
			}
		}

		/*-------------------------------------------------------*/
	    /*	TO-BE TABLE INSERT                                   */
	    /*-------------------------------------------------------*/
		EXEC SQL AT TOBE
			INSERT INTO CMR0020
				( CR_ITEMID
				, CR_SYSCD
				, CR_DSNCD
				, CR_RSRCNAME
				, CR_RSRCCD
				, CR_JOBCD
				, CR_LANGCD
				, CR_IMPJOB
				, CR_IMPPGM
				, CR_STATUS
				, CR_CREATOR
				, CR_STORY
				, CR_OPENDATE
				, CR_CLSDATE
				, CR_LASTDATE
				, CR_LSTVER
				, CR_EDITOR
				, CR_STEPCNT
				, CR_FILESIZE
				, CR_FILEDATE
				, CR_FILEUSER
				, CR_FILEGRP
				, CR_FILEMODE
				, CR_PID
				, CR_NOMODIFY
				, CR_OWNER
				, CR_TSTPATH
				, CR_TSTSTA
				, CR_TSTVER
				, CR_ACPTNO
				, CR_BASEITEM
				, CR_LSTUSR
				, CR_LSTDAT
				, CR_SCRNO
				, CR_RESOURCEID
				, CR_RESOURCEGB
				, CR_ISRID
				, CR_ISRSUB
				, CR_TMAXGRP
				, CR_TODSN
				, CR_PGMINFO
				, CR_PGMINFO2
				, CR_MD5SUM
				)
			VALUES
				( LPAD(ITEMID_SEQ.NEXTVAL, 12, '0')
				, LPAD(:szSYSCD, 5, '0')
				, LPAD(:szDSNCD, 7, '0')
				, :szRSRCNAME
				, :szRSRCCD
				, :szJOBCD
				, :szLANGCD
				, :szYONGDO
				, :szPGMTYPE
				, :szSTATUS
				, :szCREATOR
				, :szSTORY
				, TO_DATE(:szOPENDATE, 'YYYYMMDDHH24MISS')
				, TO_DATE(:szCLSDATE , 'YYYYMMDDHH24MISS')
				, TO_DATE(:szLASTDATE, 'YYYYMMDDHH24MISS')
				, :szLSTVER
				, :szEDITOR
				, :szSTEPCNT
				, :szFILESIZE
				, :szFILEDATE
				, :szFILEUSER
				, :szFILEGRP
				, :szFILEMODE
				, NULL
				, NULL
				, :szCREATOR
				, NULL
				, NULL
				, NULL
				, NULL
				, :szBaseItem
				, NULL
				, NULL
				, NULL
				, NULL
				, NULL
				, NULL
				, NULL
				, NULL
				, NULL
			    , :szPGMINFO
				, :szPGMINFO2
				, :szMD5SUM
				);

		if (sqlca.sqlcode == 0) {
			szSuccessCnt++;
		}
		else {
			fprintf(stderr, "<%s> <%s> <%s> %d \n", szSYSCD, szDSNCD, szRSRCNAME, sqlca.sqlcode);
			szErrorCnt++;
		}

		EXEC SQL AT TOBE COMMIT;
 	}
 	EXEC SQL AT ASIS close ASIS_CMR0020;

	Get_Sys_Date(szEndDate);
	Get_Sys_Time(szEndTime);

	EXEC SQL AT TOBE
		UPDATE  CMR0020
		   SET  CR_BASEITEM = CR_ITEMID
	     WHERE  CR_SYSCD = DECODE(:szINSysCD, 'ALL', CR_SYSCD, LPAD(:szINSysCD, 5, '0'))
	       AND  CR_BASEITEM IS NULL;

	EXEC SQL AT TOBE COMMIT;

	fprintf(stdout, "TABLE : %-20s TOTAL : %06d   SUCCESS : %06d   ERROR : %06d BASE ITEMID ERROR : %06d [%s %s ~ %s %s] %d\n"
				  , pTABLENM, szTotalCnt, szSuccessCnt, szErrorCnt, szItemIDErrCnt, szStartDate, szStartTime, szEndDate, szEndTime
				  , Get_RunSecond(szStartDate, szStartTime, szEndDate, szEndTime));

	return (0);
}


/*---------------------------------------------------------------*/
/*	Function  : CMR0021_CONVERT                                  */
/*	Action    : CMR0021 CONVERT                                  */
/*	            파일별변경History                                */
/*	Parameter : pTABLENM : 테이블명                              */
/*	Return    : 0 : 정상, 1 : 오류                               */
/*---------------------------------------------------------------*/
int 	CMR0021_CONVERT     ( char *pTABLENM
							)
{
char	szSYSCD                    [3+1];
char	szDSNCD                    [5+1];
char	szRSRCNAME               [100+1];
char	szACPTNO                  [12+1];
char	szSORCNAME                 [5+1];
int 	szTSTVER                        ;
char	szItemID                  [12+1];
char	szACPTDATE                [14+1];
char	szPRCDATE                 [14+1];
char	szEDITOR                  [10+1];


	Get_Sys_Date(szStartDate);
	Get_Sys_Time(szStartTime);

	szTotalCnt   = 0;
	szSuccessCnt = 0;
	szErrorCnt   = 0;



	/*-----------------------------------------------------------*/
    /*	 AS-IS TABLE  READ                                       */
    /*-----------------------------------------------------------*/
	EXEC SQL AT ASIS
		DECLARE ASIS_CMR0021 CURSOR FOR
			SELECT  CR_SYSCD
			      , CR_DSNCD
			      , CR_RSRCNAME
			      , CR_ACPTNO
			      , CR_SORCNAME
			      , NVL(CR_TSTVER, 0)
			      , TO_CHAR(CR_PRCDATE, 'YYYYMMDDHH24MISS')
   			  FROM  COVM_IMS.CMR0021
             WHERE  CR_SYSCD = DECODE(:szINSysCD, 'ALL', CR_SYSCD, :szINSysCD);

	EXEC SQL AT ASIS OPEN ASIS_CMR0021;

	if (sqlca.sqlcode != 0) {
		fprintf(stderr, "ASIS_%s SQL ERROR [%d] [%s]\n", pTABLENM, sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
		exit (1);
	}

    while (1) {
		EXEC SQL AT ASIS FETCH ASIS_CMR0021
			INTO  :szSYSCD
				, :szDSNCD
				, :szRSRCNAME
				, :szACPTNO
				, :szSORCNAME
				, :szTSTVER
				, :szPRCDATE;

		if (sqlca.sqlcode == 1403) break;

		szTotalCnt++;

		if (sqlca.sqlcode != 0 && sqlca.sqlcode != -1405) {
			fprintf(stderr, "%d %s\n", sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
			szErrorCnt++;
			break;
		}

		sprintf(szSYSCD   , "%s", trunc_char(szSYSCD   ));
		sprintf(szDSNCD   , "%s", trunc_char(szDSNCD   ));
		sprintf(szRSRCNAME, "%s", trunc_char(szRSRCNAME));
		sprintf(szACPTNO  , "%s", trunc_char(szACPTNO  ));
		sprintf(szSORCNAME, "%s", trunc_char(szSORCNAME));
		sprintf(szPRCDATE , "%s", trunc_char(szPRCDATE ));

		if (ITEMID_CHECK (szSYSCD, szDSNCD, szRSRCNAME, szItemID, "03") != 0) {
			ITEMID_Check_Err_Log(pTABLENM, "ITEMID CHECK ERROR ", szSYSCD, szDSNCD, szRSRCNAME, "", "");
			szItemIDErrCnt++;
			continue;
		}

		/*-------------------------------------------------------*/
	    /*	이행완료여부 체크                                    */
	    /*-------------------------------------------------------*/
		EXEC SQL AT TOBE
			SELECT  NVL(COUNT(*), 0)
			  INTO  :nCnt
			  FROM  CMR0021
			 WHERE  CR_ITEMID = :szItemID
			   AND  CR_ACPTNO = :szACPTNO;

		if (sqlca.sqlcode != 0)
			nCnt = 0;

		if (nCnt > 0) {
			printf("CMR0021 SKIP : [%s] %s \n", szItemID, szACPTNO);
			continue;
		}


		/*-------------------------------------------------------*/
	    /*	신청정보 조회                                        */
	    /*-------------------------------------------------------*/
		EXEC SQL AT ASIS
			SELECT  TO_CHAR(A.CR_ACPTDATE, 'YYYYMMDDHH24MISS')
			      , TO_CHAR(B.CR_PRCDATE , 'YYYYMMDDHH24MISS')
			      , B.CR_EDITOR
			  INTO  :szACPTDATE
			  	  , :szPRCDATE
			  	  , :szEDITOR
			  FROM  COVM_IMS.CMR1000 A
			      , COVM_IMS.CMR1010 B
			 WHERE  B.CR_ACPTNO   = :szACPTNO
			   AND  B.CR_SYSCD    = :szSYSCD
			   AND  B.CR_DSNCD    = :szDSNCD
			   AND  B.CR_RSRCNAME = :szRSRCNAME
			   AND  A.CR_ACPTNO   = B.CR_ACPTNO;

		if (sqlca.sqlcode != 0) {
			fprintf(stderr, "%s %s %s %s %d\n", szACPTNO, szSYSCD, szDSNCD, szRSRCNAME, sqlca.sqlcode);
			memset(szACPTDATE, 0x00, sizeof(szACPTDATE));
			memset(szPRCDATE , 0x00, sizeof(szPRCDATE ));
			memset(szEDITOR  , 0x00, sizeof(szEDITOR  ));
		}

		sprintf(szACPTDATE, "%s", trunc_char(szACPTDATE));
		sprintf(szPRCDATE , "%s", trunc_char(szPRCDATE ));
		sprintf(szEDITOR  , "%s", trunc_char(szEDITOR  ));

		/*-------------------------------------------------------*/
	    /*	TO-BE TABLE INSERT                                   */
	    /*-------------------------------------------------------*/
		EXEC SQL AT TOBE
			INSERT INTO CMR0021
				( CR_ITEMID
				, CR_ACPTNO
				, CR_VER
				, CR_QRYCD
				, CR_ACPTDATE
				, CR_PRCDATE
				, CR_EDITOR
				)
			VALUES
				( :szItemID
				, :szACPTNO
				, :szSORCNAME
				, SUBSTR(:szACPTNO, 5, 2)
				, TO_DATE(:szACPTDATE, 'YYYYMMDDHH24MISS')
				, TO_DATE(:szPRCDATE , 'YYYYMMDDHH24MISS')
				, :szEDITOR
				);


		if (sqlca.sqlcode == 0)
			szSuccessCnt++;
		else {
			fprintf(stderr, "INSERT ERROR %s %s %s %s %s %s %d \n", szItemID, szACPTNO, szSORCNAME, szACPTDATE, szPRCDATE, szEDITOR, sqlca.sqlcode);
			szErrorCnt++;
		}
		EXEC SQL AT TOBE COMMIT;
 	}
 	EXEC SQL AT ASIS close ASIS_CMR0021;

	Get_Sys_Date(szEndDate);
	Get_Sys_Time(szEndTime);

	fprintf(stdout, "TABLE : %-20s TOTAL : %06d   SUCCESS : %06d   ERROR : %06d  ITEMID SKIP : %06d [%s %s ~ %s %s] %d\n"
				  , pTABLENM, szTotalCnt, szSuccessCnt, szErrorCnt, szItemIDErrCnt, szStartDate, szStartTime, szEndDate, szEndTime
				  , Get_RunSecond(szStartDate, szStartTime, szEndDate, szEndTime));

	return (0);
}


/*---------------------------------------------------------------*/
/*	Function  : CMR0025_CONVERT                                  */
/*	Action    : CMR0025 CONVERT                                  */
/*	            소스버전별 파일관리                              */
/*	Parameter : pTABLENM : 테이블명                              */
/*	Return    : 0 : 정상, 1 : 오류                               */
/*---------------------------------------------------------------*/
int 	CMR0025_CONVERT   	( char *pTABLENM
							)
{
char	szSYSCD                    [3+1];
char	szDSNCD                    [5+1];
char	szRSRCNAME               [100+1];
char	szVER                      [5+1];
char	szACPTNO                  [12+1];
int 	szFILESIZE                      ;
char	szFILEDATE                [14+1];
char	szItemID                  [12+1];
char	szMD5SUM                  [32+1];
int 	nVER                            ;
int 	szLstVer                        ;
char	szSysCMD                  [1024];
int 	nLASTCnt                        ;


	Get_Sys_Date(szStartDate);
	Get_Sys_Time(szStartTime);

	szTotalCnt   = 0;
	szSuccessCnt = 0;
	szErrorCnt   = 0;
	nLASTCnt     = 0;
	szItemIDErrCnt = 0;

	/*-----------------------------------------------------------*/
    /*	 AS-IS TABLE  READ                                       */
    /*-----------------------------------------------------------*/
	EXEC SQL AT ASIS
		DECLARE ASIS_CMR0025 CURSOR FOR
			SELECT  A.CR_SYSCD
			      , A.CR_DSNCD
			      , A.CR_RSRCNAME
			      , UPPER(A.CR_VER)
			      , A.CR_ACPTNO
			      , NVL(A.CR_FILESIZE, 0)
			      , TO_CHAR(A.CR_FILEDATE, 'YYYYMMDDHH24MISS')
			      , A.CR_MD5SUM
			      , B.CR_LSTVER
   			  FROM  COVM_IMS.CMR0025 A
   			      , COVM_IMS.CMR0020 B
   			 WHERE  A.CR_SYSCD   = DECODE(:szINSysCD, 'ALL', A.CR_SYSCD, :szINSysCD)
   			   AND  A.CR_SYSCD = B.CR_SYSCD
   			   AND  A.CR_DSNCD = B.CR_DSNCD
   			   AND  A.CR_RSRCNAME = B.CR_RSRCNAME
             ORDER  BY A.CR_SYSCD, A.CR_DSNCD, A.CR_RSRCNAME, A.CR_VER;

	EXEC SQL AT ASIS OPEN ASIS_CMR0025;

	if (sqlca.sqlcode != 0) {
		fprintf(stderr, "ASIS_%s SQL ERROR [%d] [%s]\n", pTABLENM, sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
		exit (1);
	}

    while (1) {
		EXEC SQL AT ASIS FETCH ASIS_CMR0025
			INTO  :szSYSCD
			    , :szDSNCD
			    , :szRSRCNAME
			    , :szVER
			    , :szACPTNO
			    , :szFILESIZE
			    , :szFILEDATE
			    , :szMD5SUM
			    , :szLstVer;

		if (sqlca.sqlcode == 1403) break;

		szTotalCnt++;

		if (sqlca.sqlcode != 0 && sqlca.sqlcode != -1405) {
			fprintf(stderr, "%d %s\n", sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
			szErrorCnt++;
			break;
		}

		sprintf(szSYSCD   , "%s", trunc_char(szSYSCD   ));
		sprintf(szDSNCD   , "%s", trunc_char(szDSNCD   ));
		sprintf(szRSRCNAME, "%s", trunc_char(szRSRCNAME));
		sprintf(szVER     , "%s", trunc_char(szVER     ));
		sprintf(szACPTNO  , "%s", trunc_char(szACPTNO  ));
		sprintf(szFILEDATE, "%s", trunc_char(szFILEDATE));
		sprintf(szMD5SUM  , "%s", trunc_char(szMD5SUM  ));

		if (strcmp(szVER, "LAST") == 0) {
			nVER = szLstVer;
		}
		else {
			nVER = atoi(szVER);
		}

		if (ITEMID_CHECK (szSYSCD, szDSNCD, szRSRCNAME, szItemID, "03") != 0) {
			ITEMID_Check_Err_Log(pTABLENM, "ITEMID CHECK ERROR", szSYSCD, szDSNCD, szRSRCNAME, "", "");
			memset(szItemID, 0x00, sizeof(szItemID));
			szItemIDErrCnt++;
			continue;
		}

		/*-------------------------------------------------------*/
	    /*	이행완료여부 체크                                    */
	    /*-------------------------------------------------------*/
		EXEC SQL AT TOBE
			SELECT  NVL(COUNT(*), 0)
			  INTO  :nCnt
			  FROM  CMR0025
			 WHERE  CR_ITEMID = :szItemID
			   AND  CR_VER    = :nVER;

		if (sqlca.sqlcode != 0)
			nCnt = 0;

		if (nCnt > 0) {
			if (strcmp(szVER, "LAST") == 0) {
				nLASTCnt++;
				
				EXEC SQL AT TOBE
					UPDATE  CMR0025
					   SET  CR_FILE = (SELECT  A.CR_FILE
			  			                 FROM  COVM_IMS.CMR0025 A
			                                 , CMR0020          B
			                            WHERE  A.CR_SYSCD    = :szSYSCD
			                              AND  A.CR_DSNCD    = :szDSNCD
			                              AND  A.CR_RSRCNAME = :szRSRCNAME
			                              AND  UPPER(A.CR_VER) = :szVER
			                              AND  B.CR_SYSCD = LPAD(A.CR_SYSCD, 5, '0')
			                              AND  B.CR_DSNCD = LPAD(A.CR_DSNCD, 7, '0')
			                              AND  B.CR_RSRCNAME = A.CR_RSRCNAME
			                          )			      
			         WHERE  CR_ITEMID = :szItemID
			           AND  CR_VER    = :nVER;
			}
			else {
				fprintf(stderr, ">>>1 %s %s %d %s\n", szItemID, szRSRCNAME, nVER, szVER);
			}
			continue;
		}


		Get_Sys_Date(szEndDate);
		Get_Sys_Time(szEndTime);
	
		EXEC SQL AT TOBE	
			SELECT  COUNT(*)
			  INTO  :nCnt
			  FROM  COVM_IMS.CMR0025 A
			      , CMR0020          B
			 WHERE  A.CR_SYSCD    = :szSYSCD
			   AND  A.CR_DSNCD    = :szDSNCD
			   AND  A.CR_RSRCNAME = :szRSRCNAME
			   AND  UPPER(A.CR_VER) = :szVER
			   AND  B.CR_SYSCD = LPAD(A.CR_SYSCD, 5, '0')
			   AND  B.CR_DSNCD = LPAD(A.CR_DSNCD, 7, '0')
			   AND  B.CR_RSRCNAME = A.CR_RSRCNAME;
	
		if (sqlca.sqlcode != 0)
			nCnt = 0;
			
		if (nCnt == 0) {
			fprintf(stderr, ">>> %d %s %s %s %s %s\n", sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc,
			         szSYSCD, szDSNCD, szRSRCNAME, szVER);
			continue;
		}
		
		/*-------------------------------------------------------*/
	    /*	TO-BE TABLE INSERT                                   */
	    /*-------------------------------------------------------*/
		EXEC SQL AT TOBE
			INSERT INTO CMR0025
				  ( CR_ITEMID
				  , CR_ACPTNO
				  , CR_VER
				  , CR_FILE
				  , CR_FILESIZE
				  , CR_FILEDATE
				  , CR_MD5SUM
				  )
	 		SELECT  B.CR_ITEMID
	 		      , A.CR_ACPTNO
	 		      , :nVER
	 		      , A.CR_FILE
				  , A.CR_FILESIZE
				  , A.CR_FILEDATE
				  , A.CR_MD5SUM
			  FROM  COVM_IMS.CMR0025 A
			      , CMR0020          B
			 WHERE  A.CR_SYSCD    = :szSYSCD
			   AND  A.CR_DSNCD    = :szDSNCD
			   AND  A.CR_RSRCNAME = :szRSRCNAME
			   AND  UPPER(A.CR_VER) = :szVER
			   AND  B.CR_SYSCD = LPAD(A.CR_SYSCD, 5, '0')
			   AND  B.CR_DSNCD = LPAD(A.CR_DSNCD, 7, '0')
			   AND  B.CR_RSRCNAME = A.CR_RSRCNAME;

		if (sqlca.sqlcode == 0)
			szSuccessCnt++;
		else {
			fprintf(stderr, "%d %s %s %s %s %s\n", sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc,
			         szSYSCD, szDSNCD, szRSRCNAME, szVER);
			szErrorCnt++;
			continue;
		}

		EXEC SQL AT TOBE COMMIT;
 	}
 	EXEC SQL AT ASIS close ASIS_CMR0025;

	Get_Sys_Date(szEndDate);
	Get_Sys_Time(szEndTime);

	fprintf(stdout, "TABLE : %-20s TOTAL : %06d   SUCCESS : %06d   ERROR : %06d LAST SKIP : %06d ITEMID ERROR SKIP : %06d [%s %s ~ %s %s] %d\n"
				  , pTABLENM, szTotalCnt, szSuccessCnt, szErrorCnt, nLASTCnt, szItemIDErrCnt, szStartDate, szStartTime, szEndDate, szEndTime
				  , Get_RunSecond(szStartDate, szStartTime, szEndDate, szEndTime));

	return (0);

}


/*---------------------------------------------------------------*/
/*	Function  : CMR0026_CONVERT                                  */
/*	Action    : CMR0026 CONVERT                                  */
/*	            소스버전관리                                     */
/*	Parameter : pTABLENM : 테이블명                              */
/*	Return    : 0 : 정상, 1 : 오류                               */
/*---------------------------------------------------------------*/
int 	CMR0026_CONVERT     ( char *pTABLENM
							)
{

	Get_Sys_Date(szStartDate);
	Get_Sys_Time(szStartTime);

	szTotalCnt   = 0;
	szSuccessCnt = 0;
	szErrorCnt   = 0;
	szItemIDErrCnt = 0;

	EXEC SQL
		INSERT  INTO  COVM_IMS_CMR0026
		SELECT  *  FROM  COVM_IMS.CMR0026;

	Get_Sys_Date(szEndDate);
	Get_Sys_Time(szEndTime);

	fprintf(stdout, "TABLE : %-20s TOTAL : %06d   SUCCESS : %06d   ERROR : %06d ITEMID SKIP : %06d [%s %s ~ %s %s] %d\n"
				  , pTABLENM, szTotalCnt, szSuccessCnt, szErrorCnt, szItemIDErrCnt, szStartDate, szStartTime, szEndDate, szEndTime
				  , Get_RunSecond(szStartDate, szStartTime, szEndDate, szEndTime));

}


/*---------------------------------------------------------------*/
/*	Function  : CMR0027_CONVERT                                  */
/*	Action    : CMR0027 CONVERT                                  */
/*	            신청건별 신청파일관리                            */
/*	Parameter : pTABLENM : 테이블명                              */
/*	Return    : 0 : 정상, 1 : 오류                               */
/*---------------------------------------------------------------*/
int 	CMR0027_CONVERT     ( char *pTABLENM
							)
{
char	szACPTNO                  [12+1];
char	szSYSCD                    [3+1];
char	szDSNCD                    [5+1];
char	szRSRCNAME               [100+1];
int 	szFILESIZE                      ;
char	szFILEDATE                [14+1];
char	szSysCMD                  [1024];
char	szItemID                  [12+1];
int 	nVER                            ;


	Get_Sys_Date(szStartDate);
	Get_Sys_Time(szStartTime);

	szTotalCnt   = 0;
	szSuccessCnt = 0;
	szErrorCnt   = 0;
	szItemIDErrCnt = 0;


	/*-----------------------------------------------------------*/
    /*	 AS-IS TABLE  READ                                       */
    /*-----------------------------------------------------------*/
	EXEC SQL AT ASIS
		DECLARE ASIS_CMR0027 CURSOR FOR
			SELECT  A.CR_ACPTNO
			      , A.CR_SYSCD
			      , A.CR_DSNCD
			      , A.CR_RSRCNAME
			      , A.CR_FILESIZE
			      , A.CR_FILEDATE
			      , NVL(B.CR_LSTVER, 0) + 1
   			  FROM  COVM_IMS.CMR0027 A
   			      , COVM_IMS.CMR0020 B
   			      , COVM_IMS.CMR1000 C
   			 WHERE  A.CR_SYSCD    = B.CR_SYSCD
   			   AND  A.CR_DSNCD    = B.CR_DSNCD
   			   AND  A.CR_RSRCNAME = B.CR_RSRCNAME
   			   AND  A.CR_ACPTNO   = C.CR_ACPTNO
   			   AND  C.CR_STATUS   = '0'
   			   AND  B.CR_SYSCD = DECODE(:szINSysCD, 'ALL', B.CR_SYSCD, :szINSysCD);

	EXEC SQL AT ASIS OPEN ASIS_CMR0027;

	if (sqlca.sqlcode != 0) {
		fprintf(stderr, "ASIS_%s SQL ERROR [%d] [%s]\n", pTABLENM, sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
		exit (1);
	}

    while (1) {
		EXEC SQL AT ASIS FETCH ASIS_CMR0027
			INTO  :szACPTNO
			    , :szSYSCD
			    , :szDSNCD
			    , :szRSRCNAME
			    , :szFILESIZE
			    , :szFILEDATE
			    , :nVER      ;

		if (sqlca.sqlcode == 1403) break;

		szTotalCnt++;

		if (sqlca.sqlcode != 0 && sqlca.sqlcode != -1405) {
			fprintf(stderr, "%d %s\n", sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
			szErrorCnt++;
			break;
		}

		sprintf(szACPTNO  , "%s", trunc_char(szACPTNO  ));
		sprintf(szSYSCD   , "%s", trunc_char(szSYSCD   ));
		sprintf(szDSNCD   , "%s", trunc_char(szDSNCD   ));
		sprintf(szRSRCNAME, "%s", trunc_char(szRSRCNAME));
		sprintf(szFILEDATE, "%s", trunc_char(szFILEDATE));

		if (ITEMID_CHECK (szSYSCD, szDSNCD, szRSRCNAME, szItemID, "03") != 0) {
			ITEMID_Check_Err_Log(pTABLENM, "ITEMID CHECK ERROR", szSYSCD, szDSNCD, szRSRCNAME, "", "");
			memset(szItemID, 0x00, sizeof(szItemID));
			szItemIDErrCnt++;
			continue;
		}

		Get_Sys_Date(szEndDate);
		Get_Sys_Time(szEndTime);

		/*-------------------------------------------------------*/
	    /*	TO-BE TABLE INSERT                                   */
	    /*-------------------------------------------------------*/
		EXEC SQL AT TOBE
			INSERT INTO CMR0027
				( CR_ACPTNO
				, CR_ITEMID
				, CR_FILE
				, CR_VER
				, CR_FILESIZE
				, CR_FILEDATE
				, CR_MD5SUM
				)
	 		SELECT  A.CR_ACPTNO
	 		      , B.CR_ITEMID
	 		      , A.CR_FILE
	 		      , C.CR_VERSION
				  , A.CR_FILESIZE
				  , A.CR_FILEDATE
				  , NULL
			  FROM  COVM_IMS.CMR0027 A
			      , CMR0020          B
			      , CMR1010          C
			 WHERE  A.CR_ACPTNO   = :szACPTNO
			   AND  A.CR_SYSCD    = :szSYSCD
			   AND  A.CR_DSNCD    = :szDSNCD
			   AND  A.CR_RSRCNAME = :szRSRCNAME
			   AND  B.CR_SYSCD = LPAD(A.CR_SYSCD, 5, '0')
			   AND  B.CR_DSNCD = LPAD(A.CR_DSNCD, 7, '0')
			   AND  B.CR_RSRCNAME = A.CR_RSRCNAME
			   AND  A.CR_ACPTNO   = C.CR_ACPTNO
			   AND  B.CR_ITEMID   = C.CR_ITEMID;

		if (sqlca.sqlcode  != 0) {
			szErrorCnt++;
		}
		else {
			szSuccessCnt++;
		}
		EXEC SQL AT TOBE COMMIT;
 	}
 	EXEC SQL AT ASIS close ASIS_CMR0027;

	Get_Sys_Date(szEndDate);
	Get_Sys_Time(szEndTime);

	fprintf(stdout, "TABLE : %-20s TOTAL : %06d   SUCCESS : %06d   ERROR : %06d ITEMID SKIP : %06d [%s %s ~ %s %s] %d\n"
				  , pTABLENM, szTotalCnt, szSuccessCnt, szErrorCnt, szItemIDErrCnt, szStartDate, szStartTime, szEndDate, szEndTime
				  , Get_RunSecond(szStartDate, szStartTime, szEndDate, szEndTime));

	return (0);

}


/*---------------------------------------------------------------*/
/*	Function  : CMR0028_CONVERT                                  */
/*	Action    : CMR0028 CONVERT                                  */
/*	            개발버젼관리                                     */
/*	Parameter : pTABLENM : 테이블명                              */
/*	Return    : 0 : 정상, 1 : 오류                               */
/*---------------------------------------------------------------*/
int 	CMR0028_CONVERT     ( char *pTABLENM
							)
{

	Get_Sys_Date(szStartDate);
	Get_Sys_Time(szStartTime);

	fprintf(stderr, "%s 테이블은 CONVERSION 대상 아님 \n", pTABLENM);

	return (1);

}


/*---------------------------------------------------------------*/
/*	Function  : CMR1000_CONVERT                                  */
/*	Action    : CMR1000 CONVERT                                  */
/*	            변경신청관리기본                                 */
/*	Parameter : pTABLENM : 테이블명                              */
/*	Return    : 0 : 정상, 1 : 오류                               */
/*---------------------------------------------------------------*/
int 	CMR1000_CONVERT     ( char *pTABLENM
							)
{
char	szACPTNO	              [12+1];
char	szSYSCD	                   [3+1];
char	szSYSGB	                   [1+1];
char	szJOBCD	                   [5+1];
char	szACPTDATE	              [14+1];
char	szSTATUS	               [1+1];
char	szTEAMCD              	  [15+1];
char	szQRYCD	                   [2+1];
char	szPASSOK              	   [1+1];
char	szPASSCD              	 [100+1];
char	szNOAUTO                   [1+1];
char	szPRCREQ                  [14+1];
char	szEDDATE                  [14+1];
char	szPRCDATE                 [14+1];
char	szEDITOR	              [10+1];
char	szGYULJAE	               [1+1];
char	szBEFJOB	               [1+1];
char	szSAYU	                 [500+1];
int 	szPID	                        ;
char	szCNCL	                   [1+1];
char	szSAYUCD	               [2+1];
char	szGYULTIME	              [14+1];
char	szGYULUSER                [10+1];
char	szPRJNO	                  [13+1];
char	szPRJNM              	 [200+1];
int 	szEDCNT	                        ;
char	szAFTCHG	               [1+1];
char	szPASSSUB                  [1+1];
char	szREQGBN	               [1+1];
char	szDOCNO                  [100+1];
char	szRELATNO              	  [12+1];
char	szSMSSEND              	   [1+1];
char	szRETRYMSG               [200+1];
char	szSYSMASTER                [1+1];
char	szSKIPSAYU               [200+1];
char	szCONFYN                   [1+1];
char	szMANSKIP                  [1+1];

	Get_Sys_Date(szStartDate);
	Get_Sys_Time(szStartTime);


	szTotalCnt   = 0;
	szSuccessCnt = 0;
	szErrorCnt   = 0;



	/*-----------------------------------------------------------*/
    /*	 AS-IS TABLE  READ                                       */
    /*-----------------------------------------------------------*/
	EXEC SQL AT ASIS
		DECLARE ASIS_CMR1000 CURSOR FOR
			SELECT  CR_ACPTNO
			      , CR_SYSCD
			      , CR_SYSGB
			      , CR_JOBCD
			      , TO_CHAR(CR_ACPTDATE, 'YYYYMMDDHH24MISS')
			      , CR_STATUS
			      , CR_TEAMCD
			      , CR_QRYCD
			      , CR_PASSOK
			      , CR_PASSCD
			      , CR_NOAUTO
			      , CR_PRCREQ
			      , TO_CHAR(CR_EDDATE , 'YYYYMMDDHH24MISS')
			      , TO_CHAR(CR_PRCDATE, 'YYYYMMDDHH24MISS')
			      , CR_EDITOR
			      , CR_GYULJAE
			      , CR_BEFJOB
			      , CR_SAYU
			      , NVL(CR_PID, 0)
			      , CR_CNCL
			      , CR_SAYUCD
			      , TO_CHAR(CR_GYULTIME, 'YYYYMMDDHH24MISS')
			      , CR_GYULUSER
			      , CR_PRJNO
			      , CR_PRJNM
			      , NVL(CR_EDCNT, 0)
			      , CR_AFTCHG
			      , CR_PASSSUB
			      , CR_REQGBN
			      , CR_DOCNO
			      , CR_RELATNO
			      , CR_SMSSEND
			      , CR_RETRYMSG
			      , CR_SYSMASTER
			      , CR_SKIPSAYU
   			  FROM  COVM_IMS.CMR1000 A
   			 WHERE  CR_SYSCD  = DECODE(:szINSysCD, 'ALL', CR_SYSCD, :szINSysCD)
   			   AND  NOT EXISTS (SELECT  'X'
   			                      FROM  CMR1000
   			                     WHERE  CR_ACPTNO = A.CR_ACPTNO
   			                   );

	EXEC SQL AT ASIS OPEN ASIS_CMR1000;

	if (sqlca.sqlcode != 0) {
		fprintf(stderr, "ASIS_%s SQL ERROR [%d] [%s]\n", pTABLENM, sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
		exit (1);
	}

    while (1) {
		EXEC SQL AT ASIS FETCH ASIS_CMR1000
			INTO  :szACPTNO
			    , :szSYSCD
			    , :szSYSGB
			    , :szJOBCD
			    , :szACPTDATE
			    , :szSTATUS
			    , :szTEAMCD
			    , :szQRYCD
			    , :szPASSOK
			    , :szPASSCD
			    , :szNOAUTO
			    , :szPRCREQ
			    , :szEDDATE
			    , :szPRCDATE
			    , :szEDITOR
			    , :szGYULJAE
			    , :szBEFJOB
			    , :szSAYU
			    , :szPID
			    , :szCNCL
			    , :szSAYUCD
			    , :szGYULTIME
			    , :szGYULUSER
			    , :szPRJNO
			    , :szPRJNM
			    , :szEDCNT
			    , :szAFTCHG
			    , :szPASSSUB
			    , :szREQGBN
			    , :szDOCNO
			    , :szRELATNO
			    , :szSMSSEND
			    , :szRETRYMSG
			    , :szSYSMASTER
			    , :szSKIPSAYU;

		if (sqlca.sqlcode == 1403) break;

		szTotalCnt++;

		if (sqlca.sqlcode != 0 && sqlca.sqlcode != -1405) {
			fprintf(stderr, "%d %s\n", sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
			szErrorCnt++;
			break;
		}

		sprintf(szACPTNO   , "%s", trunc_char(szACPTNO   ));
		sprintf(szSYSCD    , "%s", trunc_char(szSYSCD    ));
		sprintf(szSYSGB    , "%s", trunc_char(szSYSGB    ));
		sprintf(szJOBCD    , "%s", trunc_char(szJOBCD    ));
		sprintf(szACPTDATE , "%s", trunc_char(szACPTDATE ));
		sprintf(szSTATUS   , "%s", trunc_char(szSTATUS   ));
		sprintf(szTEAMCD   , "%s", trunc_char(szTEAMCD   ));
		sprintf(szQRYCD    , "%s", trunc_char(szQRYCD    ));
		sprintf(szPASSOK   , "%s", trunc_char(szPASSOK   ));
		sprintf(szPASSCD   , "%s", trunc_char(szPASSCD   ));
		sprintf(szNOAUTO   , "%s", trunc_char(szNOAUTO   ));
		sprintf(szPRCREQ   , "%s", trunc_char(szPRCREQ   ));
		sprintf(szEDDATE   , "%s", trunc_char(szEDDATE   ));
		sprintf(szPRCDATE  , "%s", trunc_char(szPRCDATE  ));
		sprintf(szEDITOR   , "%s", trunc_char(szEDITOR   ));
		sprintf(szGYULJAE  , "%s", trunc_char(szGYULJAE  ));
		sprintf(szBEFJOB   , "%s", trunc_char(szBEFJOB   ));
		sprintf(szSAYU     , "%s", trunc_char(szSAYU     ));
		sprintf(szCNCL     , "%s", trunc_char(szCNCL     ));
		sprintf(szSAYUCD   , "%s", trunc_char(szSAYUCD   ));
		sprintf(szGYULTIME , "%s", trunc_char(szGYULTIME ));
		sprintf(szGYULUSER , "%s", trunc_char(szGYULUSER ));
		sprintf(szPRJNO    , "%s", trunc_char(szPRJNO    ));
		sprintf(szPRJNM    , "%s", trunc_char(szPRJNM    ));
		sprintf(szAFTCHG   , "%s", trunc_char(szAFTCHG   ));
		sprintf(szPASSSUB  , "%s", trunc_char(szPASSSUB  ));
		sprintf(szREQGBN   , "%s", trunc_char(szREQGBN   ));
		sprintf(szDOCNO    , "%s", trunc_char(szDOCNO    ));
		sprintf(szRELATNO  , "%s", trunc_char(szRELATNO  ));
		sprintf(szSMSSEND  , "%s", trunc_char(szSMSSEND  ));
		sprintf(szRETRYMSG , "%s", trunc_char(szRETRYMSG ));
		sprintf(szSYSMASTER, "%s", trunc_char(szSYSMASTER));
		sprintf(szSKIPSAYU , "%s", trunc_char(szSKIPSAYU ));
		sprintf(szCONFYN   , "%s", trunc_char(szCONFYN   ));
		sprintf(szMANSKIP  , "%s", trunc_char(szMANSKIP  ));


		Get_Sys_Date(szEndDate);
		Get_Sys_Time(szEndTime);

		/*-------------------------------------------------------*/
	    /*	TO-BE TABLE INSERT                                   */
	    /*-------------------------------------------------------*/
		EXEC SQL AT TOBE
			INSERT INTO CMR1000
				( CR_ACPTNO
				, CR_SYSCD
				, CR_SYSGB
				, CR_ACPTDATE
				, CR_STATUS
				, CR_TEAMCD
				, CR_QRYCD
				, CR_PASSOK
				, CR_PASSCD
				, CR_NOAUTO
				, CR_PRCREQ
				, CR_EDDATE
				, CR_PRCDATE
				, CR_EDITOR
				, CR_GYULJAE
				, CR_BEFJOB
				, CR_SAYU
				, CR_CNCL
				, CR_SAYUCD
				, CR_GYULTIME
				, CR_GYULUSER
				, CR_EDCNT
				, CR_RELATNO
				, CR_NOTIFY
				, CR_PASSSUB
				, CR_JOBCD
				, CR_PID
				, CR_TESTID
				, CR_EMGCD
				, CR_LASTDATE
				, CR_CNCLSTEP
				, CR_CNCLLSTD
				, CR_RETRYYN
				, CR_SVRCD
				, CR_SVRSEQ
				, CR_SYSSTEP
				, CR_PRJNO
				, CR_PRJNAME
				, CR_DOCNO
				, CR_SYSMASTER
				, CR_SKIPSAYU
				, CR_SMSSEND
				, CR_RETRYMSG
				, CR_CONFYN
				, CR_MANSKIP
				)
			VALUES
				( :szACPTNO
			    , LPAD(:szSYSCD, 5, '0')
			    , :szSYSGB
			    , TO_DATE(:szACPTDATE, 'YYYYMMDDHH24MISS')
			    , :szSTATUS
			    , :szTEAMCD
			    , :szQRYCD
			    , :szPASSOK
			    , :szPASSCD
			    , :szNOAUTO
			    , :szPRCREQ
			    , TO_DATE(:szEDDATE , 'YYYYMMDDHH24MISS')
			    , TO_DATE(:szPRCDATE, 'YYYYMMDDHH24MISS')
			    , :szEDITOR
			    , :szGYULJAE
			    , :szBEFJOB
			    , :szSAYU
			    , :szCNCL
			    , :szREQGBN
			    , TO_DATE(:szGYULTIME, 'YYYYMMDDHH24MISS')
			    , :szGYULUSER
			    , :szEDCNT
			    , :szRELATNO
			    , NULL
			    , :szPASSSUB
			    , :szJOBCD
			    , :szPID
			    , NULL
			    , NULL
			    , NULL
			    , NULL
			    , NULL
			    , NULL
			    , NULL
			    , NULL
			    , NULL
			    , :szPRJNO
			    , :szPRJNM
			    , :szDOCNO
				, :szSYSMASTER
				, :szSKIPSAYU
				, :szSMSSEND
				, :szRETRYMSG
				, 'N'
				, DECODE(LENGTH(:szSKIPSAYU), 0, 'N', 'Y')
				);
		
		if (sqlca.sqlcode == 0)
			szSuccessCnt++;
		else {
			fprintf(stderr, "<%s> %d %s\n", szACPTNO, sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
			szErrorCnt++;
		}
		EXEC SQL AT TOBE  COMMIT;
 	}
 	EXEC SQL AT ASIS close ASIS_CMR1000;

	Get_Sys_Date(szEndDate);
	Get_Sys_Time(szEndTime);

	fprintf(stdout, "TABLE : %-20s TOTAL : %06d   SUCCESS : %06d   ERROR : %06d [%s %s ~ %s %s] %d\n"
				  , pTABLENM, szTotalCnt, szSuccessCnt, szErrorCnt, szStartDate, szStartTime, szEndDate, szEndTime
				  , Get_RunSecond(szStartDate, szStartTime, szEndDate, szEndTime));

	return (0);
}



/*---------------------------------------------------------------*/
/*	Function  : CMR1001_CONVERT                                  */
/*	Action    : CMR1001 CONVERT                                  */
/*	            첨부파일관리                                     */
/*	Parameter : pTABLENM : 테이블명                              */
/*	Return    : 0 : 정상, 1 : 오류                               */
/*---------------------------------------------------------------*/
int 	CMR1001_CONVERT     ( char *pTABLENM
							)
{
char 	szACPTNO                  [12+1];
int  	szSEQNO                         ;
char 	szFILENAME               [400+1];
char 	szRELDOC                  [20+1];
char 	szDOCGB                    [1+1];
char 	szCONFIRM                  [1+1];


	Get_Sys_Date(szStartDate);
	Get_Sys_Time(szStartTime);

	szTotalCnt   = 0;
	szSuccessCnt = 0;
	szErrorCnt   = 0;


	/*-----------------------------------------------------------*/
    /*	 AS-IS TABLE  READ                                       */
    /*-----------------------------------------------------------*/
	EXEC SQL AT ASIS
		DECLARE ASIS_CMR1001 CURSOR FOR
			SELECT  CR_ACPTNO
			      , NVL(CR_SEQNO, 0)
			      , CR_FILENAME
			      , CR_RELDOC
			      , NVL(CR_DOCGB, '1')
			      , CR_CONFIRM
   			  FROM  COVM_IMS.CMR1001 A
		     WHERE  EXISTS (SELECT  'X'
		                      FROM  COVM_IMS.CMR1000
                             WHERE  CR_SYSCD  = DECODE(:szINSysCD, 'ALL', CR_SYSCD, :szINSysCD)
                               AND  CR_ACPTNO = A.CR_ACPTNO
                           );

	EXEC SQL AT ASIS OPEN ASIS_CMR1001;

	if (sqlca.sqlcode != 0) {
		fprintf(stderr, "ASIS_%s SQL ERROR [%d] [%s]\n", pTABLENM, sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
		exit (1);
	}

    while (1) {
		EXEC SQL AT ASIS FETCH ASIS_CMR1001
			INTO  :szACPTNO
			    , :szSEQNO
			    , :szFILENAME
			    , :szRELDOC
			    , :szDOCGB
			    , :szCONFIRM ;

		if (sqlca.sqlcode == 1403) break;

		szTotalCnt++;

		if (sqlca.sqlcode != 0 && sqlca.sqlcode != -1405) {
			fprintf(stderr, "%d %s\n", sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
			szErrorCnt++;
			break;
		}

		sprintf(szACPTNO  , "%s", trunc_char(szACPTNO  ));
		sprintf(szFILENAME, "%s", trunc_char(szFILENAME));
		sprintf(szRELDOC  , "%s", trunc_char(szRELDOC  ));
		sprintf(szDOCGB   , "%s", trunc_char(szDOCGB   ));
		sprintf(szCONFIRM , "%s", trunc_char(szCONFIRM ));

		/*-------------------------------------------------------*/
	    /*	TO-BE TABLE INSERT                                   */
	    /*-------------------------------------------------------*/
		EXEC SQL AT TOBE
			INSERT INTO CMR1001
				( CR_ACPTNO
				, CR_GUBUN
				, CR_SEQNO
				, CR_FILENAME
				, CR_RELDOC
				, CR_CONTEXT
				)
			VALUES
				( :szACPTNO
				, :szDOCGB
				, :szSEQNO
				, :szFILENAME
				, :szRELDOC
				, NULL
				);

		if (sqlca.sqlcode == 0)
			szSuccessCnt++;
		else {
			fprintf(stderr, "%d %s\n", sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
			szErrorCnt++;
		}

		EXEC SQL AT TOBE  COMMIT;
 	}
 	EXEC SQL AT ASIS close ASIS_CMR1001;

	Get_Sys_Date(szEndDate);
	Get_Sys_Time(szEndTime);

	fprintf(stdout, "TABLE : %-20s TOTAL : %06d   SUCCESS : %06d   ERROR : %06d [%s %s ~ %s %s] %d\n"
				  , pTABLENM, szTotalCnt, szSuccessCnt, szErrorCnt, szStartDate, szStartTime, szEndDate, szEndTime
				  , Get_RunSecond(szStartDate, szStartTime, szEndDate, szEndTime));

	return (0);

}



/*---------------------------------------------------------------*/
/*	Function  : CMR1010_CONVERT                                  */
/*	Action    : CMR1010 CONVERT                                  */
/*	            프로그램 변경신청 내역                           */
/*	Parameter : pTABLENM : 테이블명                              */
/*	Return    : 0 : 정상, 1 : 오류                               */
/*---------------------------------------------------------------*/
int 	CMR1010_CONVERT     ( char *pTABLENM
							)
{

	Get_Sys_Date(szStartDate);
	Get_Sys_Time(szStartTime);

	szTotalCnt   = 0;
	szSuccessCnt = 0;
	szErrorCnt   = 0;


	/*-----------------------------------------------------------*/
    /*	TO-BE TABLE INSERT                                       */
    /*-----------------------------------------------------------*/
	EXEC SQL AT ASIS
		DECLARE ASIS_CMR1010_YEAR CURSOR FOR
			SELECT  DISTINCT
			        TO_CHAR(CR_ACPTDATE, 'YYYYMM')
			  FROM  COVM_IMS.CMR1000
			 WHERE  CR_SYSCD = DECODE(:szINSysCD, 'ALL', CR_SYSCD, :szINSysCD)
			 ORDER  BY TO_CHAR(CR_ACPTDATE, 'YYYYMM');

	EXEC SQL AT ASIS OPEN ASIS_CMR1010_YEAR;
	while (1) {
		EXEC SQL AT ASIS FETCH ASIS_CMR1010_YEAR
			INTO  :szINYYYY;

		if (sqlca.sqlcode == 1403) break;

		if (sqlca.sqlcode != 0 && sqlca.sqlcode != -1405) {
			fprintf(stderr, "%d %s\n", sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
			szErrorCnt++;
			break;
		}

		NotUseDataTruncate (szINYYYY, 0x20);

		EXEC SQL AT TOBE
			INSERT INTO CMR1010
					( CR_ACPTNO  
					, CR_SERNO   
					, CR_SYSCD   
					, CR_SYSGB   
					, CR_JOBCD   
					, CR_PRCDATE 
					, CR_STATUS  
					, CR_QRYCD   
					, CR_RSRCCD  
					, CR_DSNCD   
					, CR_DSNCD2  
					, CR_RSRCNAME
					, CR_RSRCNAM2
					, CR_PID     
					, CR_CHGCD   
					, CR_TSTCHG  
					, CR_SRCCHG  
					, CR_VERSION 
					, CR_PRIORITY
					, CR_APLYDATE
					, CR_EDITCON 
					, CR_CONFNO  
					, CR_EDITOR  
					, CR_PUTCODE 
					, CR_CNCLYN  
					, CR_PARM    
					, CR_SYSSTEP 
					, CR_OPEN    
					, CR_TMPDELYN
					, CR_BASENO  
					, CR_COACPT  
					, CR_BASEPGM 
					, CR_BASEDSN 
					, CR_BASEITEM
					, CR_BEFVER  
					, CR_ITEMID  
					, CR_LANGCD  
					, CR_PRCSTEP 
					, CR_SRCCMP  
					, CR_CNCLSTEP
					, CR_ANALYN  
					, CR_PGMTYPE 
					, CR_SUBSYS  
					, CR_SUBDSN  
					, CR_EDITDATE
					, CR_RUNGBN  
					, CR_IMPJOB  
					, CR_IMPPGM  
					, CR_PGMINFO 
					, CR_PGMINFO2
					)
		      SELECT  CR_ACPTNO
			        , CR_SERNO
			        , LPAD(CR_SYSCD, 5, '0')
			        , CR_SYSGB
			        , CR_JOBCD
			        , CR_PRCDATE
			        , CR_STATUS
			        , CR_QRYCD
			        , CR_RSRCCD
			        , LPAD(CR_DSNCD , 7, '0')
			        , LPAD(CR_DSNCD2, 7, '0')
			        , CR_RSRCNAME
			        , CR_RSRCNAM2
			        , CR_PID
			        , CR_CHGCD
			        , CR_TSTCHG
			        , CR_SRCCHG
			        , CONV_VERSION(CR_ACPTNO, LPAD(A.CR_SYSCD, 5, '0'), LPAD(A.CR_DSNCD, 7, '0'), A.CR_RSRCNAME)
			        , CR_PRIORITY
			        , CR_APLYDATE
			        , CR_EDITCON
			        , CR_CONFNO
			        , CR_EDITOR
			        , CR_PUTCODE
			        , CR_CNCLYN
			        , CR_PARM
			        , CR_SYSSTEP
			        , NULL
			        , CR_TMPDELYN
			        , NULL
			        , CR_COACPT
			        , CR_BASEPGM
			        , CR_BASEDSN
			        , CONV_ITEMID(LPAD(A.CR_SYSCD  , 5, '0'), LPAD(A.CR_BASEDSN, 7, '0'), A.CR_BASEPGM)
			        , NULL
			        , CONV_ITEMID(LPAD(A.CR_SYSCD  , 5, '0'), LPAD(A.CR_DSNCD  , 7, '0'), A.CR_RSRCNAME)
			        , NULL
			        , CR_PRCSTEP
			        , CR_SRCCMP
			        , NULL
			        , NULL
			        , CR_PGMTYPE
			        , NULL
			        , NULL
			        , NULL
			        , NULL
					, CR_IMPJOB  
					, CR_IMPPGM  
			        , NULL
			        , NULL
		        FROM  COVM_IMS.CMR1010 A
		       WHERE  EXISTS (SELECT  'X'
			                    FROM  COVM_IMS.CMR1000
	                           WHERE  CR_SYSCD = DECODE(:szINSysCD, 'ALL', CR_SYSCD, :szINSysCD)
	                           	 AND  TO_CHAR(CR_ACPTDATE, 'YYYYMM') = :szINYYYY
	                             AND  CR_ACPTNO = A.CR_ACPTNO
	                         )
	             AND  NOT EXISTS (SELECT  'X'
	                                FROM  CMR1010
	                               WHERE  CR_ACPTNO = A.CR_ACPTNO
	                                 AND  CR_SERNO  = A.CR_SERNO
	                             );

		Get_Sys_Date(szEndDate);
		Get_Sys_Time(szEndTime);

		fprintf(stderr, "%s %s %s %s > SQLCODE : [%d]\n", szEndDate, szEndTime, szINSysCD, szINYYYY, sqlca.sqlcode);

		EXEC SQL AT TOBE COMMIT;

	}
	EXEC SQL AT ASIS CLOSE ASIS_CMR1010_YEAR;

	EXEC SQL AT TOBE
		UPDATE  CMR1010 A
		   SET  CR_BASEITEM = CR_ITEMID
		 WHERE  EXISTS    (SELECT  'X'
		                     FROM  CMR1000
                            WHERE  CR_SYSCD = DECODE(:szINSysCD, 'ALL', CR_SYSCD, LPAD(:szINSysCD, 5, '0'))
                              AND  CR_ACPTNO = A.CR_ACPTNO
                           )
           AND  CR_BASEITEM IS NULL;


	Get_Sys_Date(szEndDate);
	Get_Sys_Time(szEndTime);

	fprintf(stdout, "TABLE : %-20s TOTAL : %06d   SUCCESS : %06d   ERROR : %06d [%s %s ~ %s %s] %d\n"
				  , pTABLENM, szTotalCnt, szSuccessCnt, szErrorCnt, szStartDate, szStartTime, szEndDate, szEndTime
				  , Get_RunSecond(szStartDate, szStartTime, szEndDate, szEndTime));

	return (0);

}




/*---------------------------------------------------------------*/
/*	Function  : CMR1011_CONVERT                                  */
/*	Action    : CMR1011 CONVERT                                  */
/*	            신청별 배포관리                                  */
/*	Parameter : pTABLENM : 테이블명                              */
/*	Return    : 0 : 정상, 1 : 오류                               */
/*---------------------------------------------------------------*/
int 	CMR1011_CONVERT     ( char *pTABLENM
							)
{


	Get_Sys_Date(szStartDate);
	Get_Sys_Time(szStartTime);

	szTotalCnt   = 0;
	szSuccessCnt = 0;
	szErrorCnt   = 0;



	/*-----------------------------------------------------------*/
    /*	TO-BE TABLE INSERT                                       */
    /*-----------------------------------------------------------*/
	EXEC SQL AT ASIS
		DECLARE ASIS_CMR1011_YEAR CURSOR FOR
			SELECT  DISTINCT
			        TO_CHAR(CR_ACPTDATE, 'YYYYMM')
			  FROM  COVM_IMS.CMR1000
			 WHERE  CR_SYSCD = DECODE(:szINSysCD, 'ALL', CR_SYSCD, :szINSysCD)
			 ORDER  BY TO_CHAR(CR_ACPTDATE, 'YYYYMM');

	EXEC SQL AT ASIS OPEN ASIS_CMR1011_YEAR;
	while (1) {
		EXEC SQL AT ASIS FETCH ASIS_CMR1011_YEAR
			INTO  :szINYYYY;

		if (sqlca.sqlcode == 1403) break;

		if (sqlca.sqlcode != 0 && sqlca.sqlcode != -1405) {
			fprintf(stderr, "%d %s\n", sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
			szErrorCnt++;
			break;
		}

		NotUseDataTruncate (szINYYYY, 0x20);

		EXEC SQL AT TOBE
			INSERT INTO CMR1011
				( CR_ACPTNO
				, CR_SEQNO
				, CR_SYSCD
				, CR_IPADDR
				, CR_PRCSYS
				, CR_PRCDATE
				, CR_RSTFILE
				, CR_PRCRST
				, CR_PID
				, CR_PUTCODE
				, CR_REPEAT
				, CR_FILESIZE
				, CR_FILEDATE
				, CR_SERNO
				, CR_WAIT
				, CR_SVRNAME
				, CR_PORTNO
				, CR_SVRCD
				, CR_SVRSEQ
				, CR_RUNGBN
				)
		  SELECT  CR_ACPTNO
			    , CR_SEQNO
			    , LPAD(CR_SYSCD, 5, '0')
			    , CR_IPADDR
			    , CR_PRCSYS
			    , CR_PRCDATE
			    , CR_RSTFILE
			    , CR_PRCRST
			    , CR_PID
			    , CR_PUTCODE
			    , CR_REPEAT
			    , CR_FILESIZE
			    , CR_FILEDATE
			    , CR_SERNO
			    , CR_WAIT
			    , CR_SVRNAME
			    , 29895
			    , CONV_SERVERCD (LPAD(CR_SYSCD, 5, '0'), CR_IPADDR)
			    , CONV_SVRSEQ   (LPAD(CR_SYSCD, 5, '0'), CONV_SERVERCD (LPAD(CR_SYSCD, 5, '0'), CR_IPADDR), CR_IPADDR)
			    , 'A'
		    FROM  COVM_IMS.CMR1011 A
	       WHERE  EXISTS (SELECT  'X'
		                    FROM  COVM_IMS.CMR1000
	                       WHERE  CR_SYSCD = DECODE(:szINSysCD, 'ALL', CR_SYSCD, :szINSysCD)
	                       	 AND  TO_CHAR(CR_ACPTDATE, 'YYYYMM') = :szINYYYY
	                         AND  CR_ACPTNO = A.CR_ACPTNO
	                     )
	         AND  NOT EXISTS (SELECT  'X'
	                            FROM  CMR1011
	                           WHERE  CR_ACPTNO = A.CR_ACPTNO
	                             AND  CR_SEQNO  = A.CR_SEQNO
	                         );


		Get_Sys_Date(szEndDate);
		Get_Sys_Time(szEndTime);

		fprintf(stderr, "%s %s %s %s > SQLCODE : [%d]\n", szEndDate, szEndTime, szINSysCD, szINYYYY, sqlca.sqlcode);

		EXEC SQL AT TOBE COMMIT;

	}
	EXEC SQL AT ASIS CLOSE ASIS_CMR1011_YEAR;

	Get_Sys_Date(szEndDate);
	Get_Sys_Time(szEndTime);

	fprintf(stdout, "TABLE : %-20s TOTAL : %06d   SUCCESS : %06d   ERROR : %06d [%s %s ~ %s %s] %d\n"
				  , pTABLENM, szTotalCnt, szSuccessCnt, szErrorCnt, szStartDate, szStartTime, szEndDate, szEndTime
				  , Get_RunSecond(szStartDate, szStartTime, szEndDate, szEndTime));

	return (0);

}


