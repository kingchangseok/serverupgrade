/*	            디렉토리조직매칭                                 */
/*	Parameter : pTABLENM : 테이블명                              */
/*	Return    : 0 : 정상, 1 : 오류                               */
/*---------------------------------------------------------------*/
int 	CMM0071_CONVERT     ( char *pTABLENM
							)
{

char	szSYSCD                    [3+1];
char	szDSNCD                    [5+1];
char	szDEPTCD                  [10+1];


	Get_Sys_Date(szStartDate);
	Get_Sys_Time(szStartTime);

	szTotalCnt   = 0;
	szSuccessCnt = 0;
	szErrorCnt   = 0;

	/*-----------------------------------------------------------*/
    /*	 AS-IS TABLE  READ                                       */
    /*-----------------------------------------------------------*/
	EXEC SQL AT ASIS
		DECLARE ASIS_CMM0071 CURSOR FOR
			SELECT  CM_SYSCD
			      , CM_DSNCD
			      , CM_DEPTCD
   			  FROM  COVM_IMS.CMM0071 A
   			 WHERE  EXISTS (SELECT 'X'
   			                  FROM  COVM_IMS.CMM0070
   			                 WHERE  CM_SYSCD = A.CM_SYSCD
   			                   AND  CM_DSNCD = A.CM_DSNCD
   			                   AND  CM_DIRPATH IS NOT NULL
   			               );

	EXEC SQL AT ASIS OPEN ASIS_CMM0071;

	if (sqlca.sqlcode != 0) {
		fprintf(stderr, "ASIS_%s SQL ERROR [%d] [%s]\n", pTABLENM, sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
		exit (1);
	}

    while (1) {
		EXEC SQL AT ASIS FETCH ASIS_CMM0071
			INTO  :szSYSCD
				, :szDSNCD
				, :szDEPTCD;

		if (sqlca.sqlcode == 1403) break;

		szTotalCnt++;

		if (sqlca.sqlcode != 0 && sqlca.sqlcode != -1405) {
			fprintf(stderr, "%d %s\n", sqlca.sqlcode, sqlca.sqlerrm.sqlerrmc);
			szErrorCnt++;
			break;
		}

		sprintf(szSYSCD   , "%s", trunc_char(szSYSCD   ));
		sprintf(szDSNCD   , "%s", trunc_char(szDSNCD   ));
		sprintf(szDEPTCD  , "%s", trunc_char(szDEPTCD  ));

		/*-------------------------------------------------------*/
	    /*	TO-BE TABLE INSERT                                   */
	    /*-------------------------------------------------------*/
		EXEC SQL AT TOBE
			INSERT INTO CMM0071
				( CM_SYSCD
			    , CM_DSNCD
			    , CM_DEPTCD
				)
			VALUES
				( LPAD(:szSYSCD, 5, '0')
				, LPAD(:szDSNCD, 7, '0')
				, :szDEPTCD
				);

		if (sqlca.sqlcode == 0)
			szSuccessCnt++;
		else {
			fprintf(stderr, "ERROR : %s %s %s %d\n", szSYSCD, szDSNCD, szDEPTCD, sqlca.sqlcode);
			szErrorCnt++;
		}
 	}
 	EXEC SQL AT ASIS close ASIS_CMM0071;

	Get_Sys_Date(szEndDate);
	Get_Sys_Time(szEndTime);

	fprintf(stdout, "TABLE : %-20s TOTAL : %06d   SUCCESS : %06d   ERROR : %06d [%s %s ~ %s %s] %d\n"
				  , pTABLENM, szTotalCnt, szSuccessCnt, szErrorCnt, szStartDate, szStartTime, szEndDate, szEndTime
				  , Get_RunSecond(szStartDate, szStartTime, szEndDate, szEndTime));

	return (0);


