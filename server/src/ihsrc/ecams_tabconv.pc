				, :szRSRCCD
				, :szSAMERSRC
				, :szSAMENAME
				, :szBASENAME
				, :szBASEDIR
				, :szSAMEDIR
				, SYSDATE
				, SYSDATE
				, 'MASTER'
				, '04'
				, 'N'
				);

		if (sqlca.sqlcode == 0)
			szSuccessCnt++;
