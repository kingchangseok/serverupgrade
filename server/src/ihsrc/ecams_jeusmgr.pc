/*char    szTempTime                   [2+1];*/
int     dSeq                            ;
int     srmCnt                          ;
char   szReqdate        [8+1];
int   szReqNew       ;
int   szReqMod       ;
int   szReqNom       ;
int   szReqDel         ;
int   nLockDay      ;
int   nSaveTerm     ;
int   nFlag = 0;
int   nCount = 0;



EXEC SQL END DECLARE SECTION;
/*
	printf("MGR  Restart_Process() START ==================== \n");
*/
		memset(chktime, 0x00, sizeof(chktime));
		memset(chkdate, 0x00, sizeof(chkdate));
		
		Get_Sys_Date(chkdate);
		Get_Sys_Time(chktime);
		
    if ( memcmp(chkdate, gszLogFile, 8) != 0 ) {
        Get_Sys_Date(gszLogFile);
        strcat(gszLogFile,".log");
        strcpy(gszLogPath,"LogMessage/");
    }
    
		printf ( "JEUS TEST CHKTIME[%s]\n", chktime);

/*		
		if (( memcmp(chktime, "0655", 4) == 0  ||
		      memcmp(chktime, "0855", 4) == 0  ||
		      memcmp(chktime, "1255", 4) == 0  ||
		      memcmp(chktime, "1755", 4) == 0  ||
		      memcmp(chktime, "1855", 4) == 0 )  && 
		      nSendFlag == FALSE ){

	     memset ( syscmd, 0x00, sizeof(syscmd));
	     sprintf ( syscmd, "sendmsg.sh");
	     	 
	     ret = system(syscmd)/256;

       *LOG*sprintf(gszLogMsg,"[JEUS MGR] sendmsg.sh Program Start[Deploy 5Min Before] [%s][%d]\n", syscmd,ret );
       eCAMS_Log(gszLogPath,gszLogFile,gszLogMsg); 
       
       nSendFlag = TRUE; 
	     		   
		}
*/		     

		EXEC SQL
		  SELECT CM_CODENAME 
		    INTO :szDeplyTime
		    FROM CMM0020
		   WHERE CM_MACODE ='SYSTIME'
		     AND CM_CODENAME = SUBSTR(:chktime, 0,4);
		
		
		
		if ( sqlca.sqlcode == 0 ) {
		   NotUseDataTruncate (szDeplyTime     , 0x20);
/* 2017.01.18 */
			 EXEC SQL
			    SELECT COUNT(*) 
			      INTO :nCount
			      FROM CMR1000
			     WHERE CR_STATUS not in ('3', '8', '9');
/*			       AND CR_PRCTIME = :szDeplyTime;*/
			       
       /*LOG*/sprintf(gszLogMsg,"[JEUS MGR] [%s][%s][%d]Restart Pgm before 0 ",szTempTime,szDeplyTime,nCount);
       eCAMS_Log(gszLogPath,gszLogFile,gszLogMsg);


		   if ( nCount > 0 ) {  
   	      /*LOG*/sprintf(gszLogMsg,"[JEUS MGR] [%s][%s][%d]Restart Pgm before 1",szTempTime,szDeplyTime,nCount);
          eCAMS_Log(gszLogPath,gszLogFile,gszLogMsg);

		      if ( memcmp ( szTempTime, szDeplyTime, 4 ) != 0 ) {  
             if ( memcmp(chkdate, gszLogFile, 8) != 0 ) {
                 Get_Sys_Date(gszLogFile);
                 strcat(gszLogFile,".log");
                 strcpy(gszLogPath,"LogMessage/");
             }

	           memset ( syscmd, 0x00, sizeof(syscmd));
	           sprintf ( syscmd, "sendmsg.sh");
	           	 
	           ret = system(syscmd)/256;
             
             /*LOG*/sprintf(gszLogMsg,"[JEUS MGR] sendmsg.sh Program Start[Deploy 5Min Before] [%s][%d]\n", syscmd,ret );
             eCAMS_Log(gszLogPath,gszLogFile,gszLogMsg); 

				     memset ( syscmd, 0x00, sizeof(syscmd));
		  	     
		  	     printf ( " ecams_jeusstart start\n");
		  	     sprintf ( syscmd, "ecams_jeusstart %s %s" , chkdate, szDeplyTime);
		  	
		  	     ret = system(syscmd)/256;

		  	     /*LOG*/sprintf(gszLogMsg,"[JEUS MGR] [%s][%s][%d]Restart Pgm ecams_jeusstart  end",szTempTime,szDeplyTime,nCount);
             eCAMS_Log(gszLogPath,gszLogFile,gszLogMsg);

	           strcpy (szTempTime, szDeplyTime);
		      }	
       } 
       nSendFlag = FALSE;

   }
   
}

/*---------------------------------------------------------------*/
/*     Parent  Signal  Define                                    */
/*---------------------------------------------------------------*/
void DefineParentSignal ()
{
    int sig_num;

    for (sig_num = 1; sig_num < 32; sig_num++)
         signal (sig_num,  SIG_IGN);

#ifdef _OSF_SOURCE
    signal (SIGCLD, sig_cld);
#else
    signal (SIGCHLD, SIG_IGN);
#endif

    signal (SIGBUS,  ExitParentProc);
    signal (SIGSEGV, ExitParentProc);
    signal (SIGSYS,  ExitParentProc);
    signal (SIGKILL, ExitParentProc);
    signal (SIGINT,  ExitParentProc);
    signal (SIGTERM, ExitParentProc);

    return;
}

#ifdef _OSF_SOURCE
static void sig_cld ()
{
    int pid, status;

    while ((pid = wait3 (&status, WNOHANG, (struct rusage *)0)) > 0)
        ;
}
#endif


void ExitParentProc (sig_num)
int sig_num;
{
    exit (0);
}


/*****************************************************************/
/*                                                               */
/*       eCAMS_MGR  처리 MAIN  LOGIC                             */
/*                                                               */
/*****************************************************************/
int		main(int argc, char **argv, char **envp)
{
char  	SysCmd                     [100]; /* 시스템 명령문       */
char    stime                       [16]; /* 처리시작, 종료 시간 */
char    etime                       [16]; /* 처리시작, 종료 시간 */
char    Bef2Mon                     [10]; /* 3개월전 일자        */
int		ncnt = 0                        ;

    memset(szSysGbn  , 0x00, sizeof(szSysGbn  ));
	  memset ( szTempTime, 0x00, sizeof( szTempTime));
  	
  
	/*-----------------------------------------------------------*/
	/*	Jeus Restart Process                                     */
	/*-----------------------------------------------------------*/
	
	

	Get_Sys_Date(gszLogFile);
	strcat(gszLogFile,".log");
	strcpy(gszLogPath,"LogMessage/");

	Get_Sys_Date (sysdate);

	ncnt = system("procck ecams_jeusmgr") / 256;
	if (ncnt > 1)
		exit (1);
		
    /*LOG*/sprintf(gszLogMsg,"[JEUS MGR] [%s][%s]Restart ecams_jeusstart start",gszLogPath,gszLogFile);
    eCAMS_Log(gszLogPath,gszLogFile,gszLogMsg);

    gEnvp = envp;
    if (ConnectDB() == FALSE) {
   	  fprintf (stderr, "SQL ERROR  Connect \n");
      exit(0);
    }

	  DefineParentSignal ();

    memset(gAgentDtTime, 0x00, sizeof(gAgentDtTime));
    while (1) {


	    Restart_Process ();
	    sleep(5);
	    
    }
    EXEC SQL COMMIT WORK RELEASE;
    exit(0);
}




